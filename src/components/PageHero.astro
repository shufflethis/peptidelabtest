---
/** Page hero: breadcrumbs, H1, answer-first intro, last-checked line. */
import Breadcrumbs from './Breadcrumbs.astro';
import Icon from './Icon.astro';
import { CHECKED_LABEL } from '../lib/site';
interface Props {
  crumbs?: { name: string; url: string }[];
  title: string;
  eyebrow?: string;
  intro?: string;
}
const { crumbs, title, eyebrow, intro } = Astro.props;
---
<section class="hero-bg border-b border-slate-200/70">
  <div class="wrap pt-8 pb-10 sm:pt-10 sm:pb-12">
    {crumbs && crumbs.length > 1 && <Breadcrumbs items={crumbs} />}
    {eyebrow && <div class="mt-5"><span class="eyebrow">{eyebrow}</span></div>}
    <h1 class="mt-4 text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-slate-900 leading-[1.1] max-w-4xl">{title}</h1>
    {intro && <p class="mt-4 text-base sm:text-lg text-slate-600 leading-relaxed max-w-3xl" data-answer>{intro}</p>}
    <slot />
    <p class="mt-5 inline-flex items-center gap-1.5 text-xs text-slate-500"><Icon name="calendar" class="w-3.5 h-3.5" />Last checked {CHECKED_LABEL}</p>
  </div>
</section>
