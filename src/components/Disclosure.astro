---
/** Affiliate + RUO disclosure (inline box). */
import Icon from './Icon.astro';
import { t, splitLang } from '../i18n';
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
const lang = splitLang(Astro.url.pathname).lang;
---
<aside class={`rounded-2xl border border-slate-200 bg-slate-50 ${compact ? 'p-4 text-sm' : 'p-5 text-[0.94rem]'} text-slate-700 leading-relaxed flex gap-3`}>
  <Icon name="info" class="w-5 h-5 mt-0.5 text-slate-500" />
  <p class="max-w-[75ch]"><strong class="text-slate-900">{t(lang, 'c.disclosureLabel')}</strong> {t(lang, 'c.disclosure')}</p>
</aside>
