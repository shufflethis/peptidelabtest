---
/** "Compare: audited shops with a store link" box for non-partner pages (2-3 best partners, same region). */
import Icon from './Icon.astro';
import ScoreRing from './ScoreRing.astro';
import CodeBadge from './CodeBadge.astro';
import type { VendorProfile } from '../data/vendors';
import { shopHref, REL_SPONSORED, fillRange, shopShort } from '../lib/site';
interface Props {
  shops: VendorProfile[];
  title?: string;
  note?: string;
}
const { shops, title = 'Compare: audited shops with a store link', note } = Astro.props;
---
{shops.length > 0 && (
  <section class="rounded-2xl border border-teal-200 bg-teal-50/60 p-5 sm:p-6">
    <h2 class="h3 flex items-center gap-2"><Icon name="git-compare" class="w-5 h-5 text-teal-800" />{title}</h2>
    {note && <p class="mt-1.5 text-slate-700 max-w-[70ch]">{note}</p>}
    <ul class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {shops.map((s) => {
        const href = shopHref(s.slug);
        return (
          <li class="card p-4 flex flex-col gap-3">
            <div class="flex items-center gap-3">
              <ScoreRing score={s.overallScore} size={56} />
              <div>
                <a href={`/vendors/${s.slug}/`} class="font-bold text-lg text-slate-900 hover:text-teal-800 hover:underline">{s.name}</a>
                <div class="text-sm text-slate-600">{s.region} · {s.coaStats.portalVerified} of {s.coaStats.opened} reports portal-verified</div>
                <div class="text-sm text-slate-600">Measured vs label: {fillRange(s)}</div>
              </div>
            </div>
            <CodeBadge slug={s.slug} />
            <div class="flex flex-wrap items-center gap-x-4 gap-y-2 mt-auto">
              {href && <a href={href} rel={REL_SPONSORED} target="_blank" class="btn-primary">Visit {shopShort(s.name)} <Icon name="external-link" class="w-4 h-4" /></a>}
              <a href={`/vendors/${s.slug}/#lab-reports`} class="text-link">See lab reports</a>
            </div>
          </li>
        );
      })}
    </ul>
    <p class="mt-3 text-sm text-slate-600">Partner links (affiliate). Order = audit score.</p>
  </section>
)}
