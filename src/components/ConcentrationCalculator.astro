---
// Lab stock concentration calculator (research use only).
// Deliberately NO dose, aliquot, syringe or IU outputs – see CONTENT_RULES.md rule 2.
import { t, splitLang, LOCALE } from '../i18n';
const lang = splitLang(Astro.url.pathname).lang;
const C = (k: string) => t(lang, `calc.${k}`);
const inputCls = 'w-full min-h-[48px] px-3.5 py-2 rounded-xl bg-white border border-slate-300 text-slate-900 text-base tabular-nums focus:border-teal-600 focus:outline-none focus:ring-2 focus:ring-teal-100';
const pOff = 'min-h-[44px] px-3.5 rounded-xl border text-[0.94rem] font-semibold cursor-pointer bg-white border-slate-300 text-slate-800 hover:border-teal-600';
const pOn = 'min-h-[44px] px-3.5 rounded-xl border text-[0.94rem] font-semibold cursor-pointer bg-teal-50 border-teal-600 text-teal-900';
---
<section class="card p-5 sm:p-8" data-p-on={pOn} data-p-off={pOff} data-locale={LOCALE[lang]} data-t-report={C('basisReport')} data-t-label={C('basisLabel')} data-t-oflabel={C('ofLabel')} data-t-notentered={C('notEntered')} id="calc">
  <div class="flex flex-wrap items-center justify-between gap-4 pb-6 border-b border-slate-200">
    <div class="max-w-[60ch]">
      <h2 class="h2">{C('h')}</h2>
      <p class="mt-1.5 text-slate-700">{C('intro')}</p>
    </div>
    <div class="inline-flex rounded-xl bg-slate-100 p-1 border border-slate-200" role="group" aria-label={C('mode')}>
      <button type="button" id="mode-single-btn" aria-pressed="true" class="min-h-[44px] px-4 rounded-lg font-semibold bg-white text-slate-900 shadow-sm">{C('one')}</button>
      <button type="button" id="mode-blend-btn" aria-pressed="false" class="min-h-[44px] px-4 rounded-lg font-semibold text-slate-700">{C('two')}</button>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 pt-6">
    <div class="lg:col-span-7 space-y-6">
      <div class="space-y-2">
        <label class="block font-semibold text-slate-900" for="calc-vial-mg">{C('l1')}</label>
        <div class="flex flex-wrap gap-2">
          {[2, 5, 10, 15, 30, 50].map((val) => <button type="button" data-preset-mg={val} class={val === 10 ? pOn : pOff}>{val} mg</button>)}
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-1">
          <div>
            <span class="text-sm text-slate-700 block mb-1">{C('labelMass')}</span>
            <input id="calc-vial-mg" type="number" step="0.01" min="0.1" value="10" class={inputCls} />
          </div>
          <div>
            <label class="text-sm text-slate-700 block mb-1" for="calc-coa-mg">{C('coa')}</label>
            <input id="calc-coa-mg" type="number" step="0.01" min="0" placeholder={C('eg')} class={inputCls} />
          </div>
        </div>
      </div>

      <div id="blend-second-row" class="hidden p-4 rounded-xl bg-slate-50 border border-slate-200 space-y-2">
        <label class="block font-semibold text-slate-900" for="calc-blend-mg">{C('l1b')}</label>
        <input id="calc-blend-mg" type="number" step="0.01" min="0.1" value="5" class={`${inputCls} sm:w-48`} />
      </div>

      <div class="space-y-2">
        <label class="block font-semibold text-slate-900" for="calc-water-ml">{C('l2')}</label>
        <div class="flex flex-wrap gap-2">
          {[1, 1.5, 2, 2.5, 3].map((val) => <button type="button" data-preset-ml={val} class={val === 2 ? pOn : pOff}>{val} mL</button>)}
        </div>
        <input id="calc-water-ml" type="number" step="0.1" min="0.1" value="2" class={`${inputCls} sm:w-48`} />
      </div>
    </div>

    <div class="lg:col-span-5 rounded-2xl bg-teal-50/60 border border-teal-200 p-6 space-y-5" aria-live="polite">
      <div>
        <span class="text-sm font-semibold text-slate-700">{C('result')}</span>
        <div class="flex items-baseline gap-2.5 mt-1">
          <span id="out-conc-mg" class="text-5xl font-extrabold text-teal-900 tabular-nums">5.00</span>
          <span class="text-lg font-bold text-slate-800">mg/mL</span>
        </div>
        <p id="out-conc-mcg" class="text-slate-700 mt-1 tabular-nums">= 5,000 µg/mL</p>
      </div>
      <dl class="facts text-[0.95rem]">
        <div><dt>{C('massUsed')}</dt><dd id="out-basis" class="tabular-nums">10 mg</dd></div>
        <div><dt>{t(lang, 'c.measuredVsLabel')}</dt><dd id="out-dev" class="tabular-nums">{C('notEntered')}</dd></div>
        <div id="out-blend-row" class="hidden"><dt>{C('second')}</dt><dd id="out-blend-conc" class="tabular-nums">2.50 mg/mL</dd></div>
      </dl>
      <p class="text-sm text-slate-700">{C('note')}</p>
    </div>
  </div>
</section>

<script>
  function initCalculator() {
    let isBlend = false;
    const root = document.getElementById('calc');
    const P_ON = root?.dataset.pOn || '';
    const P_OFF = root?.dataset.pOff || '';
    const LOC = root?.dataset.locale || 'en-US';
    const T = root?.dataset || ({} as DOMStringMap);
    const f = (n: number, d: number) => n.toLocaleString(LOC, { minimumFractionDigits: d, maximumFractionDigits: d });
    const vialInput = document.getElementById('calc-vial-mg') as HTMLInputElement | null;
    const coaInput = document.getElementById('calc-coa-mg') as HTMLInputElement | null;
    const blendInput = document.getElementById('calc-blend-mg') as HTMLInputElement | null;
    const waterInput = document.getElementById('calc-water-ml') as HTMLInputElement | null;
    const single = document.getElementById('mode-single-btn');
    const blend = document.getElementById('mode-blend-btn');
    const ON = 'min-h-[44px] px-4 rounded-lg font-semibold bg-white text-slate-900 shadow-sm';
    const OFF = 'min-h-[44px] px-4 rounded-lg font-semibold text-slate-700';

    function recalc() {
      if (!vialInput || !waterInput) return;
      const labelMg = Math.max(0.01, parseFloat(vialInput.value) || 0);
      const coaRaw = coaInput && coaInput.value.trim() !== '' ? parseFloat(coaInput.value) : NaN;
      const hasCoa = !isNaN(coaRaw) && coaRaw > 0;
      const mass = hasCoa ? coaRaw : labelMg;
      const ml = Math.max(0.05, parseFloat(waterInput.value) || 1);
      const conc = mass / ml;
      const set = (id: string, v: string) => { const el = document.getElementById(id); if (el) el.textContent = v; };
      set('out-conc-mg', f(conc, 2));
      set('out-conc-mcg', `= ${f(Math.round(conc * 1000), 0)} µg/mL`);
      set('out-basis', hasCoa ? `${f(coaRaw, 2)} mg (${T.tReport})` : `${f(labelMg, 2)} mg (${T.tLabel})`);
      set('out-dev', hasCoa ? `${f((100 * coaRaw) / labelMg, 1)} % ${T.tOflabel}` : String(T.tNotentered));
      if (isBlend && blendInput) set('out-blend-conc', `${f(Math.max(0.01, parseFloat(blendInput.value) || 0) / ml, 2)} mg/mL`);
    }
    const mode = (b: boolean) => {
      isBlend = b;
      if (single) { single.className = b ? OFF : ON; single.setAttribute('aria-pressed', String(!b)); }
      if (blend) { blend.className = b ? ON : OFF; blend.setAttribute('aria-pressed', String(b)); }
      document.getElementById('blend-second-row')?.classList.toggle('hidden', !b);
      document.getElementById('out-blend-row')?.classList.toggle('hidden', !b);
      recalc();
    };
    single?.addEventListener('click', () => mode(false));
    blend?.addEventListener('click', () => mode(true));
    const presets = (attr: string, input: HTMLInputElement | null) => {
      document.querySelectorAll(`[${attr}]`).forEach((btn) => {
        btn.addEventListener('click', () => {
          const val = btn.getAttribute(attr);
          if (input && val) input.value = val;
          document.querySelectorAll(`[${attr}]`).forEach((b) => { b.className = P_OFF; });
          btn.className = P_ON;
          recalc();
        });
      });
    };
    presets('data-preset-mg', vialInput);
    presets('data-preset-ml', waterInput);
    [vialInput, coaInput, blendInput, waterInput].forEach((el) => el?.addEventListener('input', recalc));
    recalc();
  }
  initCalculator();
</script>
