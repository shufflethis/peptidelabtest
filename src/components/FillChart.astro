---
/**
 * "Measured vs label mg" dot chart. x = measured / label * 100 %. 100% reference line, ±10% band.
 * Values come straight from opened lab reports (coaExamples). Rows without both numbers are skipped.
 */
interface Row {
  label: string;
  sub?: string;
  labelMg: number | null;
  measuredMg: number | null;
  verified?: boolean;
}
interface Props {
  rows: Row[];
  title?: string;
  caption?: string;
}
const { rows, title, caption } = Astro.props;
const pts = rows
  .filter((r) => r.labelMg && r.measuredMg != null)
  .map((r) => ({ ...r, pct: (100 * (r.measuredMg as number)) / (r.labelMg as number) }));
const minX = Math.min(85, ...pts.map((p) => p.pct)) ;
const maxX = Math.max(115, ...pts.map((p) => p.pct));
const lo = Math.floor((minX - 2) / 10) * 10;
const hi = Math.ceil((maxX + 2) / 10) * 10;
const W = 640;
const L = 190;
const R = 24;
const rowH = 26;
const top = 26;
const H = top + pts.length * rowH + 30;
const x = (v: number) => L + ((v - lo) / (hi - lo)) * (W - L - R);
const ticks: number[] = [];
for (let t = lo; t <= hi; t += hi - lo > 60 ? 20 : 10) ticks.push(t);
const trunc = (s: string, n = 30) => (s.length > n ? s.slice(0, n - 1) + '…' : s);
---
{pts.length > 0 && (
  <figure class="card p-4 sm:p-5">
    {title && <figcaption class="text-sm font-bold text-slate-900 mb-1">{title}</figcaption>}
    <div class="overflow-x-auto">
      <svg viewBox={`0 0 ${W} ${H}`} class="w-full min-w-[520px] h-auto" role="img" aria-label={`Measured content as percent of label for ${pts.length} lab reports`}>
        <rect x={x(90)} y={top - 8} width={x(110) - x(90)} height={pts.length * rowH + 8} fill="#ccfbf1" opacity="0.55" rx="4" />
        {ticks.map((t) => (
          <g>
            <line x1={x(t)} x2={x(t)} y1={top - 8} y2={top + pts.length * rowH} stroke="#e2e8f0" stroke-width="1" />
            <text x={x(t)} y={H - 10} text-anchor="middle" font-size="11" fill="#64748b">{t}%</text>
          </g>
        ))}
        <line x1={x(100)} x2={x(100)} y1={top - 12} y2={top + pts.length * rowH} stroke="#0f172a" stroke-width="1.5" stroke-dasharray="4 3" />
        <text x={x(100)} y={top - 14} text-anchor="middle" font-size="10" fill="#0f172a" font-weight="600">100% = label</text>
        {pts.map((p, i) => {
          const y = top + i * rowH + rowH / 2;
          const out = p.pct < 90 || p.pct > 110;
          return (
            <g>
              <text x={L - 10} y={y + 4} text-anchor="end" font-size="11.5" fill="#0f172a">{trunc(p.label)}</text>
              <line x1={x(100)} x2={x(p.pct)} y1={y} y2={y} stroke={out ? '#f59e0b' : '#5eead4'} stroke-width="2" />
              <circle cx={x(p.pct)} cy={y} r="5.5" fill={p.verified === false ? '#ffffff' : out ? '#d97706' : '#0f766e'} stroke={out ? '#d97706' : '#0f766e'} stroke-width="2">
                <title>{`${p.label}${p.sub ? ' – ' + p.sub : ''}: ${p.measuredMg} mg measured / ${p.labelMg} mg label = ${p.pct.toFixed(1)}%`}</title>
              </circle>
              <text x={Math.min(x(p.pct) + 10, W - 4)} y={y + 4} font-size="10.5" fill="#475569" text-anchor={x(p.pct) + 60 > W ? 'end' : 'start'}>{p.pct.toFixed(1)}%</text>
            </g>
          );
        })}
      </svg>
    </div>
    <p class="mt-2 text-xs text-slate-500 leading-relaxed">
      {caption || 'Each dot is one opened lab report: measured mg divided by label mg. Shaded band = 90–110% of label.'} Filled dot = verified on the lab portal, hollow dot = report hosted by the shop.
    </p>
  </figure>
)}
