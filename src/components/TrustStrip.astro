---
/** Trust strip with counts computed from audit data. */
import Icon from './Icon.astro';
import { TOTALS, CHECKED_LABEL } from '../lib/site';
interface Props {
  class?: string;
}
const { class: cls = '' } = Astro.props;
const items = [
  { icon: 'building', value: String(TOTALS.shops), label: 'shops audited' },
  { icon: 'file-text', value: String(TOTALS.reportsOpened), label: 'lab reports opened' },
  { icon: 'shield-check', value: String(TOTALS.portalVerified), label: 'verified on a lab portal' },
  { icon: 'tag', value: String(TOTALS.products), label: 'prices recorded' },
  { icon: 'calendar', value: CHECKED_LABEL, label: 'last checked' },
];
---
<div class={`grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3 ${cls}`}>
  {items.map((it) => (
    <div class="card px-4 py-3 flex items-center gap-3">
      <span class="w-9 h-9 rounded-xl bg-teal-50 text-teal-700 flex items-center justify-center"><Icon name={it.icon} class="w-5 h-5" /></span>
      <div class="leading-tight">
        <div class="text-lg font-extrabold text-slate-900 tabular-nums">{it.value}</div>
        <div class="text-xs text-slate-500">{it.label}</div>
      </div>
    </div>
  ))}
</div>
