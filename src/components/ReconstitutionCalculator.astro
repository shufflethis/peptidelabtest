---
// Lab concentration calculator (research use only).
// Deliberately NO dose, aliquot, syringe or IU outputs – see CONTENT_RULES.md rule 2.
---

<section class="glass-card rounded-2xl p-6 sm:p-8 border border-cyan-500/30 shadow-2xl shadow-cyan-950/20">
  <div class="flex flex-wrap items-center justify-between gap-4 pb-6 border-b border-slate-800/80">
    <div>
      <span class="font-mono text-[11px] uppercase tracking-widest text-cyan-400 font-bold">
        🧮 Lab Stock Concentration Tool
      </span>
      <h2 class="text-2xl font-extrabold text-white mt-0.5">
        Vial Stock Concentration Calculator
      </h2>
      <p class="text-xs text-slate-400 mt-1">
        Converts labeled or COA-measured vial mass and diluent volume into stock concentration (mg/mL). For in-vitro laboratory research only. Not for human or animal use; this tool gives no dosing or usage information.
      </p>
    </div>

    <div class="inline-flex rounded-xl bg-slate-950 p-1 border border-slate-800 font-mono text-xs">
      <button type="button" id="mode-single-btn" class="px-3.5 py-1.5 rounded-lg bg-cyan-500 text-slate-950 font-bold transition-all cursor-pointer">
        Single Compound
      </button>
      <button type="button" id="mode-blend-btn" class="px-3.5 py-1.5 rounded-lg text-slate-400 hover:text-white transition-all cursor-pointer">
        Two-Compound Vial
      </button>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 pt-6">
    <div class="lg:col-span-7 space-y-5">
      <div class="space-y-2">
        <label class="block text-xs font-mono uppercase tracking-wider text-slate-300 font-semibold" for="calc-vial-mg">
          1. Compound A – Vial Label Mass (mg)
        </label>
        <div class="flex flex-wrap gap-2">
          {[2, 5, 10, 15, 30, 50].map((val) => (
            <button
              type="button"
              data-preset-mg={val}
              class={`px-3 py-1.5 rounded-lg font-mono text-xs border transition-colors cursor-pointer ${
                val === 10
                  ? 'bg-cyan-500/20 border-cyan-400 text-cyan-200 font-bold'
                  : 'bg-slate-900 border-slate-800 text-slate-300 hover:border-slate-600'
              }`}
            >
              {val} mg
            </button>
          ))}
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-1">
          <div>
            <span class="text-[11px] text-slate-400 block mb-1">Labeled Vial Mass (mg)</span>
            <input id="calc-vial-mg" type="number" step="0.01" min="0.1" value="10"
              class="w-full px-3.5 py-2 rounded-lg bg-slate-950 border border-slate-700 text-white font-mono text-sm focus:border-cyan-400 focus:outline-none" />
          </div>
          <div>
            <span class="text-[11px] text-emerald-400 font-mono block mb-1">COA Measured mg (Optional Override)</span>
            <input id="calc-coa-mg" type="number" step="0.01" min="0" placeholder="e.g. 10.62 from COA"
              class="w-full px-3.5 py-2 rounded-lg bg-slate-950 border border-emerald-500/40 text-emerald-200 placeholder-slate-600 font-mono text-sm focus:border-emerald-400 focus:outline-none" />
          </div>
        </div>
      </div>

      <div id="blend-second-row" class="hidden p-4 rounded-xl bg-slate-950/90 border border-cyan-500/30 space-y-2">
        <label class="block text-xs font-mono uppercase tracking-wider text-cyan-300 font-semibold" for="calc-blend-mg">
          1B. Compound B in the Same Vial (mg)
        </label>
        <p class="text-[11px] text-slate-400">
          For co-lyophilized vials, enter the second compound's labeled mass to get its stock concentration as well.
        </p>
        <input id="calc-blend-mg" type="number" step="0.01" min="0.1" value="5"
          class="w-full sm:w-48 px-3.5 py-2 rounded-lg bg-slate-900 border border-slate-700 text-white font-mono text-sm focus:border-cyan-400 focus:outline-none" />
      </div>

      <div class="space-y-2">
        <label class="block text-xs font-mono uppercase tracking-wider text-slate-300 font-semibold" for="calc-water-ml">
          2. Diluent Volume Added (mL)
        </label>
        <div class="flex flex-wrap gap-2">
          {[1, 1.5, 2, 2.5, 3].map((val) => (
            <button
              type="button"
              data-preset-ml={val}
              class={`px-3 py-1.5 rounded-lg font-mono text-xs border transition-colors cursor-pointer ${
                val === 2
                  ? 'bg-cyan-500/20 border-cyan-400 text-cyan-200 font-bold'
                  : 'bg-slate-900 border-slate-800 text-slate-300 hover:border-slate-600'
              }`}
            >
              {val} mL
            </button>
          ))}
        </div>
        <input id="calc-water-ml" type="number" step="0.1" min="0.1" value="2"
          class="w-full sm:w-48 px-3.5 py-2 rounded-lg bg-slate-950 border border-slate-700 text-white font-mono text-sm focus:border-cyan-400 focus:outline-none" />
      </div>
    </div>

    <div class="lg:col-span-5 flex flex-col justify-between rounded-2xl bg-slate-950 border border-slate-800 p-6 space-y-5">
      <div>
        <span class="text-[11px] font-mono uppercase tracking-widest text-slate-400">Stock Concentration (Compound A)</span>
        <div class="flex items-baseline gap-2.5 mt-1">
          <span id="out-conc-mg" class="text-5xl font-black font-mono text-cyan-400 tabular-nums">5.00</span>
          <span class="text-lg font-mono font-bold text-slate-300">mg/mL</span>
        </div>
        <p id="out-conc-mcg" class="text-xs font-mono text-slate-400 mt-1">= 5,000 µg/mL</p>
      </div>

      <div class="space-y-2.5 pt-3 border-t border-slate-800 text-xs font-mono">
        <div class="flex justify-between">
          <span class="text-slate-400">Mass Basis:</span>
          <span id="out-basis" class="text-slate-200 font-semibold">10.00 mg (Label)</span>
        </div>
        <div class="flex justify-between">
          <span class="text-slate-400">Label vs. COA Deviation:</span>
          <span id="out-dev" class="text-slate-200 font-semibold">–</span>
        </div>
        <div id="out-blend-row" class="hidden pt-2 border-t border-cyan-500/20 flex justify-between text-cyan-300">
          <span>Compound B Concentration:</span>
          <span id="out-blend-conc" class="font-bold">2.50 mg/mL</span>
        </div>
      </div>
      <p class="text-[11px] text-slate-500 leading-relaxed">
        Research use only. Arithmetic concentration utility for laboratory stock solutions; provides no dosing, administration or usage guidance.
      </p>
    </div>
  </div>
</section>

<script>
  function initCalculator() {
    let isBlend = false;
    const vialInput = document.getElementById('calc-vial-mg') as HTMLInputElement | null;
    const coaInput = document.getElementById('calc-coa-mg') as HTMLInputElement | null;
    const blendInput = document.getElementById('calc-blend-mg') as HTMLInputElement | null;
    const waterInput = document.getElementById('calc-water-ml') as HTMLInputElement | null;
    const modeSingleBtn = document.getElementById('mode-single-btn');
    const modeBlendBtn = document.getElementById('mode-blend-btn');
    const blendRowInput = document.getElementById('blend-second-row');
    const blendRowOut = document.getElementById('out-blend-row');
    const ON = 'px-3.5 py-1.5 rounded-lg bg-cyan-500 text-slate-950 font-bold transition-all cursor-pointer';
    const OFF = 'px-3.5 py-1.5 rounded-lg text-slate-400 hover:text-white transition-all cursor-pointer';
    const P_ON = 'px-3 py-1.5 rounded-lg font-mono text-xs border transition-colors cursor-pointer bg-cyan-500/20 border-cyan-400 text-cyan-200 font-bold';
    const P_OFF = 'px-3 py-1.5 rounded-lg font-mono text-xs border transition-colors cursor-pointer bg-slate-900 border-slate-800 text-slate-300 hover:border-slate-600';

    function recalc() {
      if (!vialInput || !waterInput) return;
      const labelMg = Math.max(0.01, parseFloat(vialInput.value) || 0);
      const coaMgRaw = coaInput && coaInput.value.trim() !== '' ? parseFloat(coaInput.value) : NaN;
      const hasCoa = !isNaN(coaMgRaw) && coaMgRaw > 0;
      const effectiveMg = hasCoa ? coaMgRaw : labelMg;
      const waterMl = Math.max(0.05, parseFloat(waterInput.value) || 1);
      const concMg = effectiveMg / waterMl;

      const set = (id: string, v: string) => { const el = document.getElementById(id); if (el) el.textContent = v; };
      set('out-conc-mg', concMg.toFixed(2));
      set('out-conc-mcg', `= ${Math.round(concMg * 1000).toLocaleString('en-US')} µg/mL`);
      set('out-basis', hasCoa ? `${coaMgRaw.toFixed(2)} mg (COA)` : `${labelMg.toFixed(2)} mg (Label)`);
      if (hasCoa) {
        const d = ((coaMgRaw - labelMg) / labelMg) * 100;
        set('out-dev', `${d >= 0 ? '+' : ''}${d.toFixed(1)}%`);
      } else {
        set('out-dev', '–');
      }
      if (isBlend && blendInput) {
        const blendMg = Math.max(0.01, parseFloat(blendInput.value) || 0);
        set('out-blend-conc', `${(blendMg / waterMl).toFixed(2)} mg/mL`);
      }
    }

    modeSingleBtn?.addEventListener('click', () => {
      isBlend = false;
      modeSingleBtn.className = ON;
      if (modeBlendBtn) modeBlendBtn.className = OFF;
      blendRowInput?.classList.add('hidden');
      blendRowOut?.classList.add('hidden');
      recalc();
    });
    modeBlendBtn?.addEventListener('click', () => {
      isBlend = true;
      modeBlendBtn.className = ON;
      if (modeSingleBtn) modeSingleBtn.className = OFF;
      blendRowInput?.classList.remove('hidden');
      blendRowOut?.classList.remove('hidden');
      recalc();
    });

    const presets = (attr: string, input: HTMLInputElement | null) => {
      document.querySelectorAll(`[${attr}]`).forEach((btn) => {
        btn.addEventListener('click', () => {
          const val = btn.getAttribute(attr);
          if (input && val) input.value = val;
          document.querySelectorAll(`[${attr}]`).forEach((b) => { b.className = P_OFF; });
          btn.className = P_ON;
          recalc();
        });
      });
    };
    presets('data-preset-mg', vialInput);
    presets('data-preset-ml', waterInput);

    [vialInput, coaInput, blendInput, waterInput].forEach((el) => el?.addEventListener('input', recalc));
    recalc();
  }
  initCalculator();
</script>
