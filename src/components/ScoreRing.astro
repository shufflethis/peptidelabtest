---
/** Score ring 0-5, inline SVG, generated at build time from overallScore. */
interface Props {
  score: number;
  size?: number;
  class?: string;
  label?: string;
}
const { score, size = 72, class: cls = '', label = 'audit score' } = Astro.props;
const v = Math.max(0, Math.min(5, score));
const r = 30;
const c = 2 * Math.PI * r;
const dash = (v / 5) * c;
const color = v >= 3.5 ? '#0f766e' : v >= 2.5 ? '#0d9488' : v >= 1.5 ? '#d97706' : '#94a3b8';
---
<span class={`relative inline-flex items-center justify-center shrink-0 ${cls}`} style={`width:${size}px;height:${size}px`} role="img" aria-label={`${label} ${v.toFixed(1)} out of 5`}>
  <svg viewBox="0 0 72 72" width={size} height={size} aria-hidden="true">
    <circle cx="36" cy="36" r={r} fill="none" stroke="#e2e8f0" stroke-width="6" />
    <circle cx="36" cy="36" r={r} fill="none" stroke={color} stroke-width="6" stroke-linecap="round"
      stroke-dasharray={`${dash.toFixed(2)} ${c.toFixed(2)}`} transform="rotate(-90 36 36)" />
  </svg>
  <span class="absolute inset-0 flex flex-col items-center justify-center leading-none">
    <span class="font-extrabold text-slate-900" style={`font-size:${Math.round(size * 0.27)}px`}>{v.toFixed(1)}</span>
    <span class="text-slate-500 font-medium" style={`font-size:${Math.max(11, Math.round(size * 0.15))}px`}>/ 5</span>
  </span>
</span>
