---
/**
 * Home-page data video: lazy (sources attached when the block nears the viewport), muted, looping, inline,
 * poster first; no autoplay under prefers-reduced-motion (controls instead). Full HTML transcript below.
 */
import { VIDEO, videoTranscript } from '../lib/video';
import { t, splitLang } from '../i18n';
const lang = splitLang(Astro.url.pathname).lang;
const paras = videoTranscript(lang);
---
<figure class="space-y-4" data-video-block>
  <div class="rounded-2xl overflow-hidden bg-slate-900 shadow-sm aspect-video">
    <video class="w-full h-full block" muted loop playsinline preload="none" poster={VIDEO.poster} width={VIDEO.width} height={VIDEO.height} aria-label={t(lang, 'm5.videoName')} data-lazy-video>
      <source data-src={VIDEO.mp4} type="video/mp4" />
      <source data-src={VIDEO.webm} type="video/webm" />
    </video>
  </div>
  <figcaption class="text-sm text-slate-600">{t(lang, 'm5.videoCaption')}</figcaption>
  <div class="card px-5 py-4 sm:px-6 max-w-[75ch]" id="video-transcript">
    <h3 class="h3">{t(lang, 'm5.transcriptH')}</h3>
    <div class="prose-read mt-2">
      {paras.map((p) => <p>{p}</p>)}
    </div>
  </div>
</figure>
<script>
  const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLVideoElement>('video[data-lazy-video]').forEach((v) => {
    const start = () => {
      v.querySelectorAll<HTMLSourceElement>('source[data-src]').forEach((s) => { s.src = s.dataset.src!; s.removeAttribute('data-src'); });
      v.load();
      if (still) { v.controls = true; v.loop = false; } else { v.autoplay = true; v.play().catch(() => { v.controls = true; }); }
    };
    if (!('IntersectionObserver' in window)) { start(); return; }
    const io = new IntersectionObserver((es) => { if (es.some((e) => e.isIntersecting)) { io.disconnect(); start(); } }, { rootMargin: '200px 0px' });
    io.observe(v);
  });
</script>
