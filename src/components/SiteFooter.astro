---
/**
 * Site footer: brand block + 5 link columns (accordions on phones, open columns on desktop) + bottom bar.
 * Social icons render only for non-empty SOCIAL urls (src/lib/site.ts).
 */
import Icon from './Icon.astro';
import { t, lp, LANGS, LANG_LABEL, LANG_NAME, fmtDate, type Lang } from '../i18n';
import { SITE_NAME, CHECKED_ISO, YEAR, PRICE_COMPOUNDS, shopsCarrying, compoundShort, COMPOUND_PAIRS, pairSlug, socialLinks } from '../lib/site';

interface Props {
  lang: Lang;
  /** path without language prefix, for the language links */
  path: string;
  langsLive?: boolean;
}
const { lang, path, langsLive = false } = Astro.props;
const L = (p: string) => lp(lang, p);
const date = fmtDate(lang, CHECKED_ISO);
const topCompounds = [...PRICE_COMPOUNDS].sort((a, b) => shopsCarrying(b).length - shopsCarrying(a).length).slice(0, 8);
const social = socialLinks(lang);

const cols: { id: string; title: string; links: { href: string; label: string }[] }[] = [
  {
    id: 'prices',
    title: t(lang, 'footer.colPrices'),
    links: [
      ...topCompounds.map((c) => ({ href: L(`/prices/${c}/`), label: t(lang, 'footer.pricesOf', { name: compoundShort(c) }) })),
      { href: L('/prices/'), label: t(lang, 'footer.allPrices') },
      { href: L('/price-index/'), label: t(lang, 'footer.priceIndex') },
    ],
  },
  {
    id: 'shops',
    title: t(lang, 'footer.colShops'),
    links: [
      { href: L('/vendors/'), label: t(lang, 'footer.bestShops') },
      { href: L('/vendors/europe/'), label: t(lang, 'footer.bestEu') },
      { href: L('/vendors/usa/'), label: t(lang, 'footer.bestUs') },
      { href: L('/discount-codes/'), label: t(lang, 'footer.codes') },
      { href: L('/vendors/compare/'), label: t(lang, 'footer.shopVsShop') },
      { href: L('/batch-tracker/'), label: t(lang, 'footer.reportsOpened') },
    ],
  },
  {
    id: 'lab',
    title: t(lang, 'footer.colLab'),
    links: [
      { href: L('/labs/'), label: t(lang, 'footer.labs') },
      { href: L('/labs/janoshik/'), label: t(lang, 'footer.labGuide', { name: 'Janoshik' }) },
      { href: L('/labs/vanguard/'), label: t(lang, 'footer.labGuide', { name: 'Vanguard' }) },
      { href: L('/methodology/'), label: t(lang, 'footer.howWeTest') },
      { href: L('/data/'), label: t(lang, 'footer.openData') },
      { href: '/llms.txt', label: t(lang, 'footer.llms') },
    ],
  },
  {
    id: 'guides',
    title: t(lang, 'footer.colGuides'),
    links: [
      { href: L('/compounds/'), label: t(lang, 'footer.compounds') },
      ...COMPOUND_PAIRS.slice(0, 4).map(([a, b]) => ({ href: L(`/compare/${pairSlug(a, b)}/`), label: `${compoundShort(a)} vs ${compoundShort(b)}` })),
      { href: L('/compare/'), label: t(lang, 'footer.compareCompounds') },
      { href: L('/laws/'), label: t(lang, 'footer.byCountry') },
      { href: L('/research/'), label: t(lang, 'footer.research') },
      { href: L('/calculator/'), label: t(lang, 'footer.calculator') },
    ],
  },
  {
    id: 'about',
    title: t(lang, 'footer.colAbout'),
    links: [
      { href: L('/about/'), label: t(lang, 'footer.about') },
      { href: L('/contact/'), label: t(lang, 'footer.contact') },
      { href: L('/affiliate-disclosure/'), label: t(lang, 'footer.affiliate') },
      { href: L('/privacy/'), label: t(lang, 'footer.privacy') },
      { href: L('/terms/'), label: t(lang, 'footer.terms') },
      { href: L('/advertise/'), label: t(lang, 'footer.forShops') },
      { href: L('/legal/'), label: t(lang, 'footer.legal') },
    ],
  },
];
---
<footer class="mt-20 bg-slate-50 border-t border-slate-200 text-[0.94rem]">
  <div class="wrap pt-12 pb-6">
    <div class="grid gap-x-8 gap-y-2 lg:gap-y-10 lg:grid-cols-[1.35fr_repeat(5,1fr)]">
      <div class="pb-6 lg:pb-0">
        <a href={L('/')} class="inline-flex items-center gap-2.5" aria-label={SITE_NAME}>
          <span class="w-9 h-9 rounded-xl bg-gradient-to-br from-teal-600 to-emerald-700 flex items-center justify-center shadow-sm">
            <svg viewBox="0 0 24 24" class="w-5 h-5 text-white" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9.5 2.5h5M10 2.5v6L4.6 18.4A2 2 0 0 0 6.4 21.5h11.2a2 2 0 0 0 1.8-3.1L14 8.5v-6" /><path d="M7.2 14.5h9.6" /></svg>
          </span>
          <span class="font-extrabold text-slate-900 text-lg tracking-tight">Peptide<span class="text-teal-700">Lab</span>Index</span>
        </a>
        <p class="mt-3 text-slate-700 leading-relaxed max-w-[40ch]">{t(lang, 'footer.brandDesc')}</p>
        <p class="mt-3 inline-flex items-center gap-1.5 text-sm text-slate-600"><Icon name="calendar" class="w-4 h-4" />{t(lang, 'footer.updated', { date })}</p>
        {social.length > 0 && (
          <ul class="mt-4 flex items-center gap-2" aria-label={t(lang, 'footer.followUs')}>
            {social.map((s) => (
              <li>
                <a href={s.href} rel="me noopener" target="_blank" class="inline-flex items-center justify-center w-11 h-11 rounded-xl border border-slate-300 bg-white text-slate-700 hover:text-teal-800 hover:border-teal-600" aria-label={s.label}>
                  <svg viewBox="0 0 24 24" class="w-5 h-5" fill="currentColor" aria-hidden="true"><path d={s.icon} /></svg>
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>
      {cols.map((c) => (
        <details class="footer-col group border-t border-slate-200 lg:border-0" data-footer-col>
          <summary class="flex items-center justify-between min-h-[48px] font-bold text-slate-900 text-base cursor-pointer lg:cursor-default lg:min-h-0 lg:mb-3">
            <h2 class="text-base font-bold">{c.title}</h2>
            <Icon name="chevron-down" class="w-5 h-5 text-slate-600 transition-transform group-open:rotate-180 lg:hidden" />
          </summary>
          <ul class="pb-4 lg:pb-0 space-y-1 lg:space-y-2 text-slate-700">
            {c.links.map((l) => <li><a href={l.href} class="inline-flex items-center min-h-[40px] lg:min-h-0 hover:text-teal-800 hover:underline underline-offset-2">{l.label}</a></li>)}
          </ul>
        </details>
      ))}
    </div>
    <div class="mt-8 pt-5 border-t border-slate-200 flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between text-sm text-slate-600">
      <div class="max-w-[80ch] space-y-1">
        <p>{t(lang, 'footer.ruo')}</p>
        <p>{t(lang, 'footer.affLine')} <a href={L('/affiliate-disclosure/')} class="underline underline-offset-2 hover:text-teal-800">{t(lang, 'footer.affiliate')}</a></p>
      </div>
      <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
        <span>{t(lang, 'footer.copyright', { year: YEAR, site: SITE_NAME, date })}</span>
        {langsLive && (
          <nav aria-label={t(lang, 'footer.languages')} class="flex items-center gap-1">
            {LANGS.map((l) => (
              l === lang
                ? <span class="px-2 py-1 rounded-md font-bold text-slate-900 bg-white ring-1 ring-slate-300" aria-current="true">{LANG_LABEL[l]}</span>
                : <a href={lp(l, path)} hreflang={l} lang={l} class="px-2 py-1 rounded-md font-semibold text-teal-800 hover:bg-white" title={LANG_NAME[l]}>{LANG_LABEL[l]}</a>
            ))}
          </nav>
        )}
      </div>
    </div>
  </div>
</footer>
<script>
  // Footer columns: accordions on phones, always open on desktop.
  const mq = window.matchMedia('(min-width: 1024px)');
  const cols = Array.from(document.querySelectorAll<HTMLDetailsElement>('[data-footer-col]'));
  const sync = () => cols.forEach((d) => { d.open = mq.matches; });
  sync();
  mq.addEventListener('change', sync);
  cols.forEach((d) => d.querySelector('summary')?.addEventListener('click', (e) => { if (mq.matches) e.preventDefault(); }));
</script>
