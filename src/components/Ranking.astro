---
/** Shop ranking: partner shops by audit score (ranked), then other audited shops (score + text + internal link only). */
import Icon from './Icon.astro';
import ScoreRing from './ScoreRing.astro';
import CodeBadge from './CodeBadge.astro';
import VerifyBadge from './VerifyBadge.astro';
import type { VendorProfile } from '../data/vendors';
import { shopHref, REL_SPONSORED, vendorVerify, purityRange, fillRange, cheapestFor, perMg, compoundShort } from '../lib/site';
interface Props {
  partners: VendorProfile[];
  others: VendorProfile[];
  partnerTitle?: string;
  otherTitle?: string;
}
const { partners, others, partnerTitle = 'Ranking: audited shops with a store link', otherTitle = 'Other audited shops' } = Astro.props;
---
<section class="space-y-5" id="ranking">
  <div class="max-w-[70ch]">
    <h2 class="h2">{partnerTitle}</h2>
    <p class="mt-2 text-slate-700">Partner shops only, ordered by audit score. Commission has no effect on the order.</p>
  </div>
  <ol class="space-y-4">
    {partners.map((v, i) => {
      const href = shopHref(v.slug);
      const cheap = cheapestFor(v);
      return (
        <li class="card p-5 sm:p-6">
          <div class="grid gap-5 md:grid-cols-[auto_1fr_auto] md:items-center">
            <div class="flex items-center gap-4">
              <span class="w-10 h-10 rounded-full bg-teal-800 text-white font-bold flex items-center justify-center" aria-label={`Rank ${i + 1}`}>{i + 1}</span>
              <ScoreRing score={v.overallScore} size={68} />
            </div>
            <div class="min-w-0">
              <h3 class="text-xl font-extrabold text-slate-900"><a href={`/vendors/${v.slug}/`} class="hover:text-teal-800 hover:underline">{v.name}</a> <span class="text-base font-medium text-slate-600">{v.region} · {v.originCountry}</span></h3>
              <div class="mt-2"><VerifyBadge level={vendorVerify(v)} text={v.coaStats.opened ? `${v.coaStats.portalVerified} of ${v.coaStats.opened} reports portal-verified` : undefined} /></div>
              <ul class="mt-3 grid gap-x-6 gap-y-1 sm:grid-cols-2 text-[0.95rem] text-slate-700">
                <li><span class="text-slate-600">Purity:</span> {purityRange(v)}</li>
                <li><span class="text-slate-600">Measured vs label:</span> {fillRange(v)}</li>
                <li><span class="text-slate-600">Labs:</span> {v.testingLabs.map((l) => l.replace(/\s*\(.*\)\s*$/, '')).join(', ')}</li>
                <li><span class="text-slate-600">Price example:</span> {cheap ? `${compoundShort(cheap.compound)} ${cheap.vialMg} mg, ${perMg(cheap.pricePerMg, cheap.currency)}` : 'not published'}</li>
              </ul>
              <p class="mt-3 text-slate-700 max-w-[75ch]">{v.verdictSummary}</p>
            </div>
            <div class="flex flex-col gap-3 md:items-end md:min-w-[13rem]">
              <CodeBadge slug={v.slug} />
              {href && <a href={href} rel={REL_SPONSORED} target="_blank" class="btn-primary">Visit shop <Icon name="external-link" class="w-4 h-4" /></a>}
              <a href={`/vendors/${v.slug}/`} class="text-link">Read review</a>
            </div>
          </div>
        </li>
      );
    })}
  </ol>
  <p class="text-sm text-slate-600">"Visit shop" links are partner (affiliate) links.</p>
</section>

{others.length > 0 && (
  <section class="space-y-5" id="other-shops">
    <div class="max-w-[70ch]">
      <h2 class="h2">{otherTitle}</h2>
      <p class="mt-2 text-slate-700">Same audit, same score formula. These shops are not partners, so we link to our review only.</p>
    </div>
    <div class="table-wrap">
      <table class="data-table">
        <thead>
          <tr>
            <th scope="col">Shop</th>
            <th scope="col" class="num">Score (0-5)</th>
            <th scope="col" class="num">Reports portal-verified</th>
            <th scope="col">Measured vs label</th>
            <th scope="col">Verdict</th>
          </tr>
        </thead>
        <tbody>
          {others.map((v) => (
            <tr>
              <td class="min-w-[10rem]"><a href={`/vendors/${v.slug}/`} class="font-semibold text-slate-900 hover:text-teal-800 hover:underline">{v.name}</a><span class="sub">{v.region} · Read review</span></td>
              <td class="num font-semibold">{v.overallScore.toFixed(1)}</td>
              <td class="num">{v.coaStats.opened ? `${v.coaStats.portalVerified} of ${v.coaStats.opened}` : 'none published'}</td>
              <td class="whitespace-nowrap">{fillRange(v)}</td>
              <td class="min-w-[18rem] max-w-[34rem]">{v.verdictSummary}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
)}
