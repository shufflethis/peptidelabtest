---
/** Reader code display following affiliates.ts rules (codeOnlyOnVendorPage -> link to review page). */
import Icon from './Icon.astro';
import { codeInfo } from '../lib/site';
interface Props {
  slug: string;
  onOwnPage?: boolean;
  size?: 'sm' | 'md';
}
const { slug, onOwnPage = false, size = 'sm' } = Astro.props;
const c = codeInfo(slug, onOwnPage);
---
{c.kind === 'code' && (
  <span class={`inline-flex items-center gap-2 rounded-xl border border-dashed border-teal-300 bg-teal-50/60 ${size === 'md' ? 'px-3 py-2' : 'px-2.5 py-1.5'}`}>
    <Icon name="tag" class="w-4 h-4 text-teal-700" />
    <span class="text-xs text-slate-600">Code</span>
    <code class={`font-mono font-bold text-teal-900 ${size === 'md' ? 'text-base' : 'text-sm'}`}>{c.code}</code>
    <button type="button" data-copy={c.code} class="inline-flex items-center gap-1 text-xs font-semibold text-teal-700 hover:text-teal-900" aria-label={`Copy code ${c.code}`}>
      <Icon name="copy" class="w-3.5 h-3.5" />Copy
    </button>
    {c.note && size === 'md' && <span class="text-xs text-slate-500">{c.note}</span>}
  </span>
)}
{c.kind === 'on-review' && (
  <a href={c.reviewUrl} class="inline-flex items-center gap-1.5 text-xs font-semibold text-teal-700 hover:text-teal-900">
    <Icon name="tag" class="w-3.5 h-3.5" />Reader code on review page
  </a>
)}
{c.kind === 'link-only' && <span class="inline-flex items-center gap-1.5 text-xs text-slate-500"><Icon name="link" class="w-3.5 h-3.5" />Partner link, no code</span>}
{c.kind === 'none' && <span class="text-xs text-slate-400">No reader code</span>}
