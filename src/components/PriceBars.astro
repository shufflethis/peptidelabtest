---
/** Price-per-mg horizontal bar chart for one currency. Partner bars in accent, others grey. No conversion. */
import { curSymbol } from '../lib/site';
interface Bar {
  label: string;
  sub?: string;
  value: number;
  partner: boolean;
}
interface Props {
  bars: Bar[];
  currency: string;
  title?: string;
  max?: number;
}
const { bars, currency, title, max = 16 } = Astro.props;
const rows = [...bars].filter((b) => b.value != null && Number.isFinite(b.value)).sort((a, b) => a.value - b.value).slice(0, max);
const hi = Math.max(...rows.map((r) => r.value), 0.0001);
const W = 600;
const L = 215;
const R = 96;
const rowH = 32;
const H = rows.length * rowH + 10;
const sym = curSymbol(currency);
const fmt = (n: number) => `${sym}${n.toFixed(n < 0.1 ? 3 : 2)}`;
const trunc = (s: string, n = 27) => (s.length > n ? s.slice(0, n - 1) + '…' : s);
---
{rows.length > 0 && (
  <figure class="card p-4 sm:p-6">
    {title && <figcaption class="h3 mb-3">{title}</figcaption>}
    <div class="overflow-x-auto">
      <svg viewBox={`0 0 ${W} ${H}`} class="w-full min-w-[540px] max-w-[760px] h-auto" role="img" aria-label={`Price per mg in ${currency}, ${rows.length} offers, lowest first`}>
        {rows.map((r, i) => {
          const y = 5 + i * rowH;
          const w = Math.max(3, (r.value / hi) * (W - L - R));
          return (
            <g>
              <text x={L - 10} y={y + 20} text-anchor="end" font-size="14" fill={r.partner ? '#0f172a' : '#475569'} font-weight={r.partner ? '600' : '400'}>{trunc(r.label + (r.sub ? ` · ${r.sub}` : ''))}</text>
              <rect x={L} y={y + 6} width={w} height="18" rx="4" fill={r.partner ? '#0f766e' : '#cbd5e1'}>
                <title>{`${r.label}${r.sub ? ' ' + r.sub : ''}: ${fmt(r.value)}/mg`}</title>
              </rect>
              <text x={L + w + 7} y={y + 20} font-size="13.5" fill="#1e293b" font-weight="600">{fmt(r.value)}/mg</text>
            </g>
          );
        })}
      </svg>
    </div>
    <div class="mt-3 text-sm text-slate-700 flex flex-wrap items-center gap-x-5 gap-y-1.5">
      <span class="inline-flex items-center gap-1.5"><svg width="14" height="14" aria-hidden="true"><rect width="14" height="14" rx="3" fill="#0f766e" /></svg>Partner shop (has a store link)</span>
      <span class="inline-flex items-center gap-1.5"><svg width="14" height="14" aria-hidden="true"><rect width="14" height="14" rx="3" fill="#cbd5e1" /></svg>Other audited shop</span>
    </div>
    <p class="mt-1.5 text-sm text-slate-600">Price per mg = listed price (sale price if shown) divided by the mg on the label. {currency} only, no conversion.</p>
  </figure>
)}
