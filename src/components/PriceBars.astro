---
/** Price-per-mg horizontal bar chart for one currency. Partner bars in accent, others grey. No conversion. */
import { curSymbol } from '../lib/site';
interface Bar {
  label: string;
  sub?: string;
  value: number;
  partner: boolean;
}
interface Props {
  bars: Bar[];
  currency: string;
  title?: string;
  max?: number;
}
const { bars, currency, title, max = 18 } = Astro.props;
const rows = [...bars].filter((b) => b.value != null && Number.isFinite(b.value)).sort((a, b) => a.value - b.value).slice(0, max);
const hi = Math.max(...rows.map((r) => r.value), 0.0001);
const W = 640;
const L = 210;
const R = 80;
const rowH = 24;
const H = rows.length * rowH + 12;
const sym = curSymbol(currency);
const fmt = (n: number) => `${sym}${n.toFixed(n < 0.1 ? 3 : 2)}`;
const trunc = (s: string, n = 32) => (s.length > n ? s.slice(0, n - 1) + '…' : s);
---
{rows.length > 0 && (
  <figure class="card p-4 sm:p-5">
    {title && <figcaption class="text-sm font-bold text-slate-900 mb-2">{title}</figcaption>}
    <div class="overflow-x-auto">
      <svg viewBox={`0 0 ${W} ${H}`} class="w-full min-w-[520px] h-auto" role="img" aria-label={`Price per mg in ${currency}, ${rows.length} offers, lowest first`}>
        {rows.map((r, i) => {
          const y = 6 + i * rowH;
          const w = Math.max(2, (r.value / hi) * (W - L - R));
          return (
            <g>
              <text x={L - 10} y={y + 15} text-anchor="end" font-size="11.5" fill={r.partner ? '#0f172a' : '#64748b'} font-weight={r.partner ? '600' : '400'}>{trunc(r.label + (r.sub ? ` · ${r.sub}` : ''))}</text>
              <rect x={L} y={y + 4} width={w} height="15" rx="4" fill={r.partner ? '#0f766e' : '#cbd5e1'}>
                <title>{`${r.label}${r.sub ? ' ' + r.sub : ''}: ${fmt(r.value)}/mg`}</title>
              </rect>
              <text x={L + w + 6} y={y + 15} font-size="11" fill="#334155" font-weight="600">{fmt(r.value)}/mg</text>
            </g>
          );
        })}
      </svg>
    </div>
    <p class="mt-2 text-xs text-slate-500 flex flex-wrap items-center gap-x-4 gap-y-1">
      <span class="inline-flex items-center gap-1.5"><svg width="12" height="12" aria-hidden="true"><rect width="12" height="12" rx="3" fill="#0f766e" /></svg>Shop with a store link (partner)</span>
      <span class="inline-flex items-center gap-1.5"><svg width="12" height="12" aria-hidden="true"><rect width="12" height="12" rx="3" fill="#cbd5e1" /></svg>Other audited shop</span>
      <span>Listed price (sale price if shown) divided by label mg, {currency}, no conversion.</span>
    </p>
  </figure>
)}
