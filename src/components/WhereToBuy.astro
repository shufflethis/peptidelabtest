---
/** Where-to-buy block: partner shops carrying the compound (by audit score), EU/US split; other shops as internal links. */
import Icon from './Icon.astro';
import ScoreRing from './ScoreRing.astro';
import CodeBadge from './CodeBadge.astro';
import VerifyBadge from './VerifyBadge.astro';
import { PARTNERS, NON_PARTNERS, offersFor, REL_SPONSORED, compoundShort, reportVerify, shopShort, shopsCarrying } from '../lib/site';
import { t, lp, splitLang } from '../i18n';
import { fmt } from '../i18n/format';
interface Props {
  compound: string;
  size?: number;
  title: string;
}
const { compound, size, title } = Astro.props;
const lang = splitLang(Astro.url.pathname).lang;
const F = fmt(lang);
const offers = offersFor(compound, size);
const carrying = new Set(shopsCarrying(compound, size).map((v) => v.slug));
const short = compoundShort(compound);
const what = `${short}${size ? ` ${F.mg(size)}` : ''}`;
const best = (slug: string) => offers.filter((o) => o.vendor.slug === slug && o.perMg != null).sort((a, b) => a.perMg! - b.perMg!)[0] || offers.find((o) => o.vendor.slug === slug);
const regions = ['EU', 'US'].map((r) => ({
  region: r,
  partners: PARTNERS.filter((p) => p.region === r && offers.some((o) => o.vendor.slug === p.slug)),
  others: NON_PARTNERS.filter((p) => p.region === r && carrying.has(p.slug)),
}));
---
<section class="space-y-5" id="where-to-buy">
  <h2 class="h2">{title}</h2>
  <p class="text-slate-700 max-w-[70ch]">{t(lang, 'c.wtb.intro', { what })}</p>
  <div class="grid gap-6 lg:grid-cols-2">
    {regions.map((g) => (
      <div class="card p-5 sm:p-6">
        <h3 class="h3 flex items-center gap-2"><Icon name="map-pin" class="w-5 h-5 text-teal-800" />{g.region === 'EU' ? t(lang, 'c.euShops') : t(lang, 'c.usShops')}</h3>
        {g.partners.length === 0 && <p class="mt-3 text-slate-700">{t(lang, 'c.wtb.none', { what })}</p>}
        <ul class="mt-4 space-y-3">
          {g.partners.map((p) => {
            const o = best(p.slug)!;
            return (
              <li class="rounded-xl border border-slate-200 p-4 flex flex-col gap-3">
                <div class="flex items-start gap-3">
                  <ScoreRing score={p.overallScore} size={50} />
                  <div class="min-w-0 flex-1">
                    <a href={lp(lang, `/vendors/${p.slug}/`)} class="tap font-bold text-lg text-slate-900 hover:text-teal-800 hover:underline break-words">{p.name}</a>
                    <div class="text-sm text-slate-600">{o.product.shopProductName}</div>
                    <div class="sm:hidden mt-1"><span class="font-extrabold text-teal-900 tabular-nums">{F.perMg(o.perMg, o.currency)}</span> <span class="text-sm text-slate-700 tabular-nums">{F.money(o.price, o.currency)}{o.onSale && <s class="ml-1 text-slate-600">{F.money(o.listPrice, o.currency)}</s>}</span></div>
                  </div>
                  <div class="hidden sm:block text-right shrink-0">
                    <div class="font-extrabold text-teal-900 tabular-nums">{F.perMg(o.perMg, o.currency)}</div>
                    <div class="text-sm text-slate-700 tabular-nums">{F.money(o.price, o.currency)}{o.onSale && <s class="ml-1 text-slate-600">{F.money(o.listPrice, o.currency)}</s>}</div>
                  </div>
                </div>
                <div class="flex flex-wrap items-center gap-2">
                  {o.report ? <VerifyBadge level={reportVerify(o.report)} text={o.report.verifiable ? t(lang, 'c.wtb.repPortal', { c: short }) : t(lang, 'c.wtb.repShop', { c: short })} /> : <VerifyBadge level="none" text={t(lang, 'c.pt.noReport')} />}
                </div>
                <div class="flex flex-wrap items-center gap-3">
                  <CodeBadge slug={p.slug} />
                  {o.href && <a href={o.href} rel={REL_SPONSORED} target="_blank" class="btn-primary">{t(lang, 'c.visit', { shop: shopShort(p.name) })} <Icon name="external-link" class="w-4 h-4" /></a>}
                </div>
              </li>
            );
          })}
        </ul>
        {g.others.length > 0 && (
          <p class="mt-4 text-[0.94rem] text-slate-700 leading-relaxed">{t(lang, g.region === 'EU' ? 'c.wtb.othersEU' : 'c.wtb.othersUS', { c: what })} {g.others.map((s, i) => <>{i > 0 && ', '}<a href={lp(lang, `/vendors/${s.slug}/`)} class="text-link font-medium">{s.name}</a> ({t(lang, 'c.scoreShort', { s: F.score(s.overallScore) })})</>)}</p>
        )}
      </div>
    ))}
  </div>
  <p class="text-sm text-slate-600">{t(lang, 'c.wtb.note')}</p>
</section>
