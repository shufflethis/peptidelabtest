---
/**
 * Price table for one currency (7 columns). Partners first with sponsored deep link; non-partners greyed, internal link only.
 * No "price after code" is computed; the code sits in the last column next to the button.
 */
import Icon from './Icon.astro';
import CodeBadge from './CodeBadge.astro';
import type { Offer } from '../lib/site';
import { money, perMg, REL_SPONSORED, fillPct, mg, compoundShort, curSymbol } from '../lib/site';
interface Props {
  offers: Offer[];
  showCompound?: boolean;
  id?: string;
  caption?: string;
}
const { offers, showCompound = false, id, caption } = Astro.props;
const cur = offers[0]?.currency || 'EUR';
const sym = curSymbol(cur).trim();
const nOr = (n: number | null | undefined) => (n == null || !Number.isFinite(n) ? '' : String(n));
const labShort = (l: string) => l.replace(/\s*\(.*\)\s*$/, '');
---
<div class="table-wrap" id={id}>
  <table class="data-table" data-sortable>
    {caption && <caption class="sr-only">{caption}</caption>}
    <thead>
      <tr>
        <th scope="col"><button type="button" class="sort-btn" data-sort-type="text">Shop <Icon name="arrow-up-down" class="w-3.5 h-3.5" /></button></th>
        <th scope="col"><button type="button" class="sort-btn" data-sort-type="num">{showCompound ? 'Product' : 'Product (vial mg)'} <Icon name="arrow-up-down" class="w-3.5 h-3.5" /></button></th>
        <th scope="col" class="num"><button type="button" class="sort-btn" data-sort-type="num">Price ({sym}) <Icon name="arrow-up-down" class="w-3.5 h-3.5" /></button></th>
        <th scope="col" class="num"><button type="button" class="sort-btn" data-sort-type="num">Price per mg ({sym}) <Icon name="arrow-up-down" class="w-3.5 h-3.5" /></button></th>
        <th scope="col">Lab report for this compound</th>
        <th scope="col" class="num"><button type="button" class="sort-btn" data-sort-type="num">Score (0-5) <Icon name="arrow-up-down" class="w-3.5 h-3.5" /></button></th>
        <th scope="col">Code and store</th>
      </tr>
    </thead>
    <tbody>
      {offers.map((o) => {
        const r = o.report;
        const fp = r ? fillPct(r) : null;
        return (
          <tr class={o.partner ? '' : 'row-muted'}>
            <td data-v={o.vendor.name} class="min-w-[8.5rem]">
              <a href={`/vendors/${o.vendor.slug}/`} class={`font-semibold ${o.partner ? 'text-slate-900' : 'text-slate-700'} hover:text-teal-800 hover:underline`}>{o.vendor.name}</a>
              <span class="sub">{o.vendor.region}{o.partner ? ' · partner' : ' · no store link'}</span>
              <span class="md:hidden mt-1 block text-[0.9rem]"><strong class="text-teal-900 tabular-nums">{perMg(o.perMg, o.currency)}</strong> <span class="text-slate-700">· {mg(o.product.vialMg)}</span></span>
            </td>
            <td data-v={nOr(o.product.vialMg)} class="min-w-[9rem] max-w-[14rem]">
              {showCompound && <span class="font-semibold">{compoundShort(o.product.compound)} </span>}
              <span class="font-medium">{mg(o.product.vialMg)}</span>
              <span class="sub">{o.product.shopProductName}{o.product.inStock === false ? ' (out of stock)' : ''}</span>
            </td>
            <td class="num" data-v={nOr(o.price)}>
              <span class="font-semibold text-slate-900">{money(o.price, o.currency)}</span>
              {o.onSale && <span class="sub"><span class="sr-only">was </span><s>{money(o.listPrice, o.currency)}</s></span>}
            </td>
            <td class="num" data-v={nOr(o.perMg)}><span class={`font-bold ${o.partner ? 'text-teal-900' : 'text-slate-800'}`}>{perMg(o.perMg, o.currency)}</span></td>
            <td class="min-w-[11rem] max-w-[15rem]">
              {r ? (
                <div>
                  <span class="font-semibold text-slate-900">{r.verifiable ? 'Yes, portal-verified' : 'Yes, shop-hosted'}</span>
                  <span class="sub">
                    {r.measuredMg != null && r.labelMg != null ? `${r.measuredMg} of ${r.labelMg} mg (${fp!.toFixed(1)}%)` : 'mg not stated'}
                    {r.purityPercent != null ? `, purity ${r.purityPercent}%` : ''}
                  </span>
                  <span class="sub">{labShort(r.lab)}</span>
                </div>
              ) : (
                <span class="text-slate-700">No report opened</span>
              )}
            </td>
            <td class="num" data-v={String(o.vendor.overallScore)}><span class="font-semibold">{o.vendor.overallScore.toFixed(1)}</span></td>
            <td class="min-w-[10.5rem]">
              {o.href ? (
                <div class="flex flex-col items-start gap-2">
                  <CodeBadge slug={o.vendor.slug} size="xs" />
                  <a href={o.href} rel={REL_SPONSORED} target="_blank" class="btn-primary">Visit shop <Icon name="external-link" class="w-4 h-4" /></a>
                </div>
              ) : (
                <a href={`/vendors/${o.vendor.slug}/`} class="text-link whitespace-nowrap">Read review</a>
              )}
            </td>
          </tr>
        );
      })}
    </tbody>
  </table>
</div>
