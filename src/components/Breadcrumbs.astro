---
/** Visible breadcrumb trail. BreadcrumbList JSON-LD is emitted by BaseLayout from the same items. */
import Icon from './Icon.astro';
import { t, splitLang } from '../i18n';
interface Props {
  items: { name: string; url: string }[];
}
const { items } = Astro.props;
const lang = splitLang(Astro.url.pathname).lang;
---
<nav aria-label={t(lang, 'c.breadcrumb')} class="text-sm text-slate-600">
  <ol class="flex flex-wrap items-center gap-1">
    {items.map((it, i) => (
      <li class="inline-flex items-center gap-1">
        {i > 0 && <Icon name="chevron-right" class="w-3.5 h-3.5 text-slate-500" />}
        {i < items.length - 1 ? <a href={it.url} class="hover:text-teal-800 underline-offset-2 hover:underline">{it.name}</a> : <span class="text-slate-800 font-medium">{it.name}</span>}
      </li>
    ))}
  </ol>
</nav>
