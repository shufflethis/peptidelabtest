---
/** Visible breadcrumb trail. BreadcrumbList JSON-LD is emitted by BaseLayout from the same items. */
import Icon from './Icon.astro';
interface Props {
  items: { name: string; url: string }[];
}
const { items } = Astro.props;
---
<nav aria-label="Breadcrumb" class="text-xs text-slate-500">
  <ol class="flex flex-wrap items-center gap-1">
    {items.map((it, i) => (
      <li class="inline-flex items-center gap-1">
        {i > 0 && <Icon name="chevron-right" class="w-3 h-3 text-slate-400" />}
        {i < items.length - 1 ? <a href={it.url} class="hover:text-teal-700">{it.name}</a> : <span class="text-slate-700 font-medium">{it.name}</span>}
      </li>
    ))}
  </ol>
</nav>
