---
/**
 * Generic data bar list (HTML labels + one inline SVG bar per row, built from data at build time).
 * Bars animate in on scroll unless the visitor prefers reduced motion (see .bar-anim in global.css).
 */
interface Row {
  label: string;
  sub?: string;
  value: number;
  display: string;
  accent?: boolean;
  href?: string;
}
interface Props {
  rows: Row[];
  title?: string;
  note?: string;
  max?: number;
  legend?: { accent: string; other: string };
  /** reference line in value units (e.g. 100 for 100 % of label) */
  ref?: number;
}
const { rows, title, note, max, legend, ref } = Astro.props;
const hi = max ?? Math.max(...rows.map((r) => r.value), 0.0001);
---
{rows.length > 0 && (
  <figure class="card p-4 sm:p-6" data-chart="bars">
    {title && <figcaption class="h3 mb-4">{title}</figcaption>}
    <ol class="space-y-2.5">
      {rows.map((r) => (
        <li class="grid gap-x-4 gap-y-1 sm:grid-cols-[15rem_1fr] sm:items-center">
          <span class={`text-[0.94rem] leading-snug ${r.accent ? 'font-semibold text-slate-900' : 'text-slate-700'}`}>
            {r.href ? <a href={r.href} class="hover:underline">{r.label}</a> : r.label}{r.sub && <span class="text-slate-600 font-normal"> · {r.sub}</span>}
          </span>
          <span class="flex items-center gap-3">
            <svg viewBox="0 0 100 10" preserveAspectRatio="none" class="h-4 flex-1 min-w-0" aria-hidden="true">
              <rect x="0" y="0" width="100" height="10" rx="2" fill="#f1f5f9" />
              <rect class="bar-anim" x="0" y="0" width={Math.max(1.5, Math.min(100, (r.value / hi) * 100))} height="10" rx="2" fill={r.accent ? '#0f766e' : '#94a3b8'} />
              {ref != null && <line x1={(ref / hi) * 100} x2={(ref / hi) * 100} y1="0" y2="10" stroke="#0f172a" stroke-width="0.6" />}
            </svg>
            <span class="w-[6.5rem] shrink-0 text-right font-semibold tabular-nums text-slate-900">{r.display}</span>
          </span>
        </li>
      ))}
    </ol>
    {legend && (
      <div class="mt-4 text-sm text-slate-700 flex flex-wrap items-center gap-x-5 gap-y-1.5">
        <span class="inline-flex items-center gap-1.5"><svg width="14" height="14" aria-hidden="true"><rect width="14" height="14" rx="3" fill="#0f766e" /></svg>{legend.accent}</span>
        <span class="inline-flex items-center gap-1.5"><svg width="14" height="14" aria-hidden="true"><rect width="14" height="14" rx="3" fill="#94a3b8" /></svg>{legend.other}</span>
      </div>
    )}
    {note && <p class="mt-2 text-sm text-slate-600">{note}</p>}
  </figure>
)}
