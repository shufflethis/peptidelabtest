---
/** FAQ accordion. Pair with faqSchema() in the page's jsonLd for FAQPage markup. */
import Icon from './Icon.astro';
import { t, splitLang } from '../i18n';
interface Props {
  items: { q: string; a: string }[];
  title?: string;
  id?: string;
}
const lang = splitLang(Astro.url.pathname).lang;
const { items, title = t(lang, 'c.faq'), id = 'faq' } = Astro.props;
---
{items.length > 0 && (
  <section id={id} class="space-y-4">
    <h2 class="h2">{title}</h2>
    <div class="card divide-y divide-slate-200 max-w-4xl">
      {items.map((f, i) => (
        <details class="group px-5 py-4" open={i === 0}>
          <summary class="flex cursor-pointer items-start justify-between gap-4 min-h-[44px] py-1 font-semibold text-slate-900 text-[1.02rem]">
            <span>{f.q}</span>
            <Icon name="chevron-down" class="w-5 h-5 mt-1 text-slate-600 transition-transform group-open:rotate-180" />
          </summary>
          <p class="mt-2 text-slate-700 leading-relaxed max-w-[70ch]">{f.a}</p>
        </details>
      ))}
    </div>
  </section>
)}
