---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { SITE_BRAND } from '../data/affiliates';
import { SITE_URL, SITE_NAME, CHECKED_ISO, CHECKED_LABEL, padDesc } from '../lib/site';

interface Crumb {
  name: string;
  url: string;
}
interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  crumbs?: Crumb[];
  noindex?: boolean;
  ogType?: string;
}

const { title, description: rawDescription, canonicalPath = Astro.url.pathname, jsonLd, crumbs = [], noindex = false, ogType = 'website' } = Astro.props;
const description = padDesc(rawDescription);
const path = canonicalPath.endsWith('/') || canonicalPath.includes('.') ? canonicalPath : `${canonicalPath}/`;
const canonicalUrl = new URL(path, SITE_URL).toString();

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${SITE_URL}/#organization`,
  name: SITE_NAME,
  url: `${SITE_URL}/`,
  logo: `${SITE_URL}/favicon.svg`,
  description:
    'Independent desk audit of research peptide shops in the EU and US: opened lab reports, measured vs label content, portal verification and listed prices per mg.',
  publishingPrinciples: `${SITE_URL}/methodology/`,
  contactPoint: { '@type': 'ContactPoint', email: SITE_BRAND.contactEmail, contactType: 'editorial' },
};
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE_URL}/#website`,
  name: SITE_NAME,
  url: `${SITE_URL}/`,
  publisher: { '@id': `${SITE_URL}/#organization` },
  inLanguage: 'en',
};
const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': canonicalUrl,
  url: canonicalUrl,
  name: title,
  description,
  isPartOf: { '@id': `${SITE_URL}/#website` },
  dateModified: CHECKED_ISO,
  inLanguage: 'en',
};
const allCrumbs = crumbs.length ? crumbs : path === '/' ? [] : [{ name: 'Home', url: '/' }, { name: title.split(/[:|–-]/)[0].trim(), url: path }];
const breadcrumbSchema = allCrumbs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: allCrumbs.map((b, i) => ({ '@type': 'ListItem', position: i + 1, name: b.name, item: new URL(b.url, SITE_URL).toString() })),
    }
  : null;
const extra = Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [];
const schemas = [orgSchema, websiteSchema, webPageSchema, ...(breadcrumbSchema ? [breadcrumbSchema] : []), ...extra];

const nav = [
  { href: '/prices/', label: 'Compare prices', icon: 'bar-h' },
  { href: '/vendors/', label: 'Shops', icon: 'building' },
  { href: '/batch-tracker/', label: 'Lab reports', icon: 'file-text' },
  { href: '/compounds/', label: 'Compounds', icon: 'beaker' },
  { href: '/methodology/', label: 'Methodology', icon: 'microscope' },
];
const current = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="impact-site-verification" value="9a4d3bdd-10ed-4e2f-a60b-8d61db5f0a63" content="9a4d3bdd-10ed-4e2f-a60b-8d61db5f0a63" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-snippet:-1, max-image-preview:large'} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="en_US" />
    <meta property="article:modified_time" content={CHECKED_ISO} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="alternate" type="text/plain" title="llms.txt" href="/llms.txt" />
    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
    <!-- Privacy-friendly analytics by Plausible -->
    <script is:inline async src="https://analytics.polymarkt.de/js/pa-gLRgumVP7qfI1CLz6JJes.js"></script>
    <script is:inline>
      window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
      plausible.init()
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-white font-sans text-slate-700 antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-[60] focus:bg-white focus:px-3 focus:py-2 focus:rounded-lg">Skip to content</a>

    <div class="bg-slate-900 text-slate-100 text-sm py-2 px-4 text-center leading-snug">
      Desk audit of public shop pages and lab portals, last checked <strong class="text-white font-semibold">{CHECKED_LABEL}</strong>. Research-use-only products; no dosing or health information.
      <a href="/methodology/" class="ml-1 underline underline-offset-2 text-teal-200 hover:text-white">How we score</a>
    </div>

    <header class="sticky top-0 z-50 bg-white/90 backdrop-blur-xl border-b border-slate-200/80">
      <div class="wrap h-16 flex items-center justify-between gap-4">
        <a href="/" class="flex items-center gap-2.5 shrink-0 group" aria-label={`${SITE_NAME} home`}>
          <span class="w-9 h-9 rounded-xl bg-gradient-to-br from-teal-600 to-emerald-700 flex items-center justify-center shadow-sm">
            <svg viewBox="0 0 24 24" class="w-5 h-5 text-white" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9.5 2.5h5M10 2.5v6L4.6 18.4A2 2 0 0 0 6.4 21.5h11.2a2 2 0 0 0 1.8-3.1L14 8.5v-6" /><path d="M7.2 14.5h9.6" /></svg>
          </span>
          <span class="leading-tight">
            <span class="block font-extrabold text-[15px] sm:text-lg tracking-tight text-slate-900">Peptide<span class="text-teal-700">Lab</span>Index</span>
            <span class="hidden sm:block text-xs text-slate-600">Prices &amp; lab reports compared</span>
          </span>
        </a>
        <nav class="hidden lg:flex items-center gap-1 text-[0.94rem] font-medium text-slate-700" aria-label="Main">
          {nav.map((n) => (
            <a href={n.href} class={`px-3 py-2 rounded-lg transition-colors hover:bg-teal-50 hover:text-teal-800 ${current.startsWith(n.href) ? 'text-teal-800 bg-teal-50' : ''}`}>{n.label}</a>
          ))}
        </nav>
        <div class="flex items-center gap-2">
          <a href="/vendors/" class="hidden sm:inline-flex btn-primary">Best audited shops</a>
          <button id="nav-toggle" type="button" class="lg:hidden inline-flex items-center justify-center w-11 h-11 rounded-xl border border-slate-200 text-slate-700" aria-label="Open menu" aria-expanded="false" aria-controls="nav-panel">
            <Icon name="menu" class="w-5 h-5" />
          </button>
        </div>
      </div>
      <div id="nav-panel" class="hidden lg:hidden border-t border-slate-200 bg-white px-4 py-3 shadow-lg">
        {nav.map((n) => (
          <a href={n.href} class="flex items-center gap-2.5 px-3 py-2.5 rounded-xl text-base font-medium text-slate-800 hover:bg-teal-50"><Icon name={n.icon} class="w-4 h-4 text-teal-700" />{n.label}</a>
        ))}
        <a href="/labs/" class="flex items-center gap-2.5 px-3 py-2.5 rounded-xl text-base font-medium text-slate-800 hover:bg-teal-50"><Icon name="flask" class="w-4 h-4 text-teal-700" />Testing labs</a>
        <a href="/compare/" class="flex items-center gap-2.5 px-3 py-2.5 rounded-xl text-base font-medium text-slate-800 hover:bg-teal-50"><Icon name="git-compare" class="w-4 h-4 text-teal-700" />Compound comparisons</a>
      </div>
    </header>

    <main id="main" class="flex-grow">
      <slot />
    </main>

    <div id="copy-toast" class="fixed bottom-6 right-6 z-50 hidden items-center gap-2 px-4 py-3 rounded-xl bg-slate-900 text-white text-sm font-semibold shadow-2xl" role="status" aria-live="polite"></div>

    <footer class="mt-20 bg-slate-50 border-t border-slate-200">
      <div class="wrap py-14">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10 text-[0.94rem]">
          <div>
            <div class="font-extrabold text-slate-900 text-base">Peptide<span class="text-teal-700">Lab</span>Index</div>
            <p class="mt-2 text-slate-600 leading-relaxed">We read shop pages, lab portals and price lists so research buyers can compare shops on facts: opened lab reports, measured content and price per mg.</p>
          </div>
          <div>
            <h2 class="text-base font-bold text-slate-900 mb-3">Compare</h2>
            <ul class="space-y-2 text-slate-700">
              <li><a href="/prices/" class="hover:text-teal-700">Price comparison by compound</a></li>
              <li><a href="/vendors/" class="hover:text-teal-700">Shop ranking</a></li>
              <li><a href="/vendors/europe/" class="hover:text-teal-700">EU shops</a></li>
              <li><a href="/vendors/usa/" class="hover:text-teal-700">US shops</a></li>
              <li><a href="/vendors/compare/" class="hover:text-teal-700">Shop vs shop</a></li>
              <li><a href="/compare/" class="hover:text-teal-700">Compound vs compound</a></li>
              <li><a href="/discount-codes/" class="hover:text-teal-700">Reader codes</a></li>
            </ul>
          </div>
          <div>
            <h2 class="text-base font-bold text-slate-900 mb-3">Lab data &amp; tools</h2>
            <ul class="space-y-2 text-slate-700">
              <li><a href="/batch-tracker/" class="hover:text-teal-700">Lab reports we opened</a></li>
              <li><a href="/labs/" class="hover:text-teal-700">Testing labs</a></li>
              <li><a href="/compounds/" class="hover:text-teal-700">Compound index</a></li>
              <li><a href="/data/" class="hover:text-teal-700">Open dataset (CSV / JSON)</a></li>
              <li><a href="/calculator/" class="hover:text-teal-700">Stock concentration calculator</a></li>
              <li><a href="/research/" class="hover:text-teal-700">Guides</a></li>
              <li><a href="/llms.txt" class="hover:text-teal-700">llms.txt</a></li>
            </ul>
          </div>
          <div>
            <h2 class="text-base font-bold text-slate-900 mb-3">About &amp; legal</h2>
            <ul class="space-y-2 text-slate-700">
              <li><a href="/methodology/" class="hover:text-teal-700">Methodology</a></li>
              <li><a href="/laws/" class="hover:text-teal-700">Country notes</a></li>
              <li><a href="/legal/" class="hover:text-teal-700">Legal, disclosure &amp; privacy</a></li>
              <li><a href="/advertise/" class="hover:text-teal-700">For shops</a></li>
            </ul>
          </div>
        </div>
        <div class="mt-10 pt-6 border-t border-slate-200 space-y-3 text-sm text-slate-600 leading-relaxed max-w-[90ch]">
          <p><strong class="text-slate-700">Research use only.</strong> All products listed are sold by the shops as research-use-only (RUO) laboratory reagents. They are not drugs, supplements or cosmetics. Nothing on {SITE_BRAND.domain} is medical advice or information about human or animal use.</p>
          <p><strong class="text-slate-700">Affiliate disclosure.</strong> Store links to partner shops are affiliate links (rel="sponsored"); we may earn a commission at no extra cost to you. Shops without a partnership get no outbound link. Rankings use the published audit score only, never commission.</p>
          <p>&copy; 2026 {SITE_NAME} ({SITE_BRAND.domain}). Data last checked {CHECKED_LABEL}.</p>
        </div>
      </div>
    </footer>

    <script>
      const btn = document.getElementById('nav-toggle');
      const panel = document.getElementById('nav-panel');
      btn?.addEventListener('click', () => {
        const open = panel?.classList.toggle('hidden') === false;
        btn.setAttribute('aria-expanded', String(open));
      });

      const toast = document.getElementById('copy-toast');
      document.addEventListener('click', (e) => {
        const el = (e.target as HTMLElement)?.closest('[data-copy],[data-copy-code]') as HTMLElement | null;
        if (!el) return;
        const code = el.getAttribute('data-copy') || el.getAttribute('data-copy-code');
        if (!code) return;
        navigator.clipboard?.writeText(code);
        if (toast) {
          toast.textContent = `Copied "${code}"`;
          toast.classList.remove('hidden');
          toast.classList.add('flex');
          setTimeout(() => { toast.classList.add('hidden'); toast.classList.remove('flex'); }, 2200);
        }
      });

      // Small vanilla table sort: <table data-sortable>, buttons .sort-btn in <th>, cells may carry data-v.
      document.querySelectorAll<HTMLTableElement>('table[data-sortable]').forEach((table) => {
        const ths = Array.from(table.querySelectorAll('thead th'));
        ths.forEach((th, idx) => {
          const b = th.querySelector<HTMLButtonElement>('.sort-btn');
          if (!b) return;
          let asc = true;
          b.addEventListener('click', () => {
            const tbody = table.tBodies[0];
            const rows = Array.from(tbody.rows);
            const num = b.dataset.sortType === 'num';
            const val = (r: HTMLTableRowElement) => {
              const c = r.cells[idx];
              const raw = c?.dataset.v ?? c?.textContent?.trim() ?? '';
              if (!num) return raw.toLowerCase();
              const n = parseFloat(raw);
              return Number.isFinite(n) ? n : asc ? Infinity : -Infinity;
            };
            rows.sort((a, z) => {
              const x = val(a), y = val(z);
              if (x < y) return asc ? -1 : 1;
              if (x > y) return asc ? 1 : -1;
              return 0;
            });
            rows.forEach((r) => tbody.appendChild(r));
            ths.forEach((t) => t.removeAttribute('aria-sort'));
            th.setAttribute('aria-sort', asc ? 'ascending' : 'descending');
            asc = !asc;
          });
        });
      });
    </script>
  </body>
</html>
