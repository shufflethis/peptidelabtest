---
import '../styles/global.css';
import { SITE_BRAND } from '../data/affiliates';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, canonicalPath = Astro.url.pathname, jsonLd } = Astro.props;
const canonicalUrl = new URL(canonicalPath, SITE_BRAND.url).toString();

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE_BRAND.name,
  url: SITE_BRAND.url,
  description:
    'Independent third-party COA verification index, true $/mg price benchmark, and batch fill-variance tracker for research peptides in the US and EU.',
  sameAs: [SITE_BRAND.telegramUrl],
  contactPoint: {
    '@type': 'ContactPoint',
    email: SITE_BRAND.contactEmail,
    contactType: 'editorial & partner inquiries',
  },
};

const extraSchemas = Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [];
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="impact-site-verification" value="9a4d3bdd-10ed-4e2f-a60b-8d61db5f0a63" content="9a4d3bdd-10ed-4e2f-a60b-8d61db5f0a63" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large" />

    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    {extraSchemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </head>
  <body class="min-h-screen flex flex-col bg-[#030712] text-slate-100 antialiased grid-bg">
    <!-- Top Audit Status Bar -->
    <div class="bg-cyan-950/70 border-b border-cyan-800/40 text-cyan-200 text-xs py-2 px-4 text-center font-mono">
      <span>
        🔬 <strong>{SITE_BRAND.updatedLabel} COA &amp; Fill-Variance Audit:</strong> 22 US &amp; EU suppliers benchmarked on portal-verifiable COAs &amp; true $/mg.
        <a href="/price-index/" class="underline hover:text-white ml-1.5 font-semibold">Compare True $/mg &rarr;</a>
      </span>
    </div>

    <!-- Sticky Header -->
    <header class="sticky top-0 z-50 backdrop-blur-xl bg-[#030712]/90 border-b border-slate-800/80">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
        <a href="/" class="flex items-center gap-3 group shrink-0">
          <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-cyan-500 to-emerald-400 flex items-center justify-center shadow-lg shadow-cyan-500/20 group-hover:scale-105 transition-transform">
            <span class="text-slate-950 font-black text-base font-mono">PLI</span>
          </div>
          <div>
            <span class="font-extrabold text-lg tracking-tight text-white">
              Peptide<span class="text-cyan-400">Lab</span><span class="text-emerald-400">Index</span>
            </span>
            <span class="text-[10px] font-mono text-slate-400 block -mt-1 tracking-widest uppercase">
              COA &amp; $/mg Audit Directory
            </span>
          </div>
        </a>

        <nav class="hidden xl:flex items-center gap-5 text-sm font-medium text-slate-300 whitespace-nowrap">
          <a href="/vendors/" class="hover:text-cyan-400 transition-colors">Vendor Scorecard</a>
          <a href="/price-index/" class="hover:text-cyan-400 transition-colors flex items-center gap-1">
            <span>True $/mg Index</span>
            <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-emerald-500/15 text-emerald-300 border border-emerald-500/30">LIVE</span>
          </a>
          <a href="/batch-tracker/" class="hover:text-cyan-400 transition-colors">Batch Fill Tracker</a>
          <a href="/calculator/" class="hover:text-cyan-400 transition-colors">Blend Calculator</a>
          <a href="/compounds/" class="hover:text-cyan-400 transition-colors">Compounds</a>
          <a href="/laws/" class="hover:text-cyan-400 transition-colors">Customs &amp; Laws</a>
          <a href="/discount-codes/" class="hover:text-emerald-400 transition-colors text-emerald-300">Verified Codes</a>
        </nav>

        <div class="flex items-center gap-2.5">
          <a
            href="/calculator/"
            class="hidden sm:inline-flex items-center gap-1.5 text-xs font-mono font-semibold px-3 py-2 rounded-lg bg-slate-900 text-slate-200 border border-slate-700 hover:border-cyan-500/60 transition-all"
          >
            🧮 Syringe Tool
          </a>
          <a
            href="/vendors/"
            class="inline-flex items-center gap-1.5 text-xs font-mono font-bold px-3.5 py-2 rounded-lg bg-gradient-to-r from-cyan-500 to-emerald-400 text-slate-950 hover:opacity-95 transition-opacity"
          >
            Top 2026 Labs &rarr;
          </a>
          <button
            id="mobile-nav-toggle"
            type="button"
            aria-label="Toggle navigation menu"
            class="xl:hidden p-2 rounded-lg border border-slate-800 text-slate-300 hover:text-white"
          >
            ☰
          </button>
        </div>
      </div>

      <!-- Mobile Menu -->
      <div id="mobile-nav-panel" class="hidden xl:hidden border-t border-slate-800 bg-slate-950 px-4 py-4 space-y-2 text-sm">
        <a href="/vendors/" class="block py-1.5 text-slate-200 hover:text-cyan-400">🏆 Vendor Audit Scorecard (US &amp; EU)</a>
        <a href="/price-index/" class="block py-1.5 text-emerald-300 hover:text-emerald-200">💰 True $/mg &amp; €/mg Price Index</a>
        <a href="/batch-tracker/" class="block py-1.5 text-slate-200 hover:text-cyan-400">📊 COA Batch &amp; Fill-Variance Tracker</a>
        <a href="/calculator/" class="block py-1.5 text-slate-200 hover:text-cyan-400">🧮 Peptide &amp; Blend Reconstitution Calculator</a>
        <a href="/compounds/" class="block py-1.5 text-slate-200 hover:text-cyan-400">🧬 Molecular Compound Database</a>
        <a href="/laws/" class="block py-1.5 text-slate-200 hover:text-cyan-400">🌍 Country Customs &amp; RUO Laws</a>
        <a href="/labs/" class="block py-1.5 text-slate-200 hover:text-cyan-400">🔬 Analytical Testing Labs</a>
        <a href="/research/" class="block py-1.5 text-slate-200 hover:text-cyan-400">📑 Research &amp; Code-Name Guides</a>
        <a href="/discount-codes/" class="block py-1.5 text-cyan-300 hover:text-cyan-200">🏷️ Verified Partner Discount Codes</a>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <!-- Copy Toast -->
    <div
      id="copy-toast"
      class="fixed bottom-5 right-5 z-50 hidden px-4 py-2.5 rounded-xl bg-emerald-500 text-slate-950 font-mono text-xs font-bold shadow-xl shadow-emerald-500/25"
    >
      ✓ Code copied to clipboard!
    </div>

    <!-- Comprehensive SEO Internal-Link Footer -->
    <footer class="border-t border-slate-800/80 bg-[#02050e] mt-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 pb-10">
          <div class="lg:col-span-2 space-y-3">
            <a href="/" class="inline-flex items-center gap-2.5 font-extrabold text-lg text-white">
              <span>🔬</span>
              <span>Peptide<span class="text-cyan-400">Lab</span><span class="text-emerald-400">Index</span>.com</span>
            </a>
            <p class="text-xs text-slate-400 leading-relaxed max-w-md">
              Independent analytical directory benchmarking US and European research peptide suppliers against portal-verifiable HPLC/LC-MS Certificates of Analysis, batch fill-weight accuracy, and net cost per measured milligram.
            </p>
            <div class="pt-1 flex flex-wrap gap-2 text-[11px] font-mono">
              <a href="/llms.txt" class="px-2.5 py-1 rounded bg-slate-900 border border-slate-800 text-slate-400 hover:text-cyan-300">
                🤖 AI / LLMs Reference (llms.txt)
              </a>
              <a href="/methodology/" class="px-2.5 py-1 rounded bg-slate-900 border border-slate-800 text-slate-400 hover:text-cyan-300">
                📐 6-Axis Audit Methodology
              </a>
            </div>
          </div>

          <div>
            <h2 class="font-mono text-slate-200 font-bold uppercase text-[11px] tracking-wider mb-3">Supplier Audits</h2>
            <ul class="space-y-2 text-xs text-slate-400">
              <li><a href="/vendors/" class="hover:text-cyan-400">All 22 Audited Suppliers</a></li>
              <li><a href="/vendors/usa/" class="hover:text-cyan-400">Best US Domestic Vendors</a></li>
              <li><a href="/vendors/europe/" class="hover:text-cyan-400">Best EU Domestic Vendors</a></li>
              <li><a href="/vendors/peptide-sciences/" class="hover:text-cyan-400">Peptide Sciences 2026 Shutdown</a></li>
              <li><a href="/discount-codes/" class="hover:text-emerald-400">Verified Discount Codes</a></li>
              <li><a href="/labs/" class="hover:text-cyan-400">Third-Party Testing Labs</a></li>
            </ul>
          </div>

          <div>
            <h2 class="font-mono text-slate-200 font-bold uppercase text-[11px] tracking-wider mb-3">Precision Lab Tools</h2>
            <ul class="space-y-2 text-xs text-slate-400">
              <li><a href="/price-index/" class="hover:text-cyan-400">True $/mg &amp; €/mg Price Index</a></li>
              <li><a href="/batch-tracker/" class="hover:text-cyan-400">COA Fill-Variance Tracker</a></li>
              <li><a href="/calculator/" class="hover:text-cyan-400">Blend &amp; U-100 Syringe Calculator</a></li>
              <li><a href="/compounds/" class="hover:text-cyan-400">Molecular Compound Database</a></li>
              <li><a href="/research/rt-3-glp-3-retatrutide-code-names/" class="hover:text-cyan-400">RT-3 / GLP-3 Code Decoder</a></li>
              <li><a href="/research/" class="hover:text-cyan-400">All Analytical Guides</a></li>
            </ul>
          </div>

          <div>
            <h2 class="font-mono text-slate-200 font-bold uppercase text-[11px] tracking-wider mb-3">Customs, Laws &amp; Legal</h2>
            <ul class="space-y-2 text-xs text-slate-400">
              <li><a href="/laws/" class="hover:text-cyan-400">Peptide Laws &amp; Customs Index</a></li>
              <li><a href="/laws/united-states/" class="hover:text-cyan-400">US RUO &amp; FDA Status</a></li>
              <li><a href="/laws/germany/" class="hover:text-cyan-400">Germany / EU Zoll Guide</a></li>
              <li><a href="/laws/united-kingdom/" class="hover:text-cyan-400">UK Post-Brexit Guide</a></li>
              <li><a href="/advertise/" class="hover:text-cyan-400">Featured Category Sponsorship</a></li>
              <li><a href="/legal/" class="hover:text-cyan-400">Legal, Terms &amp; Privacy</a></li>
            </ul>
          </div>
        </div>

        <!-- Mandatory RUO & FTC Affiliate Compliance -->
        <div class="pt-8 border-t border-slate-800/80 space-y-3 text-[11px] text-slate-400 leading-relaxed font-mono">
          <p>
            <strong class="text-slate-200">STRICT RESEARCH USE ONLY (RUO) DISCLAIMER:</strong> All chemical compounds, analytical certificates, and concentration tools published on {SITE_BRAND.domain} are strictly intended for qualified in-vitro laboratory research and analytical assay calibration. Nothing on this site constitutes medical, clinical, or dosing advice. Listed reagents are NOT drugs, supplements, or cosmetics and are NOT approved for human or veterinary administration.
          </p>
          <p>
            <strong class="text-slate-200">FTC AFFILIATE &amp; EDITORIAL DISCLOSURE:</strong> {SITE_BRAND.name} operates as an independent analytical index. Outbound links marked with <code>rel="sponsored"</code> or accompanied by partner discount codes may earn a referral commission at zero extra cost to the buyer (in fact reducing net vial price). Referral eligibility never alters our 6-axis COA audit scores; non-affiliated vendors and underfilled batches are audited under identical criteria.
          </p>
          <p class="text-slate-500">
            &copy; 2026 {SITE_BRAND.name} ({SITE_BRAND.domain}). All analytical summaries verified as of {SITE_BRAND.updatedLabel}.
          </p>
        </div>
      </div>
    </footer>

    <script>
      const navBtn = document.getElementById('mobile-nav-toggle');
      const navPanel = document.getElementById('mobile-nav-panel');
      navBtn?.addEventListener('click', () => {
        navPanel?.classList.toggle('hidden');
      });

      document.addEventListener('click', (e) => {
        const target = (e.target as HTMLElement)?.closest('[data-copy-code]') as HTMLElement | null;
        if (!target) return;
        const code = target.getAttribute('data-copy-code');
        if (!code) return;
        navigator.clipboard?.writeText(code);
        const toast = document.getElementById('copy-toast');
        if (toast) {
          toast.textContent = `✓ Copied code "${code}" to clipboard!`;
          toast.classList.remove('hidden');
          setTimeout(() => toast.classList.add('hidden'), 2400);
        }
      });
    </script>
  </body>
</html>
