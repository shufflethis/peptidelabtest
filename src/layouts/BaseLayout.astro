---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { splitLang, t, lp, fmtDate, LIVE_LANGS, LANG_LABEL, LANG_NAME, OG_LOCALE, type Lang } from '../i18n';
import { SITE_BRAND } from '../data/affiliates';
import { SITE_URL, SITE_NAME, CHECKED_ISO, padDesc, SOCIAL_SAME_AS } from '../lib/site';

interface Crumb {
  name: string;
  url: string;
}
interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  crumbs?: Crumb[];
  noindex?: boolean;
  ogType?: string;
  lang?: Lang;
  /** Set false for pages that exist in English only (404). */
  translated?: boolean;
}

const { title, description: rawDescription, canonicalPath = Astro.url.pathname, jsonLd, crumbs = [], noindex = false, ogType = 'website', translated = true } = Astro.props;
const split = splitLang(Astro.url.pathname);
const { lang = split.lang } = Astro.props;
const langPath = split.path.endsWith('/') || split.path.includes('.') ? split.path : `${split.path}/`;
const date = fmtDate(lang, CHECKED_ISO);
const description = padDesc(rawDescription, [t(lang, 'seo.pad1', { date }), t(lang, 'seo.pad2'), t(lang, 'seo.pad3')]);
const path = canonicalPath.endsWith('/') || canonicalPath.includes('.') ? canonicalPath : `${canonicalPath}/`;
const canonicalUrl = new URL(path, SITE_URL).toString();
const alternates = translated ? LIVE_LANGS.map((l) => ({ lang: l, href: new URL(lp(l, langPath), SITE_URL).toString() })) : [];
const L = (p: string) => lp(lang, p);

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${SITE_URL}/#organization`,
  name: SITE_NAME,
  url: `${SITE_URL}/`,
  logo: `${SITE_URL}/favicon.svg`,
  description: t(lang, 'layout.orgDesc'),
  publishingPrinciples: `${SITE_URL}/methodology/`,
  contactPoint: { '@type': 'ContactPoint', email: SITE_BRAND.contactEmail, contactType: 'editorial' },
  ...(SOCIAL_SAME_AS.length ? { sameAs: SOCIAL_SAME_AS } : {}),
};
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE_URL}/#website`,
  name: SITE_NAME,
  url: `${SITE_URL}/`,
  publisher: { '@id': `${SITE_URL}/#organization` },
  inLanguage: LIVE_LANGS.length > 1 ? LIVE_LANGS : 'en',
};
const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': canonicalUrl,
  url: canonicalUrl,
  name: title,
  description,
  isPartOf: { '@id': `${SITE_URL}/#website` },
  dateModified: CHECKED_ISO,
  inLanguage: lang,
};
const allCrumbs = crumbs.length ? crumbs : langPath === '/' ? [] : [{ name: t(lang, 'common.home'), url: L('/') }, { name: title.split(/[:|–-]/)[0].trim(), url: path }];
const breadcrumbSchema = allCrumbs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: allCrumbs.map((b, i) => ({ '@type': 'ListItem', position: i + 1, name: b.name, item: new URL(b.url, SITE_URL).toString() })),
    }
  : null;
const extra = (Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : []).map((s) => ('inLanguage' in s || s['@type'] === 'Organization' ? s : { ...s, inLanguage: lang }));
const schemas = [orgSchema, websiteSchema, webPageSchema, ...(breadcrumbSchema ? [breadcrumbSchema] : []), ...extra];

const nav = [
  { href: '/prices/', label: t(lang, 'nav.prices'), icon: 'bar-h' },
  { href: '/vendors/', label: t(lang, 'nav.shops'), icon: 'building' },
  { href: '/batch-tracker/', label: t(lang, 'nav.reports'), icon: 'file-text' },
  { href: '/compounds/', label: t(lang, 'nav.compounds'), icon: 'beaker' },
  { href: '/methodology/', label: t(lang, 'nav.method'), icon: 'microscope' },
];
const current = langPath;
const showSwitch = translated && LIVE_LANGS.length > 1;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="impact-site-verification" value="9a4d3bdd-10ed-4e2f-a60b-8d61db5f0a63" content="9a4d3bdd-10ed-4e2f-a60b-8d61db5f0a63" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    {alternates.length > 1 && alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    {alternates.length > 1 && <link rel="alternate" hreflang="x-default" href={alternates[0].href} />}
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-snippet:-1, max-image-preview:large'} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    {alternates.filter((a) => a.lang !== lang).map((a) => <meta property="og:locale:alternate" content={OG_LOCALE[a.lang]} />)}
    <meta property="article:modified_time" content={CHECKED_ISO} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="alternate" type="text/plain" title="llms.txt" href="/llms.txt" />
    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
    <!-- Privacy-friendly analytics by Plausible -->
    <script is:inline async src="https://analytics.polymarkt.de/js/pa-gLRgumVP7qfI1CLz6JJes.js"></script>
    <script is:inline>
      window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
      plausible.init()
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-white font-sans text-slate-700 antialiased" data-copied={t(lang, 'layout.copied')}>
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-[60] focus:bg-white focus:px-3 focus:py-2 focus:rounded-lg">{t(lang, 'layout.skip')}</a>

    <div class="bg-slate-900 text-slate-100 text-sm py-2 px-4 text-center leading-snug no-print">
      {t(lang, 'layout.topPre')} <strong class="text-white font-semibold">{date}</strong>. {t(lang, 'layout.topPost')}
      <a href={L('/methodology/')} class="tap ml-1 underline underline-offset-2 text-teal-200 hover:text-white">{t(lang, 'layout.howWeScore')}</a>
    </div>

    <header class="sticky top-0 z-50 bg-white/90 backdrop-blur-xl border-b border-slate-200/80">
      <div class="wrap h-16 flex items-center justify-between gap-3">
        <a href={L('/')} class="flex items-center gap-2.5 shrink-0 group min-h-[44px]" aria-label={t(lang, 'layout.homeAria', { site: SITE_NAME })}>
          <span class="w-9 h-9 rounded-xl bg-gradient-to-br from-teal-600 to-emerald-700 flex items-center justify-center shadow-sm">
            <svg viewBox="0 0 24 24" class="w-5 h-5 text-white" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9.5 2.5h5M10 2.5v6L4.6 18.4A2 2 0 0 0 6.4 21.5h11.2a2 2 0 0 0 1.8-3.1L14 8.5v-6" /><path d="M7.2 14.5h9.6" /></svg>
          </span>
          <span class="leading-tight">
            <span class="block font-extrabold text-[15px] sm:text-lg tracking-tight text-slate-900">Peptide<span class="text-teal-700">Lab</span>Index</span>
            <span class="hidden sm:block text-xs text-slate-600">{t(lang, 'layout.tagline')}</span>
          </span>
        </a>
        <nav class="hidden xl:flex items-center gap-1 text-[0.94rem] font-medium text-slate-700" aria-label={t(lang, 'layout.mainNav')}>
          {nav.map((n) => (
            <a href={L(n.href)} class={`px-3 py-2 rounded-lg transition-colors hover:bg-teal-50 hover:text-teal-800 ${current.startsWith(n.href) ? 'text-teal-800 bg-teal-50' : ''}`}>{n.label}</a>
          ))}
        </nav>
        <div class="flex items-center gap-2">
          {showSwitch && (
            <details class="relative lang-switch">
              <summary class="inline-flex items-center gap-1 min-h-[44px] px-3 rounded-xl border border-slate-200 text-sm font-semibold text-slate-800 cursor-pointer" aria-label={t(lang, 'layout.language')}>
                <Icon name="globe" class="w-4 h-4 text-teal-700" />{LANG_LABEL[lang]}
              </summary>
              <ul class="absolute right-0 mt-2 w-44 rounded-xl border border-slate-200 bg-white shadow-lg py-1 z-50">
                {alternates.map((a) => (
                  <li>
                    {a.lang === lang
                      ? <span class="flex items-center justify-between px-3 min-h-[44px] font-bold text-slate-900" aria-current="true">{LANG_NAME[a.lang]} <span class="text-sm text-slate-600">{LANG_LABEL[a.lang]}</span></span>
                      : <a href={lp(a.lang, langPath)} hreflang={a.lang} lang={a.lang} class="flex items-center justify-between px-3 min-h-[44px] text-slate-800 hover:bg-teal-50">{LANG_NAME[a.lang]} <span class="text-sm text-slate-600">{LANG_LABEL[a.lang]}</span></a>}
                  </li>
                ))}
              </ul>
            </details>
          )}
          <a href={L('/vendors/')} class="hidden md:inline-flex btn-primary">{t(lang, 'layout.cta')}</a>
          <button id="nav-toggle" type="button" class="xl:hidden inline-flex items-center justify-center w-11 h-11 rounded-xl border border-slate-200 text-slate-700" aria-label={t(lang, 'layout.openMenu')} aria-expanded="false" aria-controls="nav-panel">
            <Icon name="menu" class="w-5 h-5" />
          </button>
        </div>
      </div>
      <div id="nav-panel" class="hidden xl:hidden border-t border-slate-200 bg-white px-4 py-3 shadow-lg">
        {nav.map((n) => (
          <a href={L(n.href)} class="flex items-center gap-2.5 px-3 py-2.5 rounded-xl text-base font-medium text-slate-800 hover:bg-teal-50"><Icon name={n.icon} class="w-4 h-4 text-teal-700" />{n.label}</a>
        ))}
        <a href={L('/labs/')} class="flex items-center gap-2.5 px-3 py-2.5 rounded-xl text-base font-medium text-slate-800 hover:bg-teal-50"><Icon name="flask" class="w-4 h-4 text-teal-700" />{t(lang, 'footer.labs')}</a>
        <a href={L('/compare/')} class="flex items-center gap-2.5 px-3 py-2.5 rounded-xl text-base font-medium text-slate-800 hover:bg-teal-50"><Icon name="git-compare" class="w-4 h-4 text-teal-700" />{t(lang, 'footer.compareCompounds')}</a>
      </div>
    </header>

    <main id="main" class="flex-grow">
      <slot />
    </main>

    <div id="copy-toast" class="fixed bottom-6 right-6 z-50 hidden items-center gap-2 px-4 py-3 rounded-xl bg-slate-900 text-white text-sm font-semibold shadow-2xl" role="status" aria-live="polite"></div>

    <SiteFooter lang={lang} path={langPath} langsLive={showSwitch} />

    <script>
      const btn = document.getElementById('nav-toggle');
      const panel = document.getElementById('nav-panel');
      btn?.addEventListener('click', () => {
        const open = panel?.classList.toggle('hidden') === false;
        btn.setAttribute('aria-expanded', String(open));
      });
      document.addEventListener('click', (e) => {
        const sw = document.querySelector<HTMLDetailsElement>('details.lang-switch');
        if (sw?.open && !sw.contains(e.target as Node)) sw.open = false;
      });

      const toast = document.getElementById('copy-toast');
      const copied = document.body.dataset.copied || 'Copied';
      document.addEventListener('click', (e) => {
        const el = (e.target as HTMLElement)?.closest('[data-copy],[data-copy-code]') as HTMLElement | null;
        if (!el) return;
        const code = el.getAttribute('data-copy') || el.getAttribute('data-copy-code');
        if (!code) return;
        navigator.clipboard?.writeText(code);
        if (toast) {
          toast.textContent = `${copied}: "${code}"`;
          toast.classList.remove('hidden');
          toast.classList.add('flex');
          setTimeout(() => { toast.classList.add('hidden'); toast.classList.remove('flex'); }, 2200);
        }
      });

      // Small vanilla table sort: <table data-sortable>, buttons .sort-btn in <th>, cells may carry data-v.
      document.querySelectorAll<HTMLTableElement>('table[data-sortable]').forEach((table) => {
        const ths = Array.from(table.querySelectorAll('thead th'));
        ths.forEach((th, idx) => {
          const b = th.querySelector<HTMLButtonElement>('.sort-btn');
          if (!b) return;
          let asc = true;
          b.addEventListener('click', () => {
            const tbody = table.tBodies[0];
            const rows = Array.from(tbody.rows);
            const num = b.dataset.sortType === 'num';
            const val = (r: HTMLTableRowElement) => {
              const c = r.cells[idx];
              const raw = c?.dataset.v ?? c?.textContent?.trim() ?? '';
              if (!num) return raw.toLowerCase();
              const n = parseFloat(raw);
              return Number.isFinite(n) ? n : asc ? Infinity : -Infinity;
            };
            rows.sort((a, z) => {
              const x = val(a), y = val(z);
              if (x < y) return asc ? -1 : 1;
              if (x > y) return asc ? 1 : -1;
              return 0;
            });
            rows.forEach((r) => tbody.appendChild(r));
            ths.forEach((t) => t.removeAttribute('aria-sort'));
            th.setAttribute('aria-sort', asc ? 'ascending' : 'descending');
            asc = !asc;
          });
        });
      });
    </script>
  </body>
</html>
