---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import Icon from '../components/Icon.astro';
import { RESEARCH_ARTICLES } from '../data/labs';
import { BATCH_RECORDS } from '../data/batches';
import { VENDORS } from '../data/vendors';
import { LABS_IN_DATA, reportsByLab, TOTALS, CHECKED_ISO, SITE_URL, abs, compoundShort } from '../lib/site';
import { getLabGuide } from '../data/labGuides';
import { t, tn, lp, fmtDate, type Lang } from '../i18n';
import { locArticle, locLabGuide } from '../i18n/data';
interface Props { lang: Lang; slug: string }
const { lang, slug } = Astro.props;
const L = (p: string) => lp(lang, p);
const a = locArticle(lang, RESEARCH_ARTICLES.find((x) => x.slug === slug)!);
const crumbs = [{ name: t(lang, 'common.home'), url: L('/') }, { name: t(lang, 'ri.crumb'), url: L('/research/') }, { name: a.h1, url: L(`/research/${a.slug}/`) }];
const fills = BATCH_RECORDS.map((r) => ({ r, f: (100 * r.measuredMg) / r.labelMg }));
const highPurityOff = fills.filter((x) => x.r.purityPercent >= 99 && (x.f < 90 || x.f > 110));
const highPurity = fills.filter((x) => x.r.purityPercent >= 99);
const codeNames = ['retatrutide', 'tirzepatide'].map((c) => ({ c, rows: VENDORS.flatMap((v) => v.products.filter((p) => p.compound === c).map((p) => ({ v, name: p.shopProductName }))) }));
const date = fmtDate(lang, CHECKED_ISO);
const article = {
  '@context': 'https://schema.org', '@type': 'Article', headline: a.h1, description: a.excerpt, datePublished: a.publishedDate, dateModified: a.publishedDate, inLanguage: lang,
  author: { '@type': 'Organization', name: 'PeptideLabIndex Editorial' }, publisher: { '@id': `${SITE_URL}/#organization` }, mainEntityOfPage: abs(L(`/research/${a.slug}/`)),
};
const desc = a.excerpt.length <= 155 ? a.excerpt : `${a.excerpt.slice(0, 150).replace(/\s+\S*$/, '')} …`;
const title = a.title.length <= 60 ? a.title : a.h1.slice(0, 60);
---
<BaseLayout lang={lang} title={title} description={desc} crumbs={crumbs} jsonLd={article} ogType="article">
  <PageHero crumbs={crumbs} title={a.h1} eyebrow={a.category} intro={a.excerpt} />
  <div class="wrap mt-12 space-y-12">
    <aside class="rounded-2xl border border-teal-200 bg-teal-50/60 p-5 sm:p-6 max-w-3xl">
      <h2 class="h3">{t(lang, 'r.keyPoints')}</h2>
      <ul class="mt-3 space-y-2">
        {a.keyPoints.map((k) => <li class="flex gap-2 text-slate-800"><Icon name="check" class="w-5 h-5 mt-0.5 text-teal-800" />{k}</li>)}
      </ul>
    </aside>
    <article class="prose-read">
      {a.sections.map((s) => (<><h2>{s.heading}</h2>{s.body.map((p) => <p>{p}</p>)}</>))}

      {a.data === 'verify' && (
        <>
          <h2>{t(lang, 'r.whereH')}</h2>
          <ul>
            {LABS_IN_DATA.map((l) => <li><a href={L(`/labs/${l.slug}/`)}>{l.name}</a>: {locLabGuide(lang, getLabGuide(l.slug))?.verifyWhere || t(lang, 'r.noLookup')} ({tn(lang, 'common.reportsOpened', reportsByLab(l.slug).length)})</li>)}
          </ul>
          <p>{t(lang, 'r.verifyP', { date, portal: TOTALS.portalVerified, reports: TOTALS.reportsOpened })}</p>
        </>
      )}
      {a.data === 'purity-vs-fill' && (
        <>
          <h2>{t(lang, 'r.foundH')}</h2>
          <p>{t(lang, 'r.foundP', { n: BATCH_RECORDS.length, hp: highPurity.length, off: highPurityOff.length })}</p>
          <p>{t(lang, 'r.allListed')} <a href={L('/batch-tracker/')}>{t(lang, 'footer.reportsOpened')}</a>.</p>
        </>
      )}
      {a.data === 'code-names' && codeNames.map((g) => (
        <>
          <h2>{t(lang, 'r.namesH', { c: compoundShort(g.c), n: g.rows.length })}</h2>
          <ul>{g.rows.map((r) => <li><a href={L(`/vendors/${r.v.slug}/`)}>{r.v.name}</a>: {r.name}</li>)}</ul>
        </>
      ))}
      {a.data === 'peptide-sciences' && <p><a href={L('/vendors/peptide-sciences/')}>{t(lang, 'r.psLink')}</a>.</p>}
    </article>
    <p class="text-sm text-slate-600">{t(lang, 'r.published', { pub: fmtDate(lang, a.publishedDate), date })}</p>
    <RelatedLinks links={[
      ...RESEARCH_ARTICLES.filter((x) => x.slug !== a.slug).map((x) => locArticle(lang, x)).map((x) => ({ href: L(`/research/${x.slug}/`), label: x.h1, sub: x.category })),
      { href: L('/batch-tracker/'), label: t(lang, 'footer.reportsOpened') },
      { href: L('/labs/'), label: t(lang, 'footer.labs') },
    ]} />
  </div>
</BaseLayout>
