---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { DATASET, DATASET_COLUMNS, DATASET_REVIEW_COVERAGE } from '../lib/dataset';
import { SITE_URL, SITE_NAME } from '../lib/site';
import { t, tt, td, tlist, lp, fmtDateRange, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const L = (p: string) => lp(lang, p);
const crumbs = [{ name: t(lang, 'common.home'), url: L('/') }, { name: t(lang, 'data.crumb'), url: L('/data/') }];
const coverage = DATASET_REVIEW_COVERAGE;
const date = coverage ? fmtDateRange(lang, coverage.earliest, coverage.latest) : t(lang, 'common.notPublished');
const V = { n: DATASET.length, shops: new Set(DATASET.map((r) => r.shopSlug)).size, date, site: SITE_NAME, url: `${SITE_URL}/data/` };
const dataset = {
  '@context': 'https://schema.org', '@type': 'Dataset', name: 'Research peptide shop audit 2026 (prices, lab reports, scores)',
  description: td(lang, 'data.description', V),
  url: `${SITE_URL}/data/`, creator: { '@type': 'Organization', name: SITE_NAME, url: `${SITE_URL}/` },
  ...(coverage ? { temporalCoverage: `${coverage.earliest}/${coverage.latest}` } : {}),
  license: 'https://creativecommons.org/licenses/by/4.0/', isAccessibleForFree: true, keywords: ['research peptides', 'price per mg', 'lab reports', 'COA'],
  variableMeasured: DATASET_COLUMNS, inLanguage: 'en',
  distribution: [
    { '@type': 'DataDownload', encodingFormat: 'text/csv', contentUrl: `${SITE_URL}/data/peptide-shop-audit-2026.csv` },
    { '@type': 'DataDownload', encodingFormat: 'application/json', contentUrl: `${SITE_URL}/data/peptide-shop-audit-2026.json` },
  ],
};
---
<BaseLayout lang={lang} title={tt(lang, 'data.title', V)} description={td(lang, 'data.description', V)} crumbs={crumbs} jsonLd={dataset} checkedAt={coverage?.latest}>
  <PageHero crumbs={crumbs} title={t(lang, 'data.h1')} intro={t(lang, 'data.intro', V)} checked={null}>
    <div class="mt-6 flex flex-wrap gap-3">
      <a href="/data/peptide-shop-audit-2026.csv" class="btn-primary"><Icon name="download" class="w-4 h-4" />{t(lang, 'data.csv')}</a>
      <a href="/data/peptide-shop-audit-2026.json" class="btn-ghost"><Icon name="download" class="w-4 h-4" />{t(lang, 'data.json')}</a>
    </div>
    {lang !== 'en' && <p class="mt-3 text-sm text-slate-600">{t(lang, 'data.englishNote')}</p>}
  </PageHero>
  <div class="wrap mt-12 space-y-10">
    <section class="space-y-4">
      <h2 class="h2">{t(lang, 'data.colsH')}</h2>
      <div class="table-wrap">
        <table class="data-table">
          <thead><tr><th scope="col">{t(lang, 'data.colCol')}</th><th scope="col">{t(lang, 'data.colMeaning')}</th></tr></thead>
          <tbody>{DATASET_COLUMNS.map((c) => <tr><td><code class="font-mono text-sm text-slate-900">{c}</code></td><td>{t(lang, `data.col.${c as string}`)}</td></tr>)}</tbody>
        </table>
      </div>
    </section>
    <section class="prose-read">
      <h2>{t(lang, 'data.notesH')}</h2>
      <ul>
        {tlist(lang, 'data.notes', V).map((x) => <li>{x}</li>)}
        <li>{t(lang, 'data.notesReports')} <a href={L('/batch-tracker/')}>{t(lang, 'footer.reportsOpened')}</a>.</li>
      </ul>
    </section>
  </div>
</BaseLayout>
