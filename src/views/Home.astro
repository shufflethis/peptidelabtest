---
import { compoundExtras, hubs, uniqRel } from '../lib/links';
import RelatedLinks from '../components/RelatedLinks.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import ShopCard from '../components/ShopCard.astro';
import TrustStrip from '../components/TrustStrip.astro';
import FAQ from '../components/FAQ.astro';
import VerifyChart from '../components/VerifyChart.astro';
import VideoBlock from '../components/VideoBlock.astro';
import { videoSchema, abs } from '../lib/video';
import { verifyByLab } from '../lib/charts';
import Disclosure from '../components/Disclosure.astro';
import {
  PARTNERS, NON_PARTNERS, partnersIn, PRICE_COMPOUNDS, compoundShort, shopsCarrying, TOTALS, CHECKED_ISO, YEAR,
  itemListSchema, faqSchema, COMPOUND_PAIRS, pairSlug, LABS_IN_DATA, reportsByLab, SIZE_PAGES, offersFor, cheapestBy,
} from '../lib/site';
import { t, tn, tt, td, tfaq, lp, fmtDate, type Lang } from '../i18n';
import { fmt } from '../i18n/format';
import { locVendor } from '../i18n/data';
interface Props { lang: Lang }
const { lang } = Astro.props;
const F = fmt(lang);
const L = (p: string) => lp(lang, p);
const date = fmtDate(lang, CHECKED_ISO);
const V = { shops: TOTALS.shops, reports: TOTALS.reportsOpened, portal: TOTALS.portalVerified, products: TOTALS.products, withReports: TOTALS.shopsWithReports, date, year: YEAR };

const picker = PRICE_COMPOUNDS.map((c) => ({ slug: c, name: compoundShort(c), shops: shopsCarrying(c).length })).sort((a, b) => b.shops - a.shops);
const euPartners = partnersIn('EU');
const usPartners = partnersIn('US');

const title = tt(lang, 'home.title', V);
const h1 = t(lang, 'home.h1', V);
const description = td(lang, 'home.description', V);
const intro = t(lang, 'home.intro', V);
const topPairs = COMPOUND_PAIRS.slice(0, 4);
const popularSizes = [...SIZE_PAGES].sort((a, b) => b.shops - a.shops).slice(0, 6);
const steps = [
  { icon: 'file-text', k: 's1' },
  { icon: 'shield-check', k: 's2' },
  { icon: 'ruler', k: 's3' },
  { icon: 'tag', k: 's4' },
];
const faqs = tfaq(lang, 'home.faqs', V);
const jsonLd = [
  itemListSchema(t(lang, 'home.itemList'), PARTNERS.map((p) => ({ name: p.name, url: L(`/vendors/${p.slug}/`) }))),
  faqSchema(faqs),
  videoSchema(lang, abs(L('/'))),
];
---

<BaseLayout lang={lang} title={title} description={description} jsonLd={jsonLd}>
  <section class="hero-bg border-b border-slate-200">
    <div class="wrap pt-10 pb-12 sm:pt-14 sm:pb-16">
      <span class="eyebrow"><Icon name="shield-check" class="w-4 h-4" />{t(lang, 'home.eyebrow', { date })}</span>
      <h1 class="h1 mt-5 max-w-3xl">{h1}</h1>
      <p class="lead mt-5" data-answer>{intro}</p>

      <div class="mt-8 card p-5 sm:p-6 max-w-5xl">
        <h2 class="h3">{t(lang, 'home.pickerH')}</h2>
        <p class="mt-1 text-slate-700">{t(lang, 'home.pickerP')}</p>
        <ul class="mt-4 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-2.5">
          {picker.map((c) => (
            <li>
              <a href={L(`/prices/${c.slug}/`)} class="block min-h-[48px] rounded-xl border border-slate-300 bg-white px-3.5 py-2 hover:border-teal-600 hover:bg-teal-50">
                <span class="block font-semibold text-slate-900 leading-snug">{c.name}</span>
                <span class="block text-sm text-slate-600 tabular-nums">{tn(lang, 'common.shops', c.shops)}</span>
              </a>
            </li>
          ))}
        </ul>
        <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-3">
          <a href={L('/prices/')} class="btn-primary">{t(lang, 'home.allPrices')} <Icon name="arrow-right" class="w-4 h-4" /></a>
          <a href={L('/vendors/')} class="text-link">{t(lang, 'home.fullRanking')}</a>
        </div>
      </div>
    </div>
  </section>

  <div class="wrap mt-10">
    <TrustStrip />
  </div>

  <div class="wrap mt-16 space-y-20">
    <section id="best-shops" class="space-y-8">
      <div class="max-w-[70ch]">
        <h2 class="h2">{t(lang, 'home.bestH')}</h2>
        <p class="mt-3 text-slate-700">{t(lang, 'home.bestP')}</p>
      </div>
      <div class="space-y-4">
        <h3 class="h3 flex items-center gap-2"><Icon name="euro" class="w-5 h-5 text-teal-800" />{t(lang, 'c.euShops')}</h3>
        <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          {euPartners.map((v, i) => <ShopCard vendor={v} rank={i + 1} />)}
        </div>
      </div>
      <div class="space-y-4">
        <h3 class="h3 flex items-center gap-2"><Icon name="dollar" class="w-5 h-5 text-teal-800" />{t(lang, 'c.usShops')}</h3>
        <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          {usPartners.map((v, i) => <ShopCard vendor={v} rank={i + 1} />)}
        </div>
      </div>
    </section>

    <section id="how-we-test" class="space-y-6">
      <div class="max-w-[70ch]">
        <h2 class="h2">{t(lang, 'home.howH')}</h2>
        <p class="mt-3 text-slate-700">{t(lang, 'home.howP', { date })}</p>
      </div>
      <ol class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {steps.map((s, i) => (
          <li class="card p-5">
            <div class="flex items-center gap-3">
              <span class="w-10 h-10 rounded-xl bg-teal-50 text-teal-800 flex items-center justify-center"><Icon name={s.icon} class="w-5 h-5" /></span>
              <span class="text-sm font-semibold text-slate-600">{t(lang, 'home.step', { n: i + 1 })}</span>
            </div>
            <h3 class="mt-3 font-bold text-slate-900 text-lg leading-snug">{t(lang, `home.${s.k}t`)}</h3>
            <p class="mt-1.5 text-slate-700">{t(lang, `home.${s.k}p`)}</p>
          </li>
        ))}
      </ol>
      <a href={L('/methodology/')} class="text-link inline-flex items-center gap-1 min-h-[44px]">{t(lang, 'home.readMethod')} <Icon name="arrow-right" class="w-4 h-4" /></a>
    </section>

    {/* M5chart */}
    <section id="data" class="space-y-6">
      <div class="max-w-[70ch]">
        <h2 class="h2">{t(lang, 'm5.homeDataH')}</h2>
        <p class="mt-3 text-slate-700">{t(lang, 'm5.homeDataP', V)}</p>
      </div>
      <div class="grid gap-8 xl:grid-cols-2 xl:items-start">
        <VideoBlock />
        <VerifyChart rows={verifyByLab(L)} title={t(lang, 'm5.verifyTitleLab')} />
      </div>
    </section>

    <section id="other-shops" class="space-y-5">
      <div class="max-w-[70ch]">
        <h2 class="h2">{t(lang, 'c.rk.otherTitle')}</h2>
        <p class="mt-3 text-slate-700">{t(lang, 'home.otherP')}</p>
      </div>
      <div class="table-wrap">
        <table class="data-table">
          <thead>
            <tr>
              <th scope="col">{t(lang, 'c.pt.shop')}</th>
              <th scope="col">{t(lang, 'common.region')}</th>
              <th scope="col" class="num">{t(lang, 'c.pt.score')}</th>
              <th scope="col" class="num">{t(lang, 'c.rk.portalCol')}</th>
              <th scope="col">{t(lang, 'c.rk.verdict')}</th>
            </tr>
          </thead>
          <tbody>
            {NON_PARTNERS.map((raw) => {
              const v = locVendor(lang, raw);
              return (
                <tr>
                  <td class="min-w-[10rem]"><a href={L(`/vendors/${v.slug}/`)} class="font-semibold text-slate-900 hover:text-teal-800 hover:underline">{v.name}</a><span class="sub">{t(lang, 'c.readReview')}</span></td>
                  <td>{v.region}</td>
                  <td class="num font-semibold">{F.score(v.overallScore)}</td>
                  <td class="num">{v.coaStats.opened ? t(lang, 'c.xOfY', { x: v.coaStats.portalVerified, y: v.coaStats.opened }) : t(lang, 'c.nonePublished')}</td>
                  <td class="min-w-[18rem] max-w-[34rem]">{v.verdictSummary}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </section>

    <section class="grid gap-6 lg:grid-cols-3">
      <div class="card p-5 sm:p-6">
        <h2 class="h3 flex items-center gap-2"><Icon name="bar-h" class="w-5 h-5 text-teal-800" />{t(lang, 'home.sizesH')}</h2>
        <ul class="mt-3 divide-y divide-slate-200">
          {popularSizes.map((s) => {
            const o = offersFor(s.compound, s.size);
            const e = cheapestBy(o, 'EUR');
            const u = cheapestBy(o, 'USD');
            const from = [e && F.perMg(e.perMg, 'EUR'), u && F.perMg(u.perMg, 'USD')].filter(Boolean).join(` ${t(lang, 'common.or')} `) || F.na;
            return (
              <li class="py-2.5">
                <a href={L(`/prices/${s.compound}/${s.size}mg/`)} class="font-semibold text-slate-900 hover:text-teal-800 hover:underline">{compoundShort(s.compound)} {F.mg(s.size)}</a>
                <span class="block text-sm text-slate-600">{tn(lang, 'common.shops', s.shops)} · {t(lang, 'common.from', { p: from })}</span>
              </li>
            );
          })}
        </ul>
        <a href={L('/prices/')} class="mt-3 inline-flex items-center min-h-[44px] text-link">{t(lang, 'home.allSizes')}</a>
      </div>
      <div class="card p-5 sm:p-6">
        <h2 class="h3 flex items-center gap-2"><Icon name="git-compare" class="w-5 h-5 text-teal-800" />{t(lang, 'footer.compareCompounds')}</h2>
        <ul class="mt-3 divide-y divide-slate-200">
          {topPairs.map(([a, b]) => (
            <li class="py-2.5"><a href={L(`/compare/${pairSlug(a, b)}/`)} class="font-semibold text-slate-900 hover:text-teal-800 hover:underline">{compoundShort(a)} vs {compoundShort(b)}</a><span class="block text-sm text-slate-600">{t(lang, 'home.pairSub')}</span></li>
          ))}
        </ul>
        <a href={L('/compare/')} class="mt-3 inline-flex items-center min-h-[44px] text-link">{t(lang, 'home.allPairs')}</a>
      </div>
      <div class="card p-5 sm:p-6">
        <h2 class="h3 flex items-center gap-2"><Icon name="flask" class="w-5 h-5 text-teal-800" />{t(lang, 'footer.labs')}</h2>
        <ul class="mt-3 divide-y divide-slate-200">
          {LABS_IN_DATA.slice(0, 6).map((l) => (
            <li class="py-2.5"><a href={L(`/labs/${l.slug}/`)} class="font-semibold text-slate-900 hover:text-teal-800 hover:underline">{l.name}</a><span class="block text-sm text-slate-600">{tn(lang, 'common.reportsOpened', reportsByLab(l.slug).length)}</span></li>
          ))}
        </ul>
        <a href={L('/labs/')} class="mt-3 inline-flex items-center min-h-[44px] text-link">{t(lang, 'home.allLabs')}</a>
      </div>
    </section>

    <RelatedLinks links={hubs(lang, ['priceIndex', 'blends', 'compare', 'codeNames', 'calculator', 'shopPairs'])} />
    <FAQ items={faqs} />
    <Disclosure />
  </div>
</BaseLayout>
