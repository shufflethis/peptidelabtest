---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { SITE_BRAND } from '../data/affiliates';
import { TOTALS } from '../lib/site';
import { t, tt, td, tlist, lp, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const L = (p: string) => lp(lang, p);
const V = { site: SITE_BRAND.name, shops: TOTALS.shops };
const crumbs = [{ name: t(lang, 'common.home'), url: L('/') }, { name: t(lang, 'footer.forShops'), url: L('/advertise/') }];
---
<BaseLayout lang={lang} title={tt(lang, 'adv.title', V)} description={td(lang, 'adv.description', V)} crumbs={crumbs}>
  <PageHero crumbs={crumbs} title={t(lang, 'adv.h1')} intro={t(lang, 'adv.intro', V)} />
  <div class="wrap mt-12">
    <div class="prose-read">
      <h2>{t(lang, 'adv.sendH')}</h2>
      <p>{t(lang, 'adv.sendP')}</p>
      <h2>{t(lang, 'adv.progH')}</h2>
      <ul>{tlist(lang, 'adv.prog').map((x) => <li>{x}</li>)}</ul>
      <h2>{t(lang, 'footer.contact')}</h2>
      <p><a href={`mailto:${SITE_BRAND.contactEmail}`}>{SITE_BRAND.contactEmail}</a> · <a href={L('/contact/')}>{t(lang, 'footer.contact')}</a></p>
    </div>
  </div>
</BaseLayout>
