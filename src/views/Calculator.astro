---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ConcentrationCalculator from '../components/ConcentrationCalculator.astro';
import FAQ from '../components/FAQ.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import { faqSchema, CALC_COMPOUNDS, compoundShort, sizeCounts } from '../lib/site';
import { t, tt, td, tfaq, lp, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const L = (p: string) => lp(lang, p);
const faqs = tfaq(lang, 'calcp.faqs');
const crumbs = [{ name: t(lang, 'common.home'), url: L('/') }, { name: t(lang, 'calcp.crumb'), url: L('/calculator/') }];
---
<BaseLayout lang={lang} title={tt(lang, 'calcp.title')} description={td(lang, 'calcp.description')} crumbs={crumbs} jsonLd={faqSchema(faqs)}>
  <PageHero crumbs={crumbs} title={t(lang, 'calcp.h1')} intro={t(lang, 'calcp.intro')} />
  <div class="wrap mt-10 space-y-14">
    <ConcentrationCalculator />
    <section class="space-y-3">
      <h2 class="h2">{t(lang, 'calcp.byH')}</h2>
      <p class="text-slate-700 max-w-[70ch]">{t(lang, 'calcp.byP')}</p>
      <RelatedLinks title=" " links={CALC_COMPOUNDS.map((c) => ({ href: L(`/calculator/${c}/`), label: t(lang, 'cc.relCalc', { c: compoundShort(c) }), sub: t(lang, 'calcp.sizes', { n: sizeCounts(c).length }) }))} />
    </section>
    <FAQ items={faqs} />
  </div>
</BaseLayout>
