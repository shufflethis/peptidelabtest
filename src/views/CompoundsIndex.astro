---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { COMPOUNDS } from '../data/compounds';
import { compoundShort, shopsCarrying, reportsFor, sizesFor, CHECKED_ISO, TOTALS, itemListSchema } from '../lib/site';
import { t, tn, tt, td, lp, fmtDate, type Lang } from '../i18n';
import { locCompound } from '../i18n/data';
interface Props { lang: Lang }
const { lang } = Astro.props;
const L = (p: string) => lp(lang, p);
const rows = COMPOUNDS.map((raw) => { const c = locCompound(lang, raw); return { c, short: compoundShort(c.slug), shops: shopsCarrying(c.slug).length, reports: reportsFor(c.slug).length, sizes: sizesFor(c.slug) }; });
const cats = Array.from(new Set(rows.map((r) => r.c.category)));
const crumbs = [{ name: t(lang, 'common.home'), url: L('/') }, { name: t(lang, 'nav.compounds'), url: L('/compounds/') }];
const V = { n: COMPOUNDS.length, shops: TOTALS.shops, date: fmtDate(lang, CHECKED_ISO) };
---
<BaseLayout lang={lang} title={tt(lang, 'cx.title', V)} description={td(lang, 'cx.description', V)} crumbs={crumbs} jsonLd={itemListSchema(t(lang, 'cx.itemList'), rows.map((r) => ({ name: r.short, url: L(`/compounds/${r.c.slug}/`) })))}>
  <PageHero crumbs={crumbs} title={t(lang, 'cx.h1')} intro={t(lang, 'cx.intro', V)} />
  <div class="wrap mt-12 space-y-12">
    {cats.map((cat) => (
      <section class="space-y-4">
        <h2 class="h2">{cat}</h2>
        <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {rows.filter((r) => r.c.category === cat).map((r) => (
            <li class="card card-hover p-5 flex flex-col">
              <a href={L(`/compounds/${r.c.slug}/`)} class="tap text-lg font-bold text-slate-900 hover:text-teal-800 hover:underline">{r.c.name}</a>
              <p class="mt-1.5 text-[0.95rem] text-slate-700">{r.c.formulaOrClass}</p>
              <p class="mt-3 text-sm text-slate-600">{tn(lang, 'common.shops', r.shops)} · {tn(lang, 'pc.vialSizes', r.sizes.length)} · {tn(lang, 'cx.reportsOpened', r.reports)}</p>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</BaseLayout>
