---
import BaseLayout from '../../layouts/BaseLayout.astro';
import VendorCard from '../../components/VendorCard.astro';
import { COUNTRY_LAWS, type CountryLawGuide } from '../../data/laws';
import { getVendorBySlug } from '../../data/vendors';

export function getStaticPaths() {
  return COUNTRY_LAWS.map((law) => ({
    params: { slug: law.slug },
    props: { law },
  }));
}

interface Props {
  law: CountryLawGuide;
}

const { law } = Astro.props;
const recVendors = law.recommendedVendorSlugs
  .map((s) => getVendorBySlug(s))
  .filter((v): v is NonNullable<typeof v> => Boolean(v));
---

<BaseLayout
  title={`Are Research Peptides Legal in ${law.country}? (2026 RUO & Customs Guide)`}
  description={`2026 research peptide customs & RUO regulatory guide for ${law.country} (${law.regulatoryBodies.join(', ')}): border risk & domestic shipping options.`}
>
  <article class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pt-12 space-y-10">
    <nav class="text-xs font-mono text-slate-400">
      <a href="/" class="hover:text-cyan-400">Home</a> / <a href="/laws/" class="hover:text-cyan-400">Laws &amp; Customs</a> / <span class="text-slate-200">{law.country}</span>
    </nav>

    <div class="glass-card rounded-2xl p-6 sm:p-8 space-y-5">
      <div class="flex flex-wrap items-center gap-2 font-mono text-xs">
        <span class="px-2.5 py-0.5 rounded bg-cyan-500/15 text-cyan-300 border border-cyan-500/30">{law.customsRisk}</span>
        <span class="px-2.5 py-0.5 rounded bg-slate-900 text-slate-300 border border-slate-800">Authorities: {law.regulatoryBodies.join(' · ')}</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-black text-white">
        {law.flag} Research Peptide Status &amp; Customs Routing: {law.country}
      </h1>
      <p class="text-base text-slate-200 leading-relaxed">{law.ruoStatusSummary}</p>

      <div class="p-4 rounded-xl bg-emerald-950/30 border border-emerald-500/30 text-sm text-slate-200">
        <strong class="text-emerald-300 font-mono">📦 Optimal Fulfillment Routing:</strong> {law.shippingRecommendation}
      </div>

      <div class="space-y-2 pt-2">
        <h2 class="text-lg font-extrabold text-white">Key Compliance &amp; Border Takeaways</h2>
        <ul class="space-y-2 text-sm text-slate-300">
          {law.keyTakeaways.map((item) => (
            <li class="flex gap-2"><span class="text-cyan-400 font-bold">•</span><span>{item}</span></li>
          ))}
        </ul>
      </div>
    </div>

    <div class="space-y-4">
      <h2 class="text-2xl font-black text-white">Lowest-Friction Lab-Verified Suppliers for {law.country}</h2>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        {recVendors.map((v) => (
          <VendorCard vendor={v} />
        ))}
      </div>
    </div>
  </article>
</BaseLayout>
