---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import FillChart from '../../components/FillChart.astro';
import PriceBars from '../../components/PriceBars.astro';
import FAQ from '../../components/FAQ.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import Icon from '../../components/Icon.astro';
import { COMPOUNDS, type CompoundSpec } from '../../data/compounds';
import {
  compoundShort, shopsCarrying, reportsFor, sizesFor, sizePagesFor, offersFor, cheapestBy, perMg, fillPct, CHECKED_LABEL, faqSchema,
  listJoin, PRICE_COMPOUNDS, compoundPairsFor, pairSlug, labKeyOf, YEAR,
} from '../../lib/site';

export function getStaticPaths() {
  return COMPOUNDS.map((c) => ({ params: { slug: c.slug }, props: { c } }));
}
const { c } = Astro.props as { c: CompoundSpec };
const short = compoundShort(c.slug);
const shops = shopsCarrying(c.slug);
const eu = shops.filter((s) => s.region === 'EU').length;
const us = shops.filter((s) => s.region === 'US').length;
const sizes = sizesFor(c.slug);
const reps = reportsFor(c.slug);
const portal = reps.filter((r) => r.report.verifiable).length;
const fills = reps.map((r) => fillPct(r.report)).filter((x): x is number => x != null);
const offers = offersFor(c.slug);
const cEur = cheapestBy(offers, 'EUR');
const cUsd = cheapestBy(offers, 'USD');
const names = Array.from(new Set(offers.map((o) => o.product.shopProductName.replace(/\s*\d+(\.\d+)?\s*mg.*$/i, '').trim()).filter((n) => n && n.toLowerCase() !== short.toLowerCase()))).slice(0, 12);
const labs = Array.from(new Set(reps.map((r) => r.report.lab.replace(/\s*\(.*\)\s*$/, ''))));
const hasPrices = PRICE_COMPOUNDS.includes(c.slug);

const intro = `${c.name}: ${c.formulaOrClass}. ${shops.length} of the shops we audited list it in ${sizes.length} vial ${sizes.length === 1 ? 'size' : 'sizes'}${sizes.length ? ` (${listJoin(sizes.map((s) => `${s} mg`))})` : ''}. We opened ${reps.length} lab ${reps.length === 1 ? 'report' : 'reports'} for it${fills.length ? `; measured content was ${Math.min(...fills).toFixed(1)}–${Math.max(...fills).toFixed(1)}% of label` : ''}.`;
const title = `${short}: Research Compound Facts, Vial Sizes & Lab Tests (${YEAR})`;
const description = `${short} facts: class, CAS ${c.casNumber}, molecular weight, vial sizes at ${shops.length} audited shops and ${reps.length} opened lab reports. Research use only.`;
const crumbs = [{ name: 'Home', url: '/' }, { name: 'Compounds', url: '/compounds/' }, { name: short, url: `/compounds/${c.slug}/` }];
const faqs = [
  { q: `What is ${short}?`, a: c.summary },
  { q: `Which vial sizes of ${short} are on the market?`, a: sizes.length ? `Audited shops list ${short} in ${listJoin(sizes.map((s) => `${s} mg`))} vials (${shops.length} shops: ${eu} EU, ${us} US).` : `None of the audited shops lists ${short}.` },
  { q: `Are there lab reports for ${short}?`, a: reps.length ? `We opened ${reps.length} ${short} reports from ${new Set(reps.map((r) => r.vendor.slug)).size} shops; ${portal} were verified on the lab's own portal. Labs named: ${listJoin(labs)}.` : `We did not open a ${short} lab report at any audited shop.` },
  { q: `What should a ${short} lab report show?`, a: c.analyticalNotes },
];
const fillRows = reps.map((r) => ({ label: `${r.vendor.name} ${r.report.labelMg ?? ''}${r.report.labelMg ? ' mg' : ''}`, sub: r.report.lab, labelMg: r.report.labelMg, measuredMg: r.report.measuredMg, verified: r.report.verifiable }));
const related = [
  ...(hasPrices ? [{ href: `/prices/${c.slug}/`, label: `${short} price comparison`, sub: `${shops.length} shops` }] : []),
  ...sizePagesFor(c.slug).map((s) => ({ href: `/prices/${c.slug}/${s.size}mg/`, label: `${short} ${s.size} mg prices`, sub: `${s.shops} shops` })),
  ...compoundPairsFor(c.slug).map(([a, b]) => ({ href: `/compare/${pairSlug(a, b)}/`, label: `${compoundShort(a)} vs ${compoundShort(b)}`, sub: 'Research comparison' })),
  ...Array.from(new Set(reps.map((r) => labKeyOf(r.report.lab)?.slug).filter(Boolean) as string[])).slice(0, 3).map((s) => ({ href: `/labs/${s}/`, label: `Lab guide: ${s.replace(/-/g, ' ')}`, sub: 'How to verify a report' })),
];
---
<BaseLayout title={title} description={description} crumbs={crumbs} jsonLd={faqSchema(faqs)}>
  <PageHero crumbs={crumbs} title={`${c.name}: research compound facts`} eyebrow={c.category} intro={intro}>
    {hasPrices && <div class="mt-6"><a href={`/prices/${c.slug}/`} class="btn-primary">Compare {short} prices <Icon name="arrow-right" class="w-4 h-4" /></a></div>}
  </PageHero>
  <div class="wrap mt-12 space-y-14">
    <section class="grid gap-8 lg:grid-cols-2">
      <div class="prose-read">
        <h2 class="!mt-0">What {short} is</h2>
        <p>{c.summary}</p>
        <h2>What to check on a lab report</h2>
        <p>{c.analyticalNotes}</p>
      </div>
      <dl class="facts card px-5 sm:px-6 py-2 self-start">
        <div><dt>Name</dt><dd>{c.name}</dd></div>
        <div><dt>Class</dt><dd>{c.formulaOrClass}</dd></div>
        <div><dt>Group on this site</dt><dd>{c.category}</dd></div>
        <div><dt>CAS number</dt><dd>{c.casNumber}</dd></div>
        <div><dt>Molecular weight</dt><dd>{c.molecularWeightDa}</dd></div>
      </dl>
    </section>

    <section class="space-y-4">
      <h2 class="h2">{short} on the market</h2>
      <dl class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        <div class="stat"><dt>Shops listing it</dt><dd>{shops.length} <span class="text-sm font-medium text-slate-600">({eu} EU, {us} US)</span></dd></div>
        <div class="stat"><dt>Vial sizes</dt><dd>{sizes.length ? sizes.map((s) => `${s}`).join(', ') + ' mg' : 'n/a'}</dd></div>
        <div class="stat"><dt>Lowest price per mg (EUR)</dt><dd>{cEur ? perMg(cEur.perMg, 'EUR') : 'n/a'}</dd></div>
        <div class="stat"><dt>Lowest price per mg (USD)</dt><dd>{cUsd ? perMg(cUsd.perMg, 'USD') : 'n/a'}</dd></div>
      </dl>
      {names.length > 0 && <p class="text-slate-700 max-w-[70ch]"><strong class="text-slate-900">Product names used by audited shops:</strong> {names.join(', ')}.</p>}
      {['EUR', 'USD'].map((cur) => {
        const bars = offers.filter((o) => o.currency === cur && o.perMg != null).map((o) => ({ label: o.vendor.name, sub: `${o.product.vialMg} mg`, value: o.perMg as number, partner: o.partner }));
        return bars.length > 2 ? <PriceBars bars={bars} currency={cur} title={`${short}: price per mg by listing (${cur})`} max={10} /> : null;
      })}
    </section>

    <section class="space-y-4">
      <h2 class="h2">Lab-test coverage</h2>
      <p class="text-slate-700 max-w-[70ch]">{reps.length ? `${reps.length} opened ${reps.length === 1 ? 'report' : 'reports'}, ${portal} portal-verified. Labs: ${listJoin(labs)}.` : `We did not open a ${short} report at any audited shop.`}</p>
      <FillChart rows={fillRows} title={`${short}: measured content as % of label`} />
    </section>

    <FAQ items={faqs} />
    <RelatedLinks links={related} />
    <p class="text-sm text-slate-600 max-w-[75ch]">Research use only. This page describes a laboratory reagent as listed by shops. It contains no information on use in humans or animals.</p>
  </div>
</BaseLayout>
