---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { COMPOUNDS } from '../../data/compounds';
import { compoundShort, shopsCarrying, reportsFor, sizesFor, CHECKED_LABEL, TOTALS, itemListSchema } from '../../lib/site';
const rows = COMPOUNDS.map((c) => ({ c, short: compoundShort(c.slug), shops: shopsCarrying(c.slug).length, reports: reportsFor(c.slug).length, sizes: sizesFor(c.slug) }));
const cats = Array.from(new Set(COMPOUNDS.map((c) => c.category)));
const crumbs = [{ name: 'Home', url: '/' }, { name: 'Compounds', url: '/compounds/' }];
---
<BaseLayout title="Research Compound Index: Facts, Vial Sizes & Lab Tests" description={`Neutral facts for ${COMPOUNDS.length} research compounds: class, CAS, vial sizes on the market and lab-report coverage at ${TOTALS.shops} audited shops. Browse the index.`} crumbs={crumbs} jsonLd={itemListSchema('Research compounds', rows.map((r) => ({ name: r.short, url: `/compounds/${r.c.slug}/` })))}>
  <PageHero crumbs={crumbs} title="Research compound index" intro={`Neutral reference facts for ${COMPOUNDS.length} research compounds sold by the shops we audit: what each compound is, its class and identifiers, the vial sizes on the market and how many lab reports we opened. Data checked ${CHECKED_LABEL}. No dosing or health information.`} />
  <div class="wrap mt-12 space-y-12">
    {cats.map((cat) => (
      <section class="space-y-4">
        <h2 class="h2">{cat}</h2>
        <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {rows.filter((r) => r.c.category === cat).map((r) => (
            <li class="card card-hover p-5 flex flex-col">
              <a href={`/compounds/${r.c.slug}/`} class="tap text-lg font-bold text-slate-900 hover:text-teal-800 hover:underline">{r.c.name}</a>
              <p class="mt-1.5 text-[0.95rem] text-slate-700">{r.c.formulaOrClass}</p>
              <p class="mt-3 text-sm text-slate-600">{r.shops} shops · {r.sizes.length} vial sizes · {r.reports} lab reports opened</p>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</BaseLayout>
