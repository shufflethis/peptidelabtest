---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import { DATASET, DATASET_COLUMNS } from '../../lib/dataset';
import { TOTALS, CHECKED_ISO, CHECKED_LABEL, SITE_URL, SITE_NAME } from '../../lib/site';
const crumbs = [{ name: 'Home', url: '/' }, { name: 'Open data', url: '/data/' }];
const desc: Record<string, string> = {
  shop: 'Shop name', shopSlug: 'Shop ID (matches /vendors/<id>/)', region: 'EU or US', compound: 'Compound ID (matches /compounds/<id>/)', product: 'Product name as listed by the shop',
  vialMg: 'mg on the label', price: 'Listed price', salePrice: 'Sale price if shown', currency: 'EUR or USD (never converted)', pricePerMg: 'Price (sale price if shown) / label mg',
  labReportOpenedForCompound: 'We opened a lab report from this shop for this compound', portalVerified: 'At least one such report was found on the lab portal',
  shopScore: 'Audit score 0-5', reviewedAt: 'Date the shop was checked',
};
const dataset = {
  '@context': 'https://schema.org', '@type': 'Dataset', name: 'Research peptide shop audit 2026 (prices, lab reports, scores)',
  description: `${DATASET.length} listed prices from ${TOTALS.shops} audited research peptide shops with price per mg, lab-report coverage and audit score. Checked ${CHECKED_ISO}.`,
  url: `${SITE_URL}/data/`, creator: { '@type': 'Organization', name: SITE_NAME, url: `${SITE_URL}/` }, dateModified: CHECKED_ISO, temporalCoverage: CHECKED_ISO,
  license: 'https://creativecommons.org/licenses/by/4.0/', isAccessibleForFree: true, keywords: ['research peptides', 'price per mg', 'lab reports', 'COA'],
  variableMeasured: DATASET_COLUMNS,
  distribution: [
    { '@type': 'DataDownload', encodingFormat: 'text/csv', contentUrl: `${SITE_URL}/data/peptide-shop-audit-2026.csv` },
    { '@type': 'DataDownload', encodingFormat: 'application/json', contentUrl: `${SITE_URL}/data/peptide-shop-audit-2026.json` },
  ],
};
---
<BaseLayout title="Open Data: Research Peptide Shop Audit 2026 (CSV, JSON)" description={`Download ${DATASET.length} listed prices from ${TOTALS.shops} audited shops with price per mg, lab-report coverage and scores. CSV and JSON, CC BY 4.0.`} crumbs={crumbs} jsonLd={dataset}>
  <PageHero crumbs={crumbs} title="Open data: research peptide shop audit 2026" intro={`The full price data behind this site: ${DATASET.length} listed prices from ${TOTALS.shops} audited shops, one row per product, with price per mg, whether we opened a lab report for that compound at that shop, and the shop's audit score. Checked ${CHECKED_LABEL}. Free to reuse with attribution (CC BY 4.0).`}>
    <div class="mt-6 flex flex-wrap gap-3">
      <a href="/data/peptide-shop-audit-2026.csv" class="btn-primary"><Icon name="download" class="w-4 h-4" />Download CSV</a>
      <a href="/data/peptide-shop-audit-2026.json" class="btn-ghost"><Icon name="download" class="w-4 h-4" />Download JSON</a>
    </div>
  </PageHero>
  <div class="wrap mt-12 space-y-10">
    <section class="space-y-4">
      <h2 class="h2">Columns</h2>
      <div class="table-wrap">
        <table class="data-table">
          <thead><tr><th scope="col">Column</th><th scope="col">Meaning</th></tr></thead>
          <tbody>{DATASET_COLUMNS.map((c) => <tr><td><code class="font-mono text-sm text-slate-900">{c}</code></td><td>{desc[c as string]}</td></tr>)}</tbody>
        </table>
      </div>
    </section>
    <section class="prose-read">
      <h2>Notes</h2>
      <ul>
        <li>Prices are list prices without discount codes. EUR and USD are never converted.</li>
        <li>Empty cells mean the shop did not publish the value.</li>
        <li>Lab report addresses and IDs are on each shop's review page and on <a href="/batch-tracker/">Lab reports we opened</a>.</li>
        <li>Please cite as: {SITE_NAME}, research peptide shop audit, {CHECKED_LABEL}, {SITE_URL}/data/.</li>
      </ul>
    </section>
  </div>
</BaseLayout>
