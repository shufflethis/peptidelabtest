---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { PRICE_COMPOUNDS, compoundShort, shopsCarrying, sizePagesFor, offersFor, cheapestBy, perMg, CHECKED_LABEL, TOTALS, getCompound } from '../lib/site';
const rows = PRICE_COMPOUNDS.map((c) => {
  const o = offersFor(c);
  return { slug: c, name: compoundShort(c), cat: getCompound(c)?.category || 'Other research compounds', shops: shopsCarrying(c).length, sizes: sizePagesFor(c), eur: cheapestBy(o, 'EUR'), usd: cheapestBy(o, 'USD') };
});
const cats = Array.from(new Set(rows.map((r) => r.cat)));
const crumbs = [{ name: 'Home', url: '/' }, { name: 'Price index', url: '/price-index/' }];
---
<BaseLayout title="Research Peptide Price Index 2026 by Category" description={`Lowest listed price per mg for ${rows.length} research compounds, grouped by class, EUR and USD kept separate. Check prices and open each comparison.`} crumbs={crumbs}>
  <PageHero crumbs={crumbs} title="Research peptide price index" intro={`Lowest listed price per mg for ${rows.length} research compounds, grouped by compound class. Data from ${TOTALS.products} prices at ${TOTALS.shops} audited shops, read on ${CHECKED_LABEL}. EUR and USD are never converted. Open a compound for the full shop-by-shop table.`} />
  <div class="wrap mt-12 space-y-12">
    {cats.map((cat) => (
      <section class="space-y-4">
        <h2 class="h2">{cat}</h2>
        <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {rows.filter((r) => r.cat === cat).map((r) => (
            <li class="card p-5">
              <a href={`/prices/${r.slug}/`} class="tap text-lg font-bold text-slate-900 hover:text-teal-800 hover:underline">{r.name} prices</a>
              <p class="mt-1 text-slate-700">{r.shops} shops · from {[r.eur && perMg(r.eur.perMg, 'EUR'), r.usd && perMg(r.usd.perMg, 'USD')].filter(Boolean).join(' or ') || 'n/a'}</p>
              {r.sizes.length > 0 && <p class="mt-2 text-[0.94rem] text-slate-700">By size: {r.sizes.map((s, i) => <>{i > 0 && ', '}<a href={`/prices/${r.slug}/${s.size}mg/`} class="text-link font-medium">{s.size} mg</a></>)}</p>}
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</BaseLayout>
