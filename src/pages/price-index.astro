---
import BaseLayout from '../layouts/BaseLayout.astro';
import PriceIndexWidget from '../components/PriceIndexWidget.astro';
import { SITE_BRAND } from '../data/affiliates';

const datasetSchema = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: '2026 Research Peptide True $/mg & €/mg COA Price Index',
  description:
    'Comparative dataset of research peptide prices normalized by third-party laboratory measured milligram content across US and EU suppliers.',
  url: `${SITE_BRAND.url}/price-index/`,
};
---

<BaseLayout
  title="True $/mg & €/mg Peptide Price Index (2026): Normalized by COA Fill Weight"
  description="Compare US ($) and EU (€) research peptide prices per real COA-measured milligram after verified discount codes across Retatrutide, Tirzepatide, BPC-157 & TB-500."
  jsonLd={datasetSchema}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-12 space-y-8">
    <div class="max-w-3xl space-y-3">
      <nav class="text-xs font-mono text-slate-400">
        <a href="/" class="hover:text-cyan-400">Home</a> / <span class="text-slate-200">True $/mg Price Index</span>
      </nav>
      <h1 class="text-3xl sm:text-5xl font-black text-white">
        True $/mg &amp; €/mg Price-per-Measured-mg Index
      </h1>
      <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
        Standard price comparisons divide checkout price by label claims. Our index divides net post-code price by <strong>actual third-party COA milligram content</strong>—exposing fake "budget" vials that are severely underfilled.
      </p>
    </div>

    <PriceIndexWidget />
  </div>
</BaseLayout>
