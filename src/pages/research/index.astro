---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { RESEARCH_ARTICLES } from '../../data/labs';
---

<BaseLayout
  title="Peptide Lab Verification & Code-Name Research Library (2026)"
  description="Analytical guides covering RT-3 / GLP-3 Retatrutide code names, Peptide Sciences 2026 shutdown replacements, COA verification, and vial underfill math."
>
  <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pt-12 space-y-8">
    <div class="space-y-3">
      <nav class="text-xs font-mono text-slate-400">
        <a href="/" class="hover:text-cyan-400">Home</a> / <span class="text-slate-200">Research &amp; Guides</span>
      </nav>
      <h1 class="text-3xl sm:text-5xl font-black text-white">
        Analytical Research &amp; COA Verification Library
      </h1>
      <p class="text-sm sm:text-base text-slate-300">
        Evidence-based investigations into lyophilized fill variance, storefront code names, and laboratory certificate authentication.
      </p>
    </div>

    <div class="space-y-5">
      {RESEARCH_ARTICLES.map((art) => (
        <a href={`/research/${art.slug}/`} class="glass-card rounded-2xl p-6 block hover:border-cyan-400/50 transition-all space-y-2.5">
          <div class="flex justify-between text-xs font-mono text-slate-400">
            <span class="text-cyan-400 font-bold">{art.category}</span>
            <span>{art.publishedDate} · {art.readTime}</span>
          </div>
          <h2 class="text-2xl font-extrabold text-white">{art.title}</h2>
          <p class="text-sm text-slate-300 leading-relaxed">{art.excerpt}</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
