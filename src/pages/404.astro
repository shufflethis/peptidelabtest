---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { PRICE_COMPOUNDS, compoundShort } from '../lib/site';
const links = [
  { href: '/prices/', label: 'Compare prices', icon: 'bar-h' },
  { href: '/vendors/', label: 'Shop ranking', icon: 'building' },
  { href: '/batch-tracker/', label: 'Lab reports we opened', icon: 'file-text' },
  { href: '/compounds/', label: 'Compounds', icon: 'beaker' },
];
---
<BaseLayout translated={false} title="Page not found | PeptideLabIndex" description="This page does not exist. Find prices, shop reviews and lab reports from here." noindex>
  <section class="hero-bg border-b border-slate-200">
    <div class="wrap py-16">
      <p class="text-sm font-semibold text-teal-800">Error 404</p>
      <h1 class="h1 mt-2">Page not found</h1>
      <p class="lead mt-4">The page you asked for does not exist or has moved. These pages are a good place to start.</p>
      <ul class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-4 max-w-5xl">
        {links.map((l) => (
          <li><a href={l.href} class="card card-hover flex items-center gap-3 p-4 min-h-[56px] font-semibold text-slate-900"><Icon name={l.icon} class="w-5 h-5 text-teal-800" />{l.label}</a></li>
        ))}
      </ul>
      <h2 class="h3 mt-10">Price comparisons</h2>
      <ul class="mt-3 flex flex-wrap gap-2">
        {PRICE_COMPOUNDS.slice(0, 12).map((c) => <li><a href={`/prices/${c}/`} class="inline-flex items-center min-h-[44px] rounded-xl bg-white border border-slate-300 px-3.5 font-semibold text-slate-800 hover:border-teal-600">{compoundShort(c)}</a></li>)}
      </ul>
    </div>
  </section>
</BaseLayout>
