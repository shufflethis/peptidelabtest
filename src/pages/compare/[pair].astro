---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import FillChart from '../../components/FillChart.astro';
import FAQ from '../../components/FAQ.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import Disclosure from '../../components/Disclosure.astro';
import Icon from '../../components/Icon.astro';
import {
  COMPOUND_PAIRS, pairSlug, compoundShort, getCompound, shopsCarrying, sizesFor, offersFor, cheapestBy, perMg, reportsFor, fillPct, median,
  listJoin, faqSchema, CHECKED_LABEL, YEAR, VENDORS_BY_SCORE, isPartner, shopHref, REL_SPONSORED, sizePagesFor, PRICE_COMPOUNDS,
} from '../../lib/site';

export function getStaticPaths() {
  return COMPOUND_PAIRS.map(([a, b]) => ({ params: { pair: pairSlug(a, b) }, props: { a, b } }));
}
const { a, b } = Astro.props as { a: string; b: string };
function stats(slug: string) {
  const c = getCompound(slug)!;
  const shops = shopsCarrying(slug);
  const offers = offersFor(slug);
  const reps = reportsFor(slug);
  const fills = reps.map((r) => fillPct(r.report)).filter((x): x is number => x != null);
  const pur = reps.map((r) => r.report.purityPercent).filter((x): x is number => x != null);
  const med = (cur: string) => median(offers.filter((o) => o.currency === cur && o.perMg != null).map((o) => o.perMg as number));
  return {
    slug, c, short: compoundShort(slug), shops, eu: shops.filter((s) => s.region === 'EU').length, us: shops.filter((s) => s.region === 'US').length,
    sizes: sizesFor(slug), offers, eur: cheapestBy(offers, 'EUR'), usd: cheapestBy(offers, 'USD'), medEur: med('EUR'), medUsd: med('USD'),
    reps, portal: reps.filter((r) => r.report.verifiable).length, fills, pur,
  };
}
const A = stats(a);
const B = stats(b);
const both = VENDORS_BY_SCORE.filter((v) => A.shops.includes(v) && B.shops.includes(v));
const cheapAt = (slug: string, vslug: string) => offersFor(slug).filter((o) => o.vendor.slug === vslug && o.perMg != null).sort((x, y) => x.perMg! - y.perMg!)[0];
const rng = (xs: number[], unit = '%') => (xs.length ? `${Math.min(...xs).toFixed(1)}–${Math.max(...xs).toFixed(1)}${unit}` : 'n/a');
const pm = (n: number | null, cur: string) => (n == null ? 'n/a' : perMg(n, cur));

const title = `${A.short} vs ${B.short}: Research Comparison, Prices & Lab Tests (${YEAR})`;
const description = `${A.short} vs ${B.short}: identity facts, vial sizes, price per mg (EUR/USD) and lab reports at audited shops. ${both.length} shops list both. No dosing or health claims.`;
const intro = `${A.short}: ${A.c.formulaOrClass}. ${B.short}: ${B.c.formulaOrClass}. On ${CHECKED_LABEL}, ${A.shops.length} audited shops listed ${A.short} and ${B.shops.length} listed ${B.short}; ${both.length} list both. We opened ${A.reps.length} ${A.short} and ${B.reps.length} ${B.short} lab reports.`;
const crumbs = [{ name: 'Home', url: '/' }, { name: 'Compound comparisons', url: '/compare/' }, { name: `${A.short} vs ${B.short}`, url: `/compare/${pairSlug(a, b)}/` }];
const cheaper = (cur: 'EUR' | 'USD') => {
  const x = cur === 'EUR' ? A.medEur : A.medUsd;
  const y = cur === 'EUR' ? B.medEur : B.medUsd;
  if (x == null || y == null) return null;
  return `median ${cur} price per mg: ${A.short} ${perMg(x, cur)}, ${B.short} ${perMg(y, cur)}`;
};
const faqs = [
  { q: `What is the difference between ${A.short} and ${B.short}?`, a: `They are different molecules. ${A.c.summary} ${B.c.summary}` },
  { q: `Which is cheaper per mg, ${A.short} or ${B.short}?`, a: `Across all listings on ${CHECKED_LABEL}: ${[cheaper('EUR'), cheaper('USD')].filter(Boolean).join('; ') || 'not enough data'}. Larger vials usually cost less per mg, so compare the same vial size.` },
  { q: `Which shops sell both ${A.short} and ${B.short}?`, a: both.length ? `${both.length} audited shops list both: ${listJoin(both.map((v) => v.name))}.` : 'None of the audited shops lists both.' },
  { q: `Is there lab-test data for ${A.short} and ${B.short}?`, a: `We opened ${A.reps.length} ${A.short} reports (${A.portal} portal-verified) and ${B.reps.length} ${B.short} reports (${B.portal} portal-verified). Measured vs label: ${A.short} ${rng(A.fills)}, ${B.short} ${rng(B.fills)}.` },
  { q: `Can ${A.short} or ${B.short} be used in humans?`, a: 'This site does not cover human or animal use. The shops listed sell both as research-use-only laboratory reagents, and we compare listings and lab reports only.' },
];
const rows: [string, string, string][] = [
  ['Class', A.c.formulaOrClass, B.c.formulaOrClass],
  ['Group on this site', A.c.category, B.c.category],
  ['CAS number', A.c.casNumber, B.c.casNumber],
  ['Molecular weight', A.c.molecularWeightDa, B.c.molecularWeightDa],
  ['Shops listing it (EU / US)', `${A.shops.length} (${A.eu} / ${A.us})`, `${B.shops.length} (${B.eu} / ${B.us})`],
  ['Vial sizes', A.sizes.map((s) => `${s} mg`).join(', ') || 'n/a', B.sizes.map((s) => `${s} mg`).join(', ') || 'n/a'],
  ['Lowest price per mg (EUR)', A.eur ? `${perMg(A.eur.perMg, 'EUR')} (${A.eur.vendor.name})` : 'n/a', B.eur ? `${perMg(B.eur.perMg, 'EUR')} (${B.eur.vendor.name})` : 'n/a'],
  ['Median price per mg (EUR)', pm(A.medEur, 'EUR'), pm(B.medEur, 'EUR')],
  ['Lowest price per mg (USD)', A.usd ? `${perMg(A.usd.perMg, 'USD')} (${A.usd.vendor.name})` : 'n/a', B.usd ? `${perMg(B.usd.perMg, 'USD')} (${B.usd.vendor.name})` : 'n/a'],
  ['Median price per mg (USD)', pm(A.medUsd, 'USD'), pm(B.medUsd, 'USD')],
  ['Lab reports opened', `${A.reps.length} (${A.portal} portal-verified)`, `${B.reps.length} (${B.portal} portal-verified)`],
  ['Measured vs label', rng(A.fills), rng(B.fills)],
  ['Purity on reports', A.pur.length ? `${Math.min(...A.pur)}–${Math.max(...A.pur)}%` : 'n/a', B.pur.length ? `${Math.min(...B.pur)}–${Math.max(...B.pur)}%` : 'n/a'],
];
const fillRowsFor = (S: ReturnType<typeof stats>) => S.reps.map((r) => ({ label: `${r.vendor.name} ${r.report.labelMg ?? ''}${r.report.labelMg ? ' mg' : ''}`, sub: r.report.lab, labelMg: r.report.labelMg, measuredMg: r.report.measuredMg, verified: r.report.verifiable }));
const related = [
  ...[A, B].filter((S) => PRICE_COMPOUNDS.includes(S.slug)).map((S) => ({ href: `/prices/${S.slug}/`, label: `${S.short} price comparison`, sub: `${S.shops.length} shops` })),
  ...[A, B].map((S) => ({ href: `/compounds/${S.slug}/`, label: `${S.short} compound facts` })),
  ...[A, B].flatMap((S) => sizePagesFor(S.slug).slice(0, 2).map((s) => ({ href: `/prices/${S.slug}/${s.size}mg/`, label: `${S.short} ${s.size} mg prices`, sub: `${s.shops} shops` }))),
  ...COMPOUND_PAIRS.filter(([x, y]) => pairSlug(x, y) !== pairSlug(a, b)).map(([x, y]) => ({ href: `/compare/${pairSlug(x, y)}/`, label: `${compoundShort(x)} vs ${compoundShort(y)}` })),
];
---
<BaseLayout title={title} description={description} crumbs={crumbs} jsonLd={faqSchema(faqs)}>
  <PageHero crumbs={crumbs} title={`${A.short} vs ${B.short}: research compound comparison`} eyebrow="Market and lab data, no effects" intro={intro} />
  <div class="wrap mt-12 space-y-14">
    <section class="space-y-4">
      <h2 class="h2">Side by side</h2>
      <div class="table-wrap">
        <table class="data-table">
          <thead><tr><th scope="col">Fact</th><th scope="col">{A.short}</th><th scope="col">{B.short}</th></tr></thead>
          <tbody>
            {rows.map(([k, x, y]) => <tr><td class="font-semibold text-slate-900 min-w-[9rem]">{k}</td><td class="min-w-[12rem]">{x}</td><td class="min-w-[12rem]">{y}</td></tr>)}
          </tbody>
        </table>
      </div>
      <p class="text-sm text-slate-600">Price per mg = listed price divided by label mg. EUR and USD are not converted. Median = middle value of all listings.</p>
    </section>

    <section class="grid gap-8 lg:grid-cols-2">
      {[A, B].map((S) => (
        <div class="prose-read">
          <h2 class="!mt-0">What {S.short} is</h2>
          <p>{S.c.summary}</p>
          <p><strong>On a lab report:</strong> {S.c.analyticalNotes}</p>
        </div>
      ))}
    </section>

    {both.length > 0 && (
      <section class="space-y-4">
        <h2 class="h2">Shops that list both</h2>
        <p class="text-slate-700 max-w-[70ch]">Lowest listed price per mg at each shop, by audit score. Partner shops have a store link.</p>
        <div class="table-wrap">
          <table class="data-table">
            <thead><tr><th scope="col">Shop</th><th scope="col" class="num">{A.short} lowest per mg</th><th scope="col" class="num">{B.short} lowest per mg</th><th scope="col" class="num">Score (0-5)</th><th scope="col">Store</th></tr></thead>
            <tbody>
              {both.map((v) => {
                const x = cheapAt(a, v.slug);
                const y = cheapAt(b, v.slug);
                const href = shopHref(v.slug);
                return (
                  <tr class={isPartner(v.slug) ? '' : 'row-muted'}>
                    <td class="min-w-[10rem]"><a href={`/vendors/${v.slug}/`} class="font-semibold text-slate-900 hover:text-teal-800 hover:underline">{v.name}</a><span class="sub">{v.region}{isPartner(v.slug) ? ' · partner' : ''}</span></td>
                    <td class="num">{x ? perMg(x.perMg, x.currency) : 'n/a'}{x && <span class="sub">{x.product.vialMg} mg vial</span>}</td>
                    <td class="num">{y ? perMg(y.perMg, y.currency) : 'n/a'}{y && <span class="sub">{y.product.vialMg} mg vial</span>}</td>
                    <td class="num font-semibold">{v.overallScore.toFixed(1)}</td>
                    <td>{href ? <a href={href} rel={REL_SPONSORED} target="_blank" class="btn-primary">Visit shop <Icon name="external-link" class="w-4 h-4" /></a> : <a href={`/vendors/${v.slug}/`} class="text-link">Read review</a>}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </section>
    )}

    <section class="space-y-6">
      <h2 class="h2">Lab reports: measured vs label</h2>
      <div class="grid gap-6 xl:grid-cols-2">
        <FillChart rows={fillRowsFor(A)} title={`${A.short} (${A.reps.length} reports)`} />
        <FillChart rows={fillRowsFor(B)} title={`${B.short} (${B.reps.length} reports)`} />
      </div>
    </section>

    <FAQ items={faqs} />
    <RelatedLinks links={related} />
    <Disclosure />
  </div>
</BaseLayout>
