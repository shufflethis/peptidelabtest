---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import ShopCard from '../components/ShopCard.astro';
import TrustStrip from '../components/TrustStrip.astro';
import FAQ from '../components/FAQ.astro';
import Disclosure from '../components/Disclosure.astro';
import {
  PARTNERS, NON_PARTNERS, partnersIn, PRICE_COMPOUNDS, compoundShort, shopsCarrying, TOTALS, CHECKED_LABEL, YEAR,
  itemListSchema, faqSchema, COMPOUND_PAIRS, pairSlug, LABS_IN_DATA, reportsByLab, SIZE_PAGES, offersFor, cheapestBy, perMg, fitDesc,
} from '../lib/site';

const picker = PRICE_COMPOUNDS.map((c) => ({ slug: c, name: compoundShort(c), shops: shopsCarrying(c).length }))
  .sort((a, b) => b.shops - a.shops);
const euPartners = partnersIn('EU');
const usPartners = partnersIn('US');
const shopsWithReports = TOTALS.shopsWithReports;

const title = `Research Peptide Prices & Lab Tests Compared (${YEAR})`;
const description = fitDesc(`${TOTALS.shops} research peptide shops audited: ${TOTALS.reportsOpened} lab reports opened, ${TOTALS.portalVerified} verified on the lab portal. Compare price per mg in EUR and USD.`);
const intro = `We audited ${TOTALS.shops} research peptide shops in the EU and US on ${CHECKED_LABEL}. We opened ${TOTALS.reportsOpened} lab reports from ${shopsWithReports} shops, found ${TOTALS.portalVerified} of them on the lab's own portal, and recorded ${TOTALS.products} listed prices as price per mg. Shops are ranked by audit score, never by commission.`;

const topPairs = COMPOUND_PAIRS.slice(0, 4);
const popularSizes = [...SIZE_PAGES].sort((a, b) => b.shops - a.shops).slice(0, 6);

const steps = [
  { icon: 'file-text', title: 'We open the lab reports', text: 'For each shop we open the lab reports it publishes and note the lab, test date, purity and measured mg.' },
  { icon: 'shield-check', title: 'We check the lab portal', text: 'Where the lab offers a lookup, we check that the report exists on the lab’s own site. That is “portal-verified”.' },
  { icon: 'ruler', title: 'We compare measured vs label', text: 'Measured mg divided by label mg. 100% means the vial holds what the label says.' },
  { icon: 'tag', title: 'We record prices per mg', text: 'Price per mg = listed vial price divided by the mg on the label. EUR and USD stay separate.' },
];

const faqs = [
  {
    q: 'How do you rank research peptide shops?',
    a: 'Each shop gets a 0-5 audit score from six parts: lab verification (30%), fill accuracy (20%), test panel depth (20%), entity transparency (15%), dispatch information (10%) and value per mg (5%). Rankings on this site use that score only, never commission.',
  },
  {
    q: 'What does "portal-verified" mean?',
    a: `The lab report could be found on the testing lab's own website, not only as a file on the shop's site. ${TOTALS.portalVerified} of the ${TOTALS.reportsOpened} reports we opened were portal-verified.`,
  },
  {
    q: 'Why do some shops have no "Visit shop" button?',
    a: 'Only partner shops get an outbound store link (an affiliate link). Other audited shops are still scored and listed, with a link to our review page only.',
  },
  {
    q: 'Do you give dosing or health information?',
    a: 'No. All listed products are sold as research-use-only laboratory reagents. We compare lab reports, listed prices and shop transparency only.',
  },
];

const jsonLd = [
  itemListSchema('Best audited research peptide shops (partner shops by audit score)', PARTNERS.map((p) => ({ name: p.name, url: `/vendors/${p.slug}/` }))),
  faqSchema(faqs),
];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <section class="hero-bg border-b border-slate-200">
    <div class="wrap pt-10 pb-12 sm:pt-14 sm:pb-16">
      <span class="eyebrow"><Icon name="shield-check" class="w-4 h-4" />Independent desk audit, {CHECKED_LABEL}</span>
      <h1 class="h1 mt-5 max-w-3xl">{title}</h1>
      <p class="lead mt-5" data-answer>{intro}</p>

      <div class="mt-8 card p-5 sm:p-6 max-w-5xl">
        <h2 class="h3">Compare prices for a compound</h2>
        <p class="mt-1 text-slate-700">Pick a compound to see every shop, its price per mg and whether we opened a lab report.</p>
        <ul class="mt-4 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-2.5">
          {picker.map((c) => (
            <li>
              <a href={`/prices/${c.slug}/`} class="block min-h-[48px] rounded-xl border border-slate-300 bg-white px-3.5 py-2 hover:border-teal-600 hover:bg-teal-50">
                <span class="block font-semibold text-slate-900 leading-snug">{c.name}</span>
                <span class="block text-sm text-slate-600 tabular-nums">{c.shops} shops</span>
              </a>
            </li>
          ))}
        </ul>
        <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-3">
          <a href="/prices/" class="btn-primary">All price comparisons <Icon name="arrow-right" class="w-4 h-4" /></a>
          <a href="/vendors/" class="text-link">See the full shop ranking</a>
        </div>
      </div>
    </div>
  </section>

  <div class="wrap mt-10">
    <TrustStrip />
  </div>

  <div class="wrap mt-16 space-y-20">
    <section id="best-shops" class="space-y-8">
      <div class="max-w-[70ch]">
        <h2 class="h2">Best audited shops with a store link</h2>
        <p class="mt-3 text-slate-700">These are our partner shops, ordered by audit score within each region. Every shop is scored with the same formula. Commission plays no part in the order.</p>
      </div>

      <div class="space-y-4">
        <h3 class="h3 flex items-center gap-2"><Icon name="euro" class="w-5 h-5 text-teal-800" />EU shops (prices in EUR)</h3>
        <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          {euPartners.map((v, i) => <ShopCard vendor={v} rank={i + 1} />)}
        </div>
      </div>

      <div class="space-y-4">
        <h3 class="h3 flex items-center gap-2"><Icon name="dollar" class="w-5 h-5 text-teal-800" />US shops (prices in USD)</h3>
        <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          {usPartners.map((v, i) => <ShopCard vendor={v} rank={i + 1} />)}
        </div>
      </div>
    </section>

    <section id="how-we-test" class="space-y-6">
      <div class="max-w-[70ch]">
        <h2 class="h2">How we test</h2>
        <p class="mt-3 text-slate-700">This is a desk audit of public shop pages and lab portals. We did not place test orders. Every number on the site comes from a report or price page we opened on {CHECKED_LABEL}.</p>
      </div>
      <ol class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {steps.map((s, i) => (
          <li class="card p-5">
            <div class="flex items-center gap-3">
              <span class="w-10 h-10 rounded-xl bg-teal-50 text-teal-800 flex items-center justify-center"><Icon name={s.icon} class="w-5 h-5" /></span>
              <span class="text-sm font-semibold text-slate-600">Step {i + 1}</span>
            </div>
            <h3 class="mt-3 font-bold text-slate-900 text-lg leading-snug">{s.title}</h3>
            <p class="mt-1.5 text-slate-700">{s.text}</p>
          </li>
        ))}
      </ol>
      <a href="/methodology/" class="text-link inline-flex items-center gap-1">Read the full methodology <Icon name="arrow-right" class="w-4 h-4" /></a>
    </section>

    <section id="other-shops" class="space-y-5">
      <div class="max-w-[70ch]">
        <h2 class="h2">Other audited shops</h2>
        <p class="mt-3 text-slate-700">These shops are scored with the same method. They are not partners, so we link to our review only, not to the shop.</p>
      </div>
      <div class="table-wrap">
        <table class="data-table">
          <thead>
            <tr>
              <th scope="col">Shop</th>
              <th scope="col">Region</th>
              <th scope="col" class="num">Score (0-5)</th>
              <th scope="col" class="num">Reports portal-verified</th>
              <th scope="col">Verdict</th>
            </tr>
          </thead>
          <tbody>
            {NON_PARTNERS.map((v) => (
              <tr>
                <td class="min-w-[10rem]"><a href={`/vendors/${v.slug}/`} class="font-semibold text-slate-900 hover:text-teal-800 hover:underline">{v.name}</a><span class="sub">Read review</span></td>
                <td>{v.region}</td>
                <td class="num font-semibold">{v.overallScore.toFixed(1)}</td>
                <td class="num">{v.coaStats.opened ? `${v.coaStats.portalVerified} of ${v.coaStats.opened}` : 'none published'}</td>
                <td class="min-w-[18rem] max-w-[34rem]">{v.verdictSummary}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="grid gap-6 lg:grid-cols-3">
      <div class="card p-5 sm:p-6">
        <h2 class="h3 flex items-center gap-2"><Icon name="bar-h" class="w-5 h-5 text-teal-800" />Popular vial sizes</h2>
        <ul class="mt-3 divide-y divide-slate-200">
          {popularSizes.map((s) => {
            const o = offersFor(s.compound, s.size);
            const e = cheapestBy(o, 'EUR');
            const u = cheapestBy(o, 'USD');
            return (
              <li class="py-2.5">
                <a href={`/prices/${s.compound}/${s.size}mg/`} class="font-semibold text-slate-900 hover:text-teal-800 hover:underline">{compoundShort(s.compound)} {s.size} mg</a>
                <span class="block text-sm text-slate-600">{s.shops} shops · from {[e && perMg(e.perMg, 'EUR'), u && perMg(u.perMg, 'USD')].filter(Boolean).join(' or ') || 'n/a'}</span>
              </li>
            );
          })}
        </ul>
        <a href="/prices/" class="mt-3 inline-block text-link">All vial sizes</a>
      </div>
      <div class="card p-5 sm:p-6">
        <h2 class="h3 flex items-center gap-2"><Icon name="git-compare" class="w-5 h-5 text-teal-800" />Compound comparisons</h2>
        <ul class="mt-3 divide-y divide-slate-200">
          {topPairs.map(([a, b]) => (
            <li class="py-2.5"><a href={`/compare/${pairSlug(a, b)}/`} class="font-semibold text-slate-900 hover:text-teal-800 hover:underline">{compoundShort(a)} vs {compoundShort(b)}</a><span class="block text-sm text-slate-600">Market, prices and lab reports side by side</span></li>
          ))}
        </ul>
        <a href="/compare/" class="mt-3 inline-block text-link">All comparisons</a>
      </div>
      <div class="card p-5 sm:p-6">
        <h2 class="h3 flex items-center gap-2"><Icon name="flask" class="w-5 h-5 text-teal-800" />Testing labs</h2>
        <ul class="mt-3 divide-y divide-slate-200">
          {LABS_IN_DATA.slice(0, 6).map((l) => (
            <li class="py-2.5"><a href={`/labs/${l.slug}/`} class="font-semibold text-slate-900 hover:text-teal-800 hover:underline">{l.name}</a><span class="block text-sm text-slate-600">{reportsByLab(l.slug).length} reports opened</span></li>
          ))}
        </ul>
        <a href="/labs/" class="mt-3 inline-block text-link">All labs</a>
      </div>
    </section>

    <FAQ items={faqs} />
    <Disclosure />
  </div>
</BaseLayout>
