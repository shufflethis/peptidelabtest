---
import BaseLayout from '../layouts/BaseLayout.astro';
import { VENDORS } from '../data/vendors';
import { resolveVendorLink, SITE_BRAND } from '../data/affiliates';

const codeVendors = VENDORS.map((v) => ({
  vendor: v,
  link: resolveVendorLink(v.slug),
})).filter((x) => Boolean(x.link.promoCode) && !x.link.codeOnlyOnVendorPage);
const maxDiscount = Math.max(0, ...codeVendors.map((x) => x.link.discountPercent ?? 0));
---

<BaseLayout
  title={`Verified Peptide Vendor Discount Codes (${SITE_BRAND.updatedLabel}) ${maxDiscount ? `— Up to ${maxDiscount}% OFF` : ''}`}
  description={`Active 2026 research peptide discount codes across lab-verified US & EU suppliers including CertaPeptides, Genesis Peptides and Arctic Lab Supply.`}
>
  <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pt-12 space-y-8">
    <div class="space-y-3">
      <nav class="text-xs font-mono text-slate-400">
        <a href="/" class="hover:text-cyan-400">Home</a> / <span class="text-slate-200">Verified Discount Codes</span>
      </nav>
      <h1 class="text-3xl sm:text-5xl font-black text-white">
        🏷️ Verified Peptide Supplier Discount Codes ({SITE_BRAND.updatedLabel})
      </h1>
      <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
        Partner discount codes issued for {SITE_BRAND.name} readers across US-domestic and EU-domestic suppliers. Every vendor is still graded strictly under our 6-axis COA formula—click any code to copy it to your clipboard.
      </p>
    </div>

    <div class="space-y-4">
      {codeVendors.length === 0 ? (
        <div class="glass-card rounded-2xl p-6 sm:p-8 border border-cyan-500/30 space-y-3">
          <div class="inline-block px-3 py-1 rounded-full bg-cyan-500/15 border border-cyan-500/30 font-mono text-xs text-cyan-300 font-bold">
            🔄 {SITE_BRAND.updatedLabel} Verification Cycle Active
          </div>
          <h2 class="text-xl font-extrabold text-white">
            Written Confirmation Required Before Code Publication
          </h2>
          <p class="text-sm text-slate-300 leading-relaxed">
            Unlike generic coupon scrapers, {SITE_BRAND.name} only publishes partner codes (<code>{SITE_BRAND.masterCode}</code>) after written confirmation from an audited supplier whose third-party COAs pass our baseline verification check. Browse all 22 audited suppliers in our <a href="/vendors/" class="text-cyan-400 underline">Vendor Scorecard</a> or submit a verified partner code via <a href={`mailto:${SITE_BRAND.contactEmail}`} class="text-emerald-400 underline">{SITE_BRAND.contactEmail}</a>.
          </p>
        </div>
      ) : codeVendors.map(({ vendor, link }) => (
        <div class="glass-card rounded-2xl p-5 sm:p-6 flex flex-wrap items-center justify-between gap-4">
          <div class="space-y-1 max-w-xl">
            <div class="flex items-center gap-2 font-mono text-xs">
              <span class="text-emerald-400 font-bold">★ {vendor.overallScore.toFixed(1)}/5.0</span>
              <span class="text-slate-500">·</span>
              <span class="text-slate-300">{vendor.countryFlag} {vendor.originCountry}</span>
            </div>
            <h2 class="text-xl font-extrabold text-white">
              <a href={`/vendors/${vendor.slug}/`} class="hover:text-cyan-400">{vendor.name}</a>
            </h2>
            <p class="text-xs text-slate-400">{vendor.puritySummary}</p>
          </div>

          <div class="flex flex-wrap items-center gap-3 font-mono text-xs">
            <button
              type="button"
              data-copy-code={link.promoCode}
              class="px-4 py-2.5 rounded-xl bg-emerald-500/15 border border-emerald-500/40 text-emerald-300 font-bold hover:bg-emerald-500/25 cursor-pointer"
            >
              {link.promoCode} ({link.discountPercent}% OFF) · COPY
            </button>
            <a
              href={link.href}
              rel={link.rel}
              target="_blank"
              class="px-4 py-2.5 rounded-xl bg-cyan-500 text-slate-950 font-bold hover:bg-cyan-400"
            >
              Apply at Shop &rarr;
            </a>
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
