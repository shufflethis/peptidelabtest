---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import ScoreRing from '../components/ScoreRing.astro';
import CodeBadge from '../components/CodeBadge.astro';
import FAQ from '../components/FAQ.astro';
import Disclosure from '../components/Disclosure.astro';
import { PARTNERS, NON_PARTNERS, shopHref, REL_SPONSORED, codeInfo, CHECKED_LABEL, faqSchema, YEAR, shopShort, fitDesc } from '../lib/site';

const withCode = PARTNERS.filter((p) => codeInfo(p.slug).kind === 'code');
const title = `Peptide Shop Reader Codes ${YEAR}: Partner Shops Only`;
const description = fitDesc(`Reader codes issued to PeptideLabIndex by ${withCode.length} audited partner shops, ordered by audit score, no invented discounts. Compare shops and copy a code.`);
const intro = `${withCode.length} audited partner shops issued a reader code to us that may be shown here. Codes are listed in order of audit score, not discount size. Our price tables always show prices before any code, so you can compare shops on the same basis.`;
const crumbs = [{ name: 'Home', url: '/' }, { name: 'Reader codes', url: '/discount-codes/' }];
const faqs = [
  { q: 'Are these codes verified?', a: 'Each code was issued to us by the shop through its affiliate program. We do not list codes we found elsewhere.' },
  { q: 'Why do some partner shops show "Reader code on review page"?', a: "Some shops' partner terms do not allow codes on a code page. For those shops the code appears only on their own review page." },
  { q: 'Do codes change your rankings?', a: 'No. Rankings use the audit score only. A code or commission never changes the score.' },
];
---
<BaseLayout title={title} description={description} crumbs={crumbs} jsonLd={faqSchema(faqs)}>
  <PageHero crumbs={crumbs} title={`Reader codes from audited partner shops (${YEAR})`} intro={intro} />
  <div class="wrap mt-12 space-y-14">
    <section class="space-y-4">
      <h2 class="h2">Partner shops by audit score</h2>
      <ul class="grid gap-4 md:grid-cols-2">
        {PARTNERS.map((p) => {
          const href = shopHref(p.slug);
          const c = codeInfo(p.slug);
          return (
            <li class="card p-5 flex flex-col gap-4">
              <div class="flex items-center gap-4">
                <ScoreRing score={p.overallScore} size={60} />
                <div>
                  <a href={`/vendors/${p.slug}/`} class="tap text-lg font-bold text-slate-900 hover:text-teal-800 hover:underline">{p.name}</a>
                  <div class="text-sm text-slate-600">{p.region} · audit score {p.overallScore.toFixed(1)} of 5</div>
                </div>
              </div>
              <div>
                {c.kind === 'code' && <CodeBadge slug={p.slug} size="md" />}
                {c.kind === 'on-review' && <a href={c.reviewUrl} class="text-link">Reader code on review page</a>}
                {c.kind === 'link-only' && <span class="text-slate-700">No code. Store link only.</span>}
              </div>
              <div class="mt-auto flex flex-wrap items-center gap-x-4 gap-y-2">
                {href && <a href={href} rel={REL_SPONSORED} target="_blank" class="btn-primary">Visit {shopShort(p.name)} <Icon name="external-link" class="w-4 h-4" /></a>}
                <a href={`/vendors/${p.slug}/#lab-reports`} class="text-link">See lab reports</a>
              </div>
            </li>
          );
        })}
      </ul>
    </section>
    <section class="prose-read">
      <h2>Other audited shops</h2>
      <p>{NON_PARTNERS.length} other audited shops have not issued a reader code to us. See each review for scores and lab reports:</p>
      <p>{NON_PARTNERS.map((v, i) => <>{i > 0 && ', '}<a href={`/vendors/${v.slug}/`}>{v.name}</a></>)}.</p>
    </section>
    <p class="text-slate-700 max-w-[70ch]">Looking for Peptide Sciences? It stopped selling in 2026: <a href="/vendors/peptide-sciences/" class="text-link">Peptide Sciences status and alternatives</a>.</p>
    <FAQ items={faqs} />
    <Disclosure />
  </div>
</BaseLayout>
