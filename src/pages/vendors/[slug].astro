---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Icon from '../../components/Icon.astro';
import ScoreRing from '../../components/ScoreRing.astro';
import SubscoreBars from '../../components/SubscoreBars.astro';
import FillChart from '../../components/FillChart.astro';
import CodeBadge from '../../components/CodeBadge.astro';
import VerifyBadge from '../../components/VerifyBadge.astro';
import CompareBox from '../../components/CompareBox.astro';
import FAQ from '../../components/FAQ.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import Disclosure from '../../components/Disclosure.astro';
import { VENDORS, type VendorProfile } from '../../data/vendors';
import { resolveVendorLink } from '../../data/affiliates';
import {
  VENDORS_BY_SCORE, isPartner, shopHref, productHref, REL_SPONSORED, codeInfo, alternativesFor, shopPairsFor, purityRange, fillRange,
  fillPct, money, perMg, mg, compoundShort, vendorVerify, listJoin, faqSchema, abs, CHECKED_LABEL, YEAR, SITE_NAME, SITE_URL,
  PRICE_COMPOUNDS, labKeyOf, shopShort, fitTitle, fitDesc, COMPOUND_PAIRS, pairSlug,
} from '../../lib/site';

export function getStaticPaths() {
  return VENDORS.map((vendor) => ({ params: { slug: vendor.slug }, props: { vendor } }));
}
interface Props {
  vendor: VendorProfile;
}
const { vendor: v } = Astro.props;
const partner = isPartner(v.slug);
const href = shopHref(v.slug);
const link = resolveVendorLink(v.slug);
const code = codeInfo(v.slug, true);
const rank = VENDORS_BY_SCORE.findIndex((x) => x.slug === v.slug) + 1;
const st = v.coaStats;
const labs = v.testingLabs.map((l) => l.replace(/\s*\(.*\)\s*$/, ''));
const reports = v.coaExamples;
const fillRows = reports.map((r) => ({
  label: `${compoundShort(r.compound)} ${r.labelMg ?? ''}${r.labelMg ? ' mg' : ''}`,
  sub: r.lab,
  labelMg: r.labelMg,
  measuredMg: r.measuredMg,
  verified: r.verifiable,
}));
const products = [...v.products].sort((a, b) => compoundShort(a.compound).localeCompare(compoundShort(b.compound)) || (a.vialMg ?? 0) - (b.vialMg ?? 0));
const currencies = Array.from(new Set(products.map((p) => p.currency)));
const alternatives = partner ? [] : alternativesFor(v, 3);
const pairs = shopPairsFor(v.slug);

const entityShort = v.legalEntity.split(/,|\s\(/)[0].trim().replace(/\.$/, '');
const joinWeak = (xs: string[]) => xs.map((w, i) => { const t = w.replace(/\.$/, ''); return i && /^[A-Z][a-z]/.test(t) ? t[0].toLowerCase() + t.slice(1) : t; }).join('; ');
const scoreTxt = `${v.overallScore.toFixed(1)} out of 5`;
const reportTxt = st.opened
  ? `We opened ${st.opened} of its lab reports; ${st.portalVerified} ${st.portalVerified === 1 ? 'was' : 'were'} verified on the lab's own portal${st.fillMinPct != null ? `, and measured content was ${fillRange(v)} of the label amount` : ''}.`
  : 'We found no public lab reports to open.';
const intro = `${v.name} scores ${scoreTxt} in our desk audit of ${CHECKED_LABEL} (rank ${rank} of ${VENDORS.length} shops). ${reportTxt} Legal entity: ${v.legalEntity === 'not published' ? 'not published' : entityShort}. ${products.length ? `We recorded ${products.length} listed prices.` : 'Prices are not published publicly.'}`;

const nm = shopShort(v.name);
const title = fitTitle(`${nm} Review: Legit? Lab Tests & Prices`, `${nm} Review: Lab Tests & Prices`, `${nm} Review`);
const h1 = `${v.name} review ${YEAR}: lab reports, prices and legitimacy checked`;
const description = fitDesc(
  `${nm} scores ${v.overallScore.toFixed(1)}/5 in our audit: ${st.opened} lab reports opened, ${st.portalVerified} portal-verified, legal entity and prices per mg. See lab reports.`,
  `${nm}: score ${v.overallScore.toFixed(1)}/5, ${st.opened} lab reports opened (${st.portalVerified} portal-verified), entity and price per mg. See lab reports.`,
  `${nm}: score ${v.overallScore.toFixed(1)}/5, ${st.opened} lab reports, price per mg. See lab reports.`,
);

const legitAnswer = [
  `${v.name} ${v.legalEntity === 'not published' ? 'does not publish a legal entity on its site' : `names its operator as ${v.legalEntity.replace(/\.$/, '')}`}.`,
  st.opened
    ? `${st.portalVerified} of ${st.opened} opened lab reports could be checked on the testing lab's own portal${st.portalVerified < st.opened ? `; ${st.opened - st.portalVerified} ${st.opened - st.portalVerified === 1 ? 'is' : 'are'} only hosted by the shop` : ''}.`
    : 'We could not find any public lab report.',
  v.weaknesses.length ? `What we could not verify or found lacking: ${joinWeak(v.weaknesses)}.` : '',
].filter(Boolean).join(' ');

const codeAnswer =
  code.kind === 'code'
    ? `Yes. ${v.name} issued the reader code ${code.code} to ${SITE_NAME}${code.note ? ` (${code.note})` : ''}. Our price tables show list prices without the code.`
    : code.kind === 'link-only'
      ? `${v.name} has not issued a reader code to us. We link to the shop through a partner link only.`
      : `No. ${v.name} is not a partner and has not issued a reader code to us. Partner shops with a code are compared on our discount code page.`;

const cheapest = products.filter((p) => p.pricePerMg != null).sort((a, b) => a.pricePerMg! - b.pricePerMg!)[0];

const faqs = [
  { q: `Is ${v.name} legit?`, a: `${legitAnswer} Overall audit score: ${scoreTxt}.` },
  { q: `Does ${v.name} have a coupon code?`, a: codeAnswer },
  {
    q: `Which labs test ${v.name} products?`,
    a: st.opened ? `The reports we opened name ${listJoin(Array.from(new Set(reports.map((r) => r.lab.replace(/\s*\(.*\)\s*$/, '')))))}. HPLC purity on those reports: ${purityRange(v)}.` : `${v.name} names ${labs.join(', ')}; we could not open a public report.`,
  },
  { q: `Where does ${v.name} ship?`, a: `Ships to: ${v.shipsTo}. Dispatch: ${v.dispatchSummary}.` },
  ...(cheapest
    ? [{ q: `How expensive is ${v.name}?`, a: `We recorded ${products.length} listed prices on ${CHECKED_LABEL}. The lowest price per mg was ${perMg(cheapest.pricePerMg, cheapest.currency)} for ${cheapest.shopProductName} (${mg(cheapest.vialMg)}). Prices are list prices without any code.` }]
    : []),
];

const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Shops', url: '/vendors/' },
  { name: v.name, url: `/vendors/${v.slug}/` },
];
const reviewSchema = {
  '@context': 'https://schema.org',
  '@type': 'Review',
  name: `${v.name} review ${YEAR}`,
  url: abs(`/vendors/${v.slug}/`),
  itemReviewed: { '@type': 'Organization', name: v.name, ...(v.legalEntity !== 'not published' ? { legalName: entityShort } : {}) },
  reviewRating: { '@type': 'Rating', ratingValue: v.overallScore.toFixed(1), bestRating: '5', worstRating: '0' },
  author: { '@type': 'Organization', name: 'PeptideLabIndex Editorial', url: `${SITE_URL}/methodology/` },
  publisher: { '@id': `${SITE_URL}/#organization` },
  datePublished: v.reviewedAt,
  dateModified: v.reviewedAt,
  reviewBody: v.verdictSummary,
};
const jsonLd = [reviewSchema, faqSchema(faqs)];

const compoundsHere = Array.from(new Set(products.map((p) => p.compound))).filter((c) => PRICE_COMPOUNDS.includes(c));
/** Compounds where this shop's best price per mg ranks best against the same-currency market (share of listings that are cheaper). */
const cheapRank = compoundsHere.map((c) => {
  const own = products.filter((p) => p.compound === c && p.pricePerMg != null).sort((a, b) => a.pricePerMg! - b.pricePerMg!)[0];
  if (!own) return null;
  const market = VENDORS.flatMap((x) => x.products).filter((p) => p.compound === c && p.currency === own.currency && p.pricePerMg != null);
  const cheaper = market.filter((p) => p.pricePerMg! < own.pricePerMg!).length;
  return { c, own, share: cheaper / Math.max(1, market.length) };
}).filter(Boolean).sort((a, b) => a!.share - b!.share || compoundShort(a!.c).localeCompare(compoundShort(b!.c))) as { c: string; own: (typeof products)[number]; share: number }[];
const pricePages = [...cheapRank.map((x) => x.c), ...compoundsHere.filter((c) => !cheapRank.some((x) => x.c === c))].slice(0, 6);
const comparePairs = COMPOUND_PAIRS.filter(([a, b]) => compoundsHere.includes(a) && compoundsHere.includes(b));
const related = [
  ...pairs.map(([a, b]) => {
    const other = VENDORS.find((x) => x.slug === (a === v.slug ? b : a))!;
    return { href: `/vendors/compare/${a}-vs-${b}/`, label: `${v.name} vs ${other.name}`, sub: 'Side-by-side audit data' };
  }),
  ...pricePages.map((c, i) => {
    const own = cheapRank.find((x) => x.c === c)?.own;
    return { href: `/prices/${c}/`, label: i % 2 ? `${compoundShort(c)} price comparison` : `${compoundShort(c)} prices at all shops`, sub: own ? `${nm} from ${perMg(own.pricePerMg, own.currency)}` : 'All audited shops compared' };
  }),
  ...comparePairs.map(([a, b]) => ({ href: `/compare/${pairSlug(a, b)}/`, label: `${compoundShort(a)} vs ${compoundShort(b)}`, sub: `${nm} lists both` })),
  ...Array.from(new Set(reports.map((r) => labKeyOf(r.lab)?.slug).filter(Boolean))).map((s) => ({ href: `/labs/${s}/`, label: `Lab guide: ${labKeyOf(reports.find((r) => labKeyOf(r.lab)?.slug === s)!.lab)!.name}`, sub: 'How to verify a report' })),
  { href: v.region === 'EU' ? '/vendors/europe/' : '/vendors/usa/', label: v.region === 'EU' ? 'EU shop ranking' : 'US shop ranking' },
];
---

<BaseLayout title={title} description={description} crumbs={crumbs} jsonLd={jsonLd} ogType="article">
  <section class="hero-bg border-b border-slate-200">
    <div class="wrap pt-7 pb-10 sm:pt-9">
      <Breadcrumbs items={crumbs} />
      <div class="mt-6 grid gap-8 lg:grid-cols-[1fr_20rem] items-start">
        <div>
          <div class="flex flex-wrap items-center gap-2 text-sm text-slate-700">
            <span class="chip bg-white ring-1 ring-slate-300 text-slate-800"><Icon name="map-pin" class="w-4 h-4" />{v.region} · {v.originCountry}</span>
            <VerifyBadge level={vendorVerify(v)} text={st.opened ? `${st.portalVerified} of ${st.opened} reports portal-verified` : undefined} />
            {partner ? <span class="chip bg-teal-50 text-teal-900 ring-1 ring-teal-300">Partner shop</span> : <span class="chip bg-slate-100 text-slate-700 ring-1 ring-slate-300">Not a partner</span>}
          </div>
          <h1 class="h1 mt-4">{h1}</h1>
          <p class="lead mt-4" data-answer>{intro}</p>
          <p class="mt-4 inline-flex items-center gap-1.5 text-sm text-slate-600"><Icon name="calendar" class="w-4 h-4" />Reviewed {CHECKED_LABEL} by PeptideLabIndex Editorial</p>
        </div>
        <aside class="card p-5 sm:p-6 flex flex-col gap-4">
          <div class="flex items-center gap-4">
            <ScoreRing score={v.overallScore} size={84} />
            <div>
              <div class="text-sm text-slate-600">Audit score</div>
              <div class="text-2xl font-extrabold text-slate-900">{v.overallScore.toFixed(1)} <span class="text-base font-semibold text-slate-600">/ 5</span></div>
              <div class="text-sm text-slate-700">Rank {rank} of {VENDORS.length}</div>
            </div>
          </div>
          {partner && code.kind !== 'none' && <CodeBadge slug={v.slug} onOwnPage size="md" />}
          {href ? (
            <>
              <a href={href} rel={REL_SPONSORED} target="_blank" class="btn-primary w-full">Visit {nm} <Icon name="external-link" class="w-4 h-4" /></a>
              <a href="#lab-reports" class="btn-ghost w-full">See lab reports</a>
              <p class="text-sm text-slate-600">Partner link (affiliate). It does not change the score.</p>
            </>
          ) : (
            <>
              <p class="text-[0.94rem] text-slate-700">We do not link to this shop. Compare partner shops with a store link below.</p>
              <a href="#alternatives" class="btn-ghost w-full">See audited alternatives</a>
            </>
          )}
        </aside>
      </div>
    </div>
  </section>

  <div class="wrap mt-12 space-y-16">
    <section class="grid gap-8 lg:grid-cols-2">
      <div>
        <h2 class="h2">Our verdict</h2>
        <p class="mt-3 text-slate-700 max-w-[68ch]">{v.verdictSummary}</p>
        {v.auditNotes && <p class="mt-3 text-slate-700 max-w-[68ch]">{v.auditNotes}</p>}
        <div class="mt-6 grid gap-4 sm:grid-cols-2">
          <div class="rounded-2xl border border-teal-200 bg-teal-50/50 p-4">
            <h3 class="font-bold text-slate-900 flex items-center gap-2"><Icon name="check-circle" class="w-5 h-5 text-teal-800" />Strengths</h3>
            <ul class="mt-2 space-y-2 text-[0.96rem] text-slate-800">
              {v.strengths.length ? v.strengths.map((s) => <li class="flex gap-2"><Icon name="check" class="w-4 h-4 mt-1 text-teal-800" />{s}</li>) : <li>none recorded</li>}
            </ul>
          </div>
          <div class="rounded-2xl border border-amber-200 bg-amber-50/50 p-4">
            <h3 class="font-bold text-slate-900 flex items-center gap-2"><Icon name="alert" class="w-5 h-5 text-amber-800" />Weaknesses</h3>
            <ul class="mt-2 space-y-2 text-[0.96rem] text-slate-800">
              {v.weaknesses.length ? v.weaknesses.map((s) => <li class="flex gap-2"><Icon name="minus" class="w-4 h-4 mt-1 text-amber-800" />{s}</li>) : <li>none recorded</li>}
            </ul>
          </div>
        </div>
      </div>
      <div class="card p-5 sm:p-6">
        <h2 class="h3">Score breakdown</h2>
        <p class="mt-1 text-sm text-slate-600">Each part is scored 0-5. The weight shows how much it counts. <a href="/methodology/" class="text-link">Method</a></p>
        <div class="mt-5"><SubscoreBars vendor={v} reasons /></div>
      </div>
    </section>

    <section id="legit" class="space-y-4">
      <h2 class="h2">Is {v.name} legit?</h2>
      <div class="prose-read">
        <p>We can only report what is public. Here is what we checked on {CHECKED_LABEL}:</p>
        <ul>
          <li><strong>Legal entity:</strong> {v.legalEntity.replace(/\.$/, '')}.</li>
          <li><strong>Lab reports:</strong> {st.opened ? `${st.opened} opened, ${st.portalVerified} found on the lab's own portal, ${st.opened - st.portalVerified} hosted by the shop only.` : 'no public lab reports found.'}</li>
          {st.fillMinPct != null && <li><strong>Measured vs label:</strong> {fillRange(v)} of the amount on the label (100% = exact).</li>}
          <li><strong>Purity on opened reports:</strong> {purityRange(v)}.</li>
          {v.weaknesses.length > 0 && <li><strong>What we could not verify or found lacking:</strong> {joinWeak(v.weaknesses)}.</li>}
        </ul>
        <p>We did not place a test order. A desk audit cannot confirm what an individual parcel contains.</p>
      </div>
    </section>

    <section id="facts" class="space-y-4">
      <h2 class="h2">Key facts</h2>
      <dl class="facts card px-5 sm:px-6 py-2 max-w-4xl">
        <div><dt>Legal entity</dt><dd>{v.legalEntity}</dd></div>
        <div><dt>Based in</dt><dd>{v.originCountry}</dd></div>
        <div><dt>Ships to</dt><dd>{v.shipsTo}</dd></div>
        <div><dt>Dispatch</dt><dd>{v.dispatchSummary}</dd></div>
        <div><dt>Free shipping from</dt><dd>{v.freeShippingThreshold}</dd></div>
        <div><dt>Payment</dt><dd>{v.paymentMethods.join(', ')}</dd></div>
        <div><dt>Labs named</dt><dd>{labs.join(', ')}</dd></div>
        <div><dt>Tests on reports</dt><dd>{v.panelBadges.length ? v.panelBadges.join(', ') : 'not published'}</dd></div>
        <div><dt>How reports are shared</dt><dd>{v.coaAccess || 'not published'}</dd></div>
      </dl>
    </section>

    <section id="lab-reports" class="space-y-5">
      <h2 class="h2">Lab reports we opened</h2>
      {reports.length ? (
        <>
          <p class="text-slate-700 max-w-[70ch]">{reports.length} {reports.length === 1 ? 'report' : 'reports'} opened on {CHECKED_LABEL}. Report links are shown as plain text so you can copy them and check the lab's site yourself.</p>
          <FillChart rows={fillRows} title={`${v.name}: measured content as % of label`} />
          <div class="table-wrap">
            <table class="data-table">
              <thead>
                <tr>
                  <th scope="col">Compound</th>
                  <th scope="col" class="num">Measured / label (mg)</th>
                  <th scope="col" class="num">Purity (%)</th>
                  <th scope="col">Lab and test date</th>
                  <th scope="col">Verification</th>
                  <th scope="col">Report ID and link (copy)</th>
                </tr>
              </thead>
              <tbody>
                {reports.map((r) => {
                  const fp = fillPct(r);
                  return (
                    <tr>
                      <td class="min-w-[9rem]"><span class="font-semibold text-slate-900">{compoundShort(r.compound)}</span><span class="sub">{r.shopProductName}</span></td>
                      <td class="num">{r.measuredMg != null && r.labelMg != null ? `${r.measuredMg} / ${r.labelMg}` : 'not stated'}{fp != null && <span class="sub">{fp.toFixed(1)}% of label</span>}</td>
                      <td class="num">{r.purityPercent != null ? r.purityPercent : 'n/a'}</td>
                      <td class="min-w-[10rem]">{r.lab}<span class="sub">{r.testDate || 'date not published'}</span></td>
                      <td>{r.verifiable ? 'Portal-verified' : 'Shop-hosted'}</td>
                      <td class="min-w-[16rem] max-w-[22rem]">{r.reportId && <code class="font-mono text-sm text-slate-900">{r.reportId}</code>}<span class="sub mono-url">{r.url}</span></td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </>
      ) : (
        <p class="text-slate-700 max-w-[70ch]">We found no public lab report for {v.name} on {CHECKED_LABEL}.</p>
      )}
    </section>

    <section id="prices" class="space-y-5">
      <h2 class="h2">{v.name} prices</h2>
      {products.length ? (
        <>
          <p class="text-slate-700 max-w-[70ch]">{products.length} listed prices recorded on {CHECKED_LABEL} in {currencies.join(' and ')}. Price per mg = price divided by the mg on the label. Sale prices are shown with the old price struck through. No code is applied.</p>
          <div class="table-wrap">
            <table class="data-table" data-sortable>
              <thead>
                <tr>
                  <th scope="col"><button type="button" class="sort-btn" data-sort-type="text">Product <Icon name="arrow-up-down" class="w-3.5 h-3.5" /></button></th>
                  <th scope="col" class="num"><button type="button" class="sort-btn" data-sort-type="num">Vial (mg) <Icon name="arrow-up-down" class="w-3.5 h-3.5" /></button></th>
                  <th scope="col" class="num"><button type="button" class="sort-btn" data-sort-type="num">Price <Icon name="arrow-up-down" class="w-3.5 h-3.5" /></button></th>
                  <th scope="col" class="num"><button type="button" class="sort-btn" data-sort-type="num">Price per mg <Icon name="arrow-up-down" class="w-3.5 h-3.5" /></button></th>
                  <th scope="col">Lab report opened</th>
                  {partner && <th scope="col">Store</th>}
                </tr>
              </thead>
              <tbody>
                {products.map((p) => {
                  const onSale = p.salePrice != null && p.price != null && p.salePrice < p.price;
                  const price = p.salePrice ?? p.price;
                  const rep = reports.find((r) => r.compound === p.compound && r.labelMg === p.vialMg) || reports.find((r) => r.compound === p.compound);
                  const ph = productHref(v.slug, p.url);
                  return (
                    <tr>
                      <td data-v={p.shopProductName} class="min-w-[11rem]">
                        {PRICE_COMPOUNDS.includes(p.compound) ? <a href={`/prices/${p.compound}/`} class="font-semibold text-slate-900 hover:text-teal-800 hover:underline">{compoundShort(p.compound)}</a> : <span class="font-semibold text-slate-900">{compoundShort(p.compound)}</span>}
                        <span class="sub">{p.shopProductName}{p.inStock === false ? ' (out of stock)' : ''}</span>
                      </td>
                      <td class="num" data-v={p.vialMg ?? ''}>{p.vialMg ?? 'n/a'}</td>
                      <td class="num" data-v={price ?? ''}>{money(price, p.currency)}{onSale && <span class="sub"><s>{money(p.price, p.currency)}</s></span>}</td>
                      <td class="num font-semibold" data-v={p.pricePerMg ?? ''}>{perMg(p.pricePerMg, p.currency)}</td>
                      <td>{rep ? (rep.verifiable ? 'Yes, portal-verified' : 'Yes, shop-hosted') : 'No'}</td>
                      {partner && <td>{ph && <a href={ph} rel={REL_SPONSORED} target="_blank" class="text-link whitespace-nowrap">View product</a>}</td>}
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </>
      ) : (
        <p class="text-slate-700 max-w-[70ch]">{v.name} does not publish prices publicly, so value per mg was not scored.</p>
      )}
    </section>

    <section id="coupon" class="space-y-4">
      <h2 class="h2">{v.name} coupon code</h2>
      {code.kind === 'code' && (
        <div class="card p-5 sm:p-6 max-w-3xl space-y-4">
          <p class="text-slate-700">{v.name} issued this reader code to {SITE_NAME}. Enter it at checkout. Our price tables show prices before the code.</p>
          <CodeBadge slug={v.slug} onOwnPage size="md" />
          {href && <div><a href={href} rel={REL_SPONSORED} target="_blank" class="btn-primary">Visit {nm} <Icon name="external-link" class="w-4 h-4" /></a></div>}
        </div>
      )}
      {code.kind === 'link-only' && (
        <p class="text-slate-700 max-w-[70ch]">{v.name} has not issued a reader code to us. We link to the shop with a partner link only. <a href="/discount-codes/" class="text-link">Shops that did issue a code</a></p>
      )}
      {code.kind === 'none' && (
        <p class="text-slate-700 max-w-[70ch]">No reader code. {v.name} is not a partner and has not issued a code to us. <a href="/discount-codes/" class="text-link">Compare shops with a code</a></p>
      )}
    </section>

    {alternatives.length > 0 && (
      <div id="alternatives">
        <CompareBox shops={alternatives} note={`Partner shops in the ${v.region} with the highest audit scores. Same method as ${v.name}.`} />
      </div>
    )}

    <FAQ items={faqs} />

    <section class="space-y-3">
      <h2 class="h3">Sources we read</h2>
      <p class="text-sm text-slate-600">Public pages read on {CHECKED_LABEL}. Shown as plain text, not links.</p>
      <ul class="space-y-1 max-w-4xl">
        {v.sources.map((s) => <li class="mono-url">{s}</li>)}
      </ul>
    </section>

    <RelatedLinks links={related} />
    <Disclosure />
  </div>
  {href && (
    <div class="sticky-cta lg:hidden" role="region" aria-label={`${nm} store link`}>
      <div class="min-w-0 flex-1 leading-tight">
        <div class="font-bold text-slate-900 truncate">{nm}</div>
        {code.kind === 'code' ? (
          <button type="button" data-copy={code.code} class="min-h-[32px] text-left text-sm text-slate-700 whitespace-nowrap" aria-label={`Copy code ${code.code}`}>Code <code class="font-mono font-bold text-teal-900 underline underline-offset-2">{code.code}</code>{code.percent ? ` · ${code.percent}%` : ''}</button>
        ) : <div class="text-sm text-slate-600">Score {v.overallScore.toFixed(1)} / 5</div>}
      </div>
      <a href={href} rel={REL_SPONSORED} target="_blank" class="btn-primary shrink-0">Visit shop <Icon name="external-link" class="w-4 h-4" /></a>
    </div>
  )}
</BaseLayout>
