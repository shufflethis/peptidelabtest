---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { VENDORS, type VendorProfile } from '../../data/vendors';
import { resolveVendorLink } from '../../data/affiliates';
import { getComputedBatches } from '../../data/batches';

export function getStaticPaths() {
  return VENDORS.map((vendor) => ({
    params: { slug: vendor.slug },
    props: { vendor },
  }));
}

interface Props {
  vendor: VendorProfile;
}

const { vendor } = Astro.props;
const linkInfo = resolveVendorLink(vendor.slug);
const vendorBatches = getComputedBatches().filter((b) => b.vendorSlug === vendor.slug);

const topAlternatives = VENDORS.filter(
  (v) => v.slug !== vendor.slug && (vendor.region === 'GLOBAL' || v.region === vendor.region) && v.overallScore >= 3.6
).slice(0, 2);

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: `Is ${vendor.name} legit and lab-verified in 2026?`,
      acceptedAnswer: {
        '@type': 'Answer',
        text: `${vendor.name} scores ${vendor.overallScore.toFixed(1)}/5.0 in the 2026 PeptideLabIndex audit. ${vendor.verdictSummary}`,
      },
    },
    {
      '@type': 'Question',
      name: `Which third-party laboratory tests ${vendor.name} vials?`,
      acceptedAnswer: {
        '@type': 'Answer',
        text: `Audited testing laboratory records list: ${vendor.testingLabs.join(', ')}. Fill-weight audit summary: ${vendor.fillVarianceNote}.`,
      },
    },
    {
      '@type': 'Question',
      name: `Does ${vendor.name} have an active discount code?`,
      acceptedAnswer: {
        '@type': 'Answer',
        text: linkInfo.promoCode
          ? `Yes, partner code ${linkInfo.promoCode} provides ${linkInfo.discountPercent}% off (${linkInfo.discountNote}).`
          : `No verified partner discount code is currently issued for ${vendor.name}.`,
      },
    },
  ],
};

const title = `${vendor.name} Review 2026: Is It Legit? COA Audit${linkInfo.promoCode ? ' & Promo Code' : ''}`;
const desc = `${vendor.name} 2026 COA audit (${vendor.overallScore.toFixed(1)}/5.0): ${vendor.puritySummary}. Lab verification, measured fill variance, weaknesses${linkInfo.promoCode ? ` & code ${linkInfo.promoCode}` : ''}.`;
---

<BaseLayout title={title} description={desc} jsonLd={faqSchema}>
  <article class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pt-12 space-y-10">
    <!-- Breadcrumbs -->
    <nav class="text-xs font-mono text-slate-400">
      <a href="/" class="hover:text-cyan-400">Home</a> / <a href="/vendors/" class="hover:text-cyan-400">Vendors</a> / <span class="text-slate-200">{vendor.name}</span>
    </nav>

    <!-- Above-the-Fold Audit Summary Card -->
    <div class="glass-card rounded-2xl p-6 sm:p-8 space-y-6">
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div class="space-y-2">
          <div class="flex flex-wrap items-center gap-2 font-mono text-xs">
            <span class="px-2.5 py-0.5 rounded bg-slate-800 text-slate-200 border border-slate-700">
              Rank #{vendor.rank} of 22
            </span>
            <span class="px-2.5 py-0.5 rounded bg-slate-900 text-cyan-300 border border-slate-800">
              {vendor.countryFlag} {vendor.originCountry}
            </span>
          </div>
          <h1 class="text-3xl sm:text-5xl font-black text-white">{vendor.name} Audit &amp; COA Review</h1>
        </div>

        <div class="px-5 py-3 rounded-2xl bg-slate-950 border border-cyan-500/40 text-right font-mono">
          <div class="text-3xl font-black text-cyan-400">★ {vendor.overallScore.toFixed(1)} <span class="text-sm text-slate-400">/ 5.0</span></div>
          <div class="text-[11px] uppercase tracking-wider text-slate-400">6-Axis Lab Score</div>
        </div>
      </div>

      <!-- 45-Word Featured Snippet Verdict -->
      <p class="text-base text-slate-200 leading-relaxed border-l-4 border-cyan-400 pl-4 bg-slate-950/60 py-3 pr-4 rounded-r-xl">
        <strong>Direct Audit Verdict:</strong> {vendor.verdictSummary}
      </p>

      <!-- Promo & Outbound Action Strip -->
      <div class="flex flex-wrap items-center justify-between gap-4 p-4 rounded-xl bg-slate-950 border border-slate-800">
        {linkInfo.promoCode ? (
          <div class="flex flex-wrap items-center gap-3">
            <span class="text-xs font-mono text-emerald-400 font-bold uppercase">Verified Partner Code:</span>
            <button
              type="button"
              data-copy-code={linkInfo.promoCode}
              class="px-3.5 py-1.5 rounded-lg bg-emerald-500/15 border border-emerald-500/40 text-emerald-300 font-mono text-sm font-bold hover:bg-emerald-500/25 cursor-pointer"
            >
              {linkInfo.promoCode} — {linkInfo.discountNote} (Click to Copy)
            </button>
          </div>
        ) : (
          <span class="text-xs font-mono text-slate-400">
            Independent Editorial Review · No commercial code active for this storefront
          </span>
        )}

        {linkInfo.isSponsored && (

          <a
          href={linkInfo.href}
          rel={linkInfo.rel}
          target="_blank"
          class="px-5 py-2.5 rounded-xl bg-gradient-to-r from-cyan-500 to-emerald-400 text-slate-950 font-mono font-bold text-xs hover:opacity-95"
        >
          Visit {vendor.name} &rarr;
        </a>

        )}
      </div>
    </div>

    <!-- 6-Axis Algorithmic Breakdown + Metadata -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="glass-card rounded-2xl p-6 space-y-4">
        <h2 class="text-lg font-extrabold text-white">6-Axis Score Breakdown</h2>
        {[
          { label: 'Lab Portal Verification (30%)', val: vendor.scores.labVerification },
          { label: 'Net Fill Accuracy mg (20%)', val: vendor.scores.fillAccuracy },
          { label: 'Analytical Panel Depth (20%)', val: vendor.scores.panelDepth },
          { label: 'Corporate Entity Transparency (15%)', val: vendor.scores.entityTransparency },
          { label: 'Dispatch & Customs Reliability (10%)', val: vendor.scores.dispatchReliability },
          { label: 'True $/mg Value (5%)', val: vendor.scores.valuePerMg },
        ].map((item) => (
          <div class="space-y-1">
            <div class="flex justify-between text-xs font-mono">
              <span class="text-slate-300">{item.label}</span>
              <span class="text-cyan-400 font-bold">{item.val < 0 ? 'n/a (prices not public)' : `${item.val.toFixed(1)} / 5.0`}</span>
            </div>
            <div class="h-2 rounded-full bg-slate-900 overflow-hidden">
              <div class="h-full bg-gradient-to-r from-cyan-500 to-emerald-400" style={`width: ${(Math.max(0, item.val) / 5) * 100}%`} />
            </div>
          </div>
        ))}
      </div>

      <div class="glass-card rounded-2xl p-6 space-y-3 text-xs font-mono">
        <h2 class="text-lg font-sans font-extrabold text-white">Supplier Specifications</h2>
        <div class="py-2 border-b border-slate-800">
          <span class="text-slate-400 block">Corporate Entity:</span>
          <span class="text-slate-100">{vendor.legalEntity}</span>
        </div>
        <div class="py-2 border-b border-slate-800">
          <span class="text-slate-400 block">Issuing Testing Labs:</span>
          <span class="text-cyan-300">{vendor.testingLabs.join(' · ')}</span>
        </div>
        <div class="py-2 border-b border-slate-800">
          <span class="text-slate-400 block">Purity &amp; Fill Audit:</span>
          <span class="text-slate-100">{vendor.puritySummary} ({vendor.fillVarianceNote})</span>
        </div>
        <div class="py-2 border-b border-slate-800">
          <span class="text-slate-400 block">Shipping &amp; Thresholds:</span>
          <span class="text-slate-100">{vendor.dispatchSummary} · {vendor.freeShippingThreshold}</span>
        </div>
        <div class="py-2">
          <span class="text-slate-400 block">Payment Rails:</span>
          <span class="text-slate-100">{vendor.paymentMethods.join(', ')}</span>
        </div>
      </div>
    </div>

    <!-- Strengths vs Documented Weaknesses -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="glass-card rounded-2xl p-6 border-emerald-500/30 space-y-3">
        <h2 class="text-lg font-extrabold text-emerald-400">✓ Verified Strengths</h2>
        <ul class="space-y-2 text-sm text-slate-300">
          {vendor.strengths.map((s) => (
            <li class="flex gap-2"><span class="text-emerald-400 font-bold">+</span><span>{s}</span></li>
          ))}
        </ul>
      </div>

      <div class="glass-card rounded-2xl p-6 border-rose-500/30 space-y-3">
        <h2 class="text-lg font-extrabold text-rose-400">⚠ Documented Weaknesses &amp; Caveats</h2>
        <ul class="space-y-2 text-sm text-slate-300">
          {vendor.weaknesses.map((w) => (
            <li class="flex gap-2"><span class="text-rose-400 font-bold">−</span><span>{w}</span></li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Batch Pricing Rows if present -->
    {vendorBatches.length > 0 && (
      <div class="glass-card rounded-2xl p-6 space-y-4">
        <h2 class="text-xl font-extrabold text-white">Benchmarked Batches &amp; True $/mg</h2>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs font-mono">
            <thead>
              <tr class="border-b border-slate-800 text-slate-400">
                <th class="py-2">Compound</th>
                <th class="py-2">Label vs COA mg</th>
                <th class="py-2">HPLC Purity</th>
                <th class="py-2">True Cost/mg</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-800/70">
              {vendorBatches.map((b) => (
                <tr>
                  <td class="py-2.5 text-white font-bold">{b.compoundName}</td>
                  <td class="py-2.5 text-slate-300">{b.labelMg} mg &rarr; {b.measuredMg} mg ({b.variancePercent >= 0 ? '+' : ''}{b.variancePercent}%)</td>
                  <td class="py-2.5 text-cyan-300">{b.purityPercent}% ({b.labName})</td>
                  <td class="py-2.5 text-emerald-400 font-bold">{b.currency === 'USD' ? '$' : '€'}{b.trueMeasuredCostPerMg == null ? "n/a" : b.trueMeasuredCostPerMg.toFixed(2)}/mg</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    )}

    <!-- Conversion Routing Box when viewing lower-rated vendors -->
    {vendor.overallScore < 3.5 && topAlternatives.length > 0 && (
      <div class="glass-card rounded-2xl p-6 border border-cyan-400/40 space-y-4">
        <h2 class="text-xl font-extrabold text-white">
          🛡️ Higher-Scored Domestic Alternatives ({vendor.region === 'EU' ? 'EU No-Customs' : 'US Domestic'})
        </h2>
        <p class="text-xs text-slate-300">
          Because {vendor.name} scored {vendor.overallScore.toFixed(1)}/5.0 due to the caveats documented above, researchers in the same shipping zone often compare these top-ranked lab-verified suppliers:
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {topAlternatives.map((alt) => {
            const altLink = resolveVendorLink(alt.slug);
            return (
              <div class="p-4 rounded-xl bg-slate-950 border border-slate-800 flex flex-col justify-between gap-3">
                <div>
                  <div class="flex justify-between items-center">
                    <a href={`/vendors/${alt.slug}/`} class="font-bold text-white hover:text-cyan-400">{alt.name}</a>
                    <span class="font-mono text-xs text-emerald-400 font-bold">★ {alt.overallScore.toFixed(1)}/5.0</span>
                  </div>
                  <p class="text-xs text-slate-400 mt-1">{alt.puritySummary}</p>
                </div>
                <div class="flex items-center justify-between gap-2 pt-2 border-t border-slate-800 font-mono text-xs">
                  {altLink.promoCode && !altLink.codeOnlyOnVendorPage ? (
                    <button type="button" data-copy-code={altLink.promoCode} class="text-emerald-300 hover:underline cursor-pointer">
                      Code: {altLink.promoCode} (-{altLink.discountPercent}%)
                    </button>
                  ) : <span />}
                  {altLink.isSponsored && (
                    <a href={altLink.href} rel={altLink.rel} target="_blank" class="px-3 py-1.5 rounded bg-cyan-500 text-slate-950 font-bold">
                    Visit Lab &rarr;
                  </a>
                  )}
                </div>
              </div>
            );
          })}
        </div>
      </div>
    )}

    <!-- FAQ Section -->
    <div class="glass-card rounded-2xl p-6 space-y-4">
      <h2 class="text-xl font-extrabold text-white">Frequently Asked Questions: {vendor.name}</h2>
      <div class="space-y-4 text-sm">
        <div>
          <h3 class="font-bold text-slate-100">Is {vendor.name} legit and lab-verified in 2026?</h3>
          <p class="text-slate-400 mt-1">{vendor.auditNotes} {vendor.verdictSummary}</p>
        </div>
        <div>
          <h3 class="font-bold text-slate-100">Which third-party laboratory tests {vendor.name} batches?</h3>
          <p class="text-slate-400 mt-1">Published documentation cites {vendor.testingLabs.join(', ')}. Fill-weight audit summary: {vendor.fillVarianceNote}.</p>
        </div>
      </div>
    </div>
  </article>
</BaseLayout>
