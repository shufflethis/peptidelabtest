---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CompareBox from '../../components/CompareBox.astro';
import FAQ from '../../components/FAQ.astro';
import Disclosure from '../../components/Disclosure.astro';
import { partnersIn, CHECKED_LABEL, faqSchema } from '../../lib/site';

const us = partnersIn('US').slice(0, 3);
const eu = partnersIn('EU').slice(0, 3);
const crumbs = [{ name: 'Home', url: '/' }, { name: 'Shops', url: '/vendors/' }, { name: 'Peptide Sciences', url: '/vendors/peptide-sciences/' }];
const intro = `Peptide Sciences (peptidesciences.com) stopped selling research products in March 2026. Its own site states that it "voluntarily discontinued all research-use-only product sales in March 2026" and has not authorised any third party to sell on its behalf or act as a successor. We did not audit Peptide Sciences because it no longer sells.`;
const faqs = [
  { q: 'Is Peptide Sciences still open?', a: 'No. peptidesciences.com states that the company voluntarily discontinued all research-use-only product sales in March 2026.' },
  { q: 'Is a new Peptide Sciences website the same company?', a: 'The notice on peptidesciences.com says the company has not authorised any third party to operate a replacement website, act as a successor or sell on its behalf. We cannot confirm any link between other sites using the name and the original company.' },
  { q: 'Which audited shops can I compare instead?', a: `Our shop ranking lists partner shops by audit score. The highest-scoring US partner shops are ${us.map((v) => v.name).join(', ')}.` },
];
---
<BaseLayout title="Peptide Sciences Shut Down (2026): Status and Audited Shops" description="Peptide Sciences stopped selling research products in March 2026. What its own notice says, and audited shops to compare instead." crumbs={crumbs} jsonLd={faqSchema(faqs)}>
  <PageHero crumbs={crumbs} title="Peptide Sciences shut down: status in 2026" intro={intro} />
  <div class="wrap mt-12 space-y-14">
    <section class="prose-read">
      <h2>What the notice says</h2>
      <ul>
        <li>Sales of research-use-only products were discontinued in March 2026 (the company calls it voluntary).</li>
        <li>No third party is authorised to sell on its behalf, run a replacement website or claim to be its successor.</li>
        <li>The company asks readers to beware of websites or sellers impersonating it.</li>
      </ul>
      <p>Source (plain text): <span class="mono-url">https://peptidesciences.com/pages/terms-of-service</span>, read {CHECKED_LABEL}.</p>
      <h2>What this means for comparing shops</h2>
      <p>Because Peptide Sciences no longer sells, it has no score on this site. If you are comparing research peptide shops, the boxes below show the highest-scoring audited partner shops in each region. Every shop on this site is scored with the <a href="/methodology/">same method</a>.</p>
    </section>
    <CompareBox shops={us} title="Audited US shops with a store link" note="Partner shops ranked by audit score." />
    <CompareBox shops={eu} title="Audited EU shops with a store link" note="Partner shops ranked by audit score." />
    <FAQ items={faqs} />
    <Disclosure />
  </div>
</BaseLayout>
