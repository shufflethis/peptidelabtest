---
import BaseLayout from '../../layouts/BaseLayout.astro';
import VendorCard from '../../components/VendorCard.astro';
import { VENDORS } from '../../data/vendors';

const topReplacements = VENDORS.filter((v) =>
  ['real-peptides', 'arctic-lab-supply', 'certa-peptides', 'particle-peptides'].includes(v.slug)
);
---

<BaseLayout
  title="Peptide Sciences Shut Down (2026): What Happened & Verified Alternatives"
  description="Peptide Sciences voluntarily ceased operations in March 2026. Beware copycat domains—compare top third-party COA-verified US & EU replacement suppliers."
>
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-12 space-y-10">
    <nav class="text-xs font-mono text-slate-400">
      <a href="/" class="hover:text-cyan-400">Home</a> / <a href="/vendors/" class="hover:text-cyan-400">Vendors</a> / <span class="text-amber-300">Peptide Sciences Archive</span>
    </nav>

    <div class="glass-card rounded-2xl p-6 sm:p-8 border border-amber-500/40 space-y-4">
      <span class="inline-block px-3 py-1 rounded-full bg-amber-500/15 border border-amber-500/40 text-amber-300 font-mono text-xs font-bold">
        ⚠️ ARCHIVED VENDOR NOTICE — OPERATIONS CEASED MARCH 2026
      </span>
      <h1 class="text-3xl sm:text-5xl font-black text-white">
        Peptide Sciences 2026 Shutdown: Closure Report &amp; Verified Replacements
      </h1>
      <p class="text-base text-slate-300 leading-relaxed">
        By early March 2026, longtime US vendor <strong>Peptide Sciences</strong> posted a voluntary operational closure notice and ceased accepting orders. Multiple unrelated lookalike domains have since registered similar names to capture legacy search traffic—exercise extreme caution against clone storefronts.
      </p>
      <div class="p-4 rounded-xl bg-slate-950 border border-slate-800 text-xs font-mono text-slate-300 space-y-1.5">
        <div><strong class="text-white">Why Researchers Upgraded Standards in 2026:</strong> Legacy Peptide Sciences listings relied on self-issued in-house PDFs rather than portal-verifiable third-party laboratories, while charging 2×–3× higher $/mg prices than modern Kovera, ILS, or Janoshik-verified suppliers.</div>
      </div>
    </div>

    <div class="space-y-4">
      <h2 class="text-2xl sm:text-3xl font-black text-white">
        Top Portal-Verified US &amp; EU Alternatives (2026)
      </h2>
      <p class="text-sm text-slate-400">
        Every supplier below publishes independently verifiable third-party HPLC + LC-MS + net milligram certificates resolving directly on the testing laboratory’s portal:
      </p>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 pt-2">
        {topReplacements.map((v) => (
          <VendorCard vendor={v} />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
