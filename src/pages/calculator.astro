---
import BaseLayout from '../layouts/BaseLayout.astro';
import ReconstitutionCalculator from '../components/ReconstitutionCalculator.astro';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'How do U-100 syringe units convert to milliliters (ml)?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'On any standard U-100 syringe (30 IU, 50 IU, or 100 IU barrel), 100 IU equals 1.0 ml, so 1 IU equals exactly 0.01 ml.',
      },
    },
    {
      '@type': 'Question',
      name: 'Why should I enter the COA measured mg instead of the label mg?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Lyophilized research vials routinely test between -10% below and +20% above label claims on third-party HPLC assays. Using the exact COA milligram weight yields accurate stock concentrations.',
      },
    },
  ],
};
---

<BaseLayout
  title="Peptide & Blend Reconstitution Calculator (U-100 Visual Scale & COA Mass)"
  description="Free peptide and dual-blend reconstitution calculator with visual U-100 syringe scale (0.3ml, 0.5ml, 1.0ml) and third-party COA measured milligram override."
  jsonLd={faqSchema}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-12 space-y-10">
    <div class="max-w-3xl space-y-3">
      <nav class="text-xs font-mono text-slate-400">
        <a href="/" class="hover:text-cyan-400">Home</a> / <span class="text-slate-200">Blend &amp; U-100 Calculator</span>
      </nav>
      <h1 class="text-3xl sm:text-5xl font-black text-white">
        Peptide &amp; Dual-Blend Reconstitution Calculator
      </h1>
      <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
        Supports both single lyophilized vials and co-lyophilized blends (such as BPC-157 + TB-500 or CJC-1295 + Ipamorelin), with optional COA-measured milligram adjustment and visual U-100 scale verification.
      </p>
    </div>

    <ReconstitutionCalculator />
  </div>
</BaseLayout>
