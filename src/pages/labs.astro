---
import BaseLayout from '../layouts/BaseLayout.astro';
import { TESTING_LABS } from '../data/labs';
---

<BaseLayout
  title="Third-Party Peptide Testing Laboratories (Janoshik, Liquilabs, Kovera, ILS)"
  description="Directory of independent analytical laboratories issuing verifiable HPLC purity, LC-MS identity, net content, endotoxin, and sterility COAs for research peptides."
>
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-12 space-y-8">
    <div class="max-w-3xl space-y-3">
      <nav class="text-xs font-mono text-slate-400">
        <a href="/" class="hover:text-cyan-400">Home</a> / <span class="text-slate-200">Testing Laboratories</span>
      </nav>
      <h1 class="text-3xl sm:text-5xl font-black text-white">
        Independent Peptide Analytical Laboratories
      </h1>
      <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
        A Certificate of Analysis only carries evidentiary weight when issued by a traceable third-party analytical facility and verifiable on that laboratory’s own server.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {TESTING_LABS.map((lab) => (
        <article class="glass-card rounded-2xl p-6 space-y-4">
          <div class="flex justify-between items-start gap-2">
            <div>
              <h2 class="text-xl font-extrabold text-white">{lab.name}</h2>
              <span class="text-xs font-mono text-cyan-400">{lab.location}</span>
            </div>
            <span class="text-[11px] font-mono text-slate-400 break-all">{lab.portalUrl.replace(/^https?:\/\//, '')}</span>
          </div>
          <p class="text-xs text-slate-300 leading-relaxed">{lab.accreditationNote}</p>
          <div class="text-xs font-mono text-slate-400">
            <strong class="text-slate-200">Verification Mechanism:</strong> {lab.verificationMethod}
          </div>
          <div class="flex flex-wrap gap-1.5">
            {lab.methodsOffered.map((m) => (
              <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-slate-950 border border-slate-800 text-emerald-300">{m}</span>
            ))}
          </div>
          <div class="pt-3 border-t border-slate-800 text-xs font-mono text-slate-400">
            <strong class="text-slate-200">Audited Vendors Using Lab:</strong> {lab.vendorsUsing.join(', ')}
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
