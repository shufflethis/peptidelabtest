---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Disclosure from '../../components/Disclosure.astro';
import Icon from '../../components/Icon.astro';
import FAQ from '../../components/FAQ.astro';
import {
  PRICE_COMPOUNDS, offersFor, compoundShort, shopsCarrying, sizesFor, sizePagesFor, reportsFor, cheapestBy, perMg, TOTALS,
  CHECKED_LABEL, SIZE_PAGES, itemListSchema, faqSchema, getCompound, fitDesc,
} from '../../lib/site';

const rows = PRICE_COMPOUNDS.map((c) => {
  const offers = offersFor(c);
  return {
    slug: c,
    name: compoundShort(c),
    category: getCompound(c)?.category || 'Research compound',
    shops: shopsCarrying(c).length,
    listings: offers.length,
    sizes: sizesFor(c),
    sizePages: sizePagesFor(c),
    eur: cheapestBy(offers, 'EUR'),
    usd: cheapestBy(offers, 'USD'),
    reports: reportsFor(c).length,
  };
}).sort((a, b) => b.shops - a.shops);

const title = 'Research Peptide Prices 2026: Price per mg by Shop';
const description = fitDesc(`Price per mg for ${rows.length} research compounds at ${TOTALS.shops} audited shops, EUR and USD separate, with lab-report coverage. Compare prices by compound.`);
const intro = `We recorded ${TOTALS.products} listed prices for ${rows.length} research compounds at ${TOTALS.shops} audited EU and US shops on ${CHECKED_LABEL}. Each compound page splits EUR and USD prices, shows price per mg by vial size and marks which shops published a lab report we opened (${TOTALS.reportsOpened} reports in total).`;
const crumbs = [{ name: 'Home', url: '/' }, { name: 'Prices', url: '/prices/' }];
const faqs = [
  { q: 'How is price per mg calculated?', a: 'Listed price (the sale price where a shop shows one) divided by the label amount in mg of that vial. Discount codes are not applied and currencies are not converted.' },
  { q: 'Why are EUR and USD prices not compared directly?', a: 'Shops list prices in their own currency. We show EUR and USD in separate tables and charts instead of converting, so every figure matches what the shop listed.' },
  { q: 'How current are the prices?', a: `All prices were read from public shop pages or store APIs on ${CHECKED_LABEL}. Shops change prices often; check the shop before ordering.` },
];
const jsonLd = [
  itemListSchema('Research compound price comparisons', rows.map((r) => ({ name: `${r.name} price comparison`, url: `/prices/${r.slug}/` }))),
  faqSchema(faqs),
];
---

<BaseLayout title={title} description={description} crumbs={crumbs} jsonLd={jsonLd}>
  <PageHero crumbs={crumbs} title="Research Peptide Price Comparison 2026" eyebrow={`${rows.length} compounds · ${SIZE_PAGES.length} vial-size pages`} intro={intro}>
    <div class="mt-6 grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-6 gap-2.5" aria-label="Pick a compound">
      {rows.map((r) => (
        <a href={`/prices/${r.slug}/`} class="card card-hover px-3.5 py-2.5 min-h-[44px]">
          <span class="block font-bold text-slate-900">{r.name}</span>
          <span class="block text-sm text-slate-600">{r.shops} shops</span>
        </a>
      ))}
    </div>
  </PageHero>

  <div class="wrap mt-10 space-y-12">
    <section class="space-y-4">
      <h2 class="h2">Lowest price per mg by compound</h2>
      <div class="table-wrap">
        <table class="data-table" data-sortable>
          <thead>
            <tr>
              <th><button type="button" class="sort-btn" data-sort-type="text">Compound <Icon name="arrow-up-down" class="w-3 h-3" /></button></th>
              <th class="num"><button type="button" class="sort-btn" data-sort-type="num">Shops <Icon name="arrow-up-down" class="w-3 h-3" /></button></th>
              <th class="num"><button type="button" class="sort-btn" data-sort-type="num">Listings <Icon name="arrow-up-down" class="w-3 h-3" /></button></th>
              <th>Vial sizes</th>
              <th class="num"><button type="button" class="sort-btn" data-sort-type="num">Lowest price per mg (€) <Icon name="arrow-up-down" class="w-3 h-3" /></button></th>
              <th class="num"><button type="button" class="sort-btn" data-sort-type="num">Lowest price per mg ($) <Icon name="arrow-up-down" class="w-3 h-3" /></button></th>
              <th class="num"><button type="button" class="sort-btn" data-sort-type="num">Reports opened <Icon name="arrow-up-down" class="w-3 h-3" /></button></th>
            </tr>
          </thead>
          <tbody>
            {rows.map((r) => (
              <tr>
                <td data-v={r.name}><a href={`/prices/${r.slug}/`} class="font-semibold text-slate-900 hover:text-teal-700">{r.name}</a><span class="sub">{r.category}</span></td>
                <td class="num">{r.shops}</td>
                <td class="num">{r.listings}</td>
                <td class="min-w-[10rem]">
                  {r.sizes.map((s, i) => {
                    const page = r.sizePages.find((p) => p.size === s);
                    return <>{i > 0 && ', '}{page ? <a href={`/prices/${r.slug}/${s}mg/`} class="text-link font-medium">{s} mg</a> : `${s} mg`}</>;
                  })}
                </td>
                <td class="num" data-v={r.eur?.perMg ?? ''}>{r.eur ? <><span class="font-semibold">{perMg(r.eur.perMg, 'EUR')}</span><span class="sub">{r.eur.vendor.name}</span></> : 'n/a'}</td>
                <td class="num" data-v={r.usd?.perMg ?? ''}>{r.usd ? <><span class="font-semibold">{perMg(r.usd.perMg, 'USD')}</span><span class="sub">{r.usd.vendor.name}</span></> : 'n/a'}</td>
                <td class="num">{r.reports}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-[0.94rem] text-slate-700 max-w-[70ch]">Lowest listed price per mg across all vial sizes. Price per mg = vial price divided by the mg on the label. Larger vials are usually cheaper per mg. Open a compound for the full EUR and USD tables.</p>
    </section>

    <section class="space-y-4">
      <h2 class="h2">Prices by vial size</h2>
      <p class="text-slate-700 max-w-[70ch]">Compound and vial-size combinations listed by at least three audited shops. The number is the shop count.</p>
      <div class="flex flex-wrap gap-2">
        {SIZE_PAGES.map((s) => (
          <a href={`/prices/${s.compound}/${s.size}mg/`} class="inline-flex items-center gap-1.5 min-h-[44px] rounded-xl bg-white border border-slate-300 px-3.5 text-[0.94rem] font-semibold text-slate-800 hover:border-teal-600 hover:text-teal-900">{compoundShort(s.compound)} {s.size} mg <span class="text-slate-600 font-normal">({s.shops})</span></a>
        ))}
      </div>
    </section>

    <FAQ items={faqs} />
    <Disclosure />
  </div>
</BaseLayout>
