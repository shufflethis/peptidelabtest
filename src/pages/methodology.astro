---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import FAQ from '../components/FAQ.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import { SUBSCORE_LABELS, TOTALS, CHECKED_LABEL, faqSchema } from '../lib/site';

const parts: Record<string, string> = {
  labVerification: 'Does the shop publish lab reports, and can we find them on the testing lab’s own website? Reports that only exist as files on the shop’s site count less than reports we could look up on the lab portal.',
  fillAccuracy: 'How close is the measured amount to the label? We divide measured mg by label mg on every opened report. 100% means the vial holds exactly what the label says.',
  panelDepth: 'Which tests do the reports cover? Purity only scores lower than purity plus measured mg, identity (mass spectrometry), endotoxin, sterility or heavy metals.',
  entityTransparency: 'Does the shop name the company behind it, with an address or registration number, on its own pages?',
  dispatchReliability: 'Does the shop publish where it ships, how fast it dispatches and which carriers it uses?',
  valuePerMg: 'How does the listed price per mg compare with other audited shops? If a shop does not publish prices, this part is left out and the other weights are scaled up.',
};
const title = 'How We Score Research Peptide Shops (Methodology)';
const description = `How we score shops: six weighted parts, a 0-5 score and ${TOTALS.reportsOpened} lab reports opened on ${CHECKED_LABEL}. No paid placements. See the method.`;
const intro = `Every shop gets a score from 0 to 5. It is a weighted average of six parts, led by lab verification (30%) and fill accuracy (20%). We read public shop pages, lab reports and lab portals on ${CHECKED_LABEL}. We did not place test orders, and commission never changes a score or a ranking.`;
const crumbs = [{ name: 'Home', url: '/' }, { name: 'Methodology', url: '/methodology/' }];
const faqs = [
  { q: 'Do you buy products and send them to a lab?', a: 'No. This audit reads what shops and labs publish. We did not place test orders, so we cannot confirm what an individual parcel contains.' },
  { q: 'Can a shop pay for a better score?', a: 'No. Partner shops pay commission on sales made through our links, but the score formula is the same for every shop. Rankings sort partner shops by score only.' },
  { q: 'How is price per mg calculated?', a: 'Listed price divided by the mg on the label. If a sale price is shown, we use it. We do not apply discount codes and we do not convert between EUR and USD.' },
  { q: 'How often is the data updated?', a: `The current data set was read on ${CHECKED_LABEL}. Each page shows the date of the last check.` },
];
---
<BaseLayout title={title} description={description} crumbs={crumbs} jsonLd={faqSchema(faqs)}>
  <PageHero crumbs={crumbs} title="How we score research peptide shops" intro={intro} />
  <div class="wrap mt-12 space-y-16">
    <section class="space-y-5">
      <h2 class="h2">The six parts of the score</h2>
      <p class="text-slate-700 max-w-[70ch]">Each part is rated 0 to 10 by the auditor, with a written reason on every shop page. The weighted average is divided by two to give the 0-5 score.</p>
      <ol class="grid gap-4 md:grid-cols-2">
        {SUBSCORE_LABELS.map((s) => (
          <li class="card p-5 flex gap-4">
            <span class="shrink-0 w-14 h-14 rounded-2xl bg-teal-50 text-teal-900 font-extrabold text-lg flex items-center justify-center ring-1 ring-teal-200">{s.weight}%</span>
            <div>
              <h3 class="h3">{s.label}</h3>
              <p class="mt-1.5 text-slate-700">{parts[s.key as string]}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="prose-read">
      <h2>What we did on {CHECKED_LABEL}</h2>
      <ul>
        <li>Read the public pages of {TOTALS.shops} shops: shop, product, shipping, terms, imprint and lab report pages.</li>
        <li>Opened {TOTALS.reportsOpened} lab reports and wrote down the lab, test date, purity, label mg and measured mg.</li>
        <li>Looked up reports on the lab's own portal where the lab offers one. {TOTALS.portalVerified} reports were found there ("portal-verified").</li>
        <li>Recorded {TOTALS.products} listed prices with vial size, currency and sale price.</li>
      </ul>
      <h2>What we did not do</h2>
      <ul>
        <li>No test purchases and no own lab tests.</li>
        <li>No checks in company registries. Entity transparency only rates what the shop publishes about itself.</li>
        <li>No information on use in humans or animals. All products are sold as research-use-only reagents.</li>
      </ul>
      <h2>Terms used on this site</h2>
      <ul>
        <li><strong>Portal-verified:</strong> we found the report on the testing lab's website, not only on the shop's site.</li>
        <li><strong>Shop-hosted:</strong> the report exists only as a file or image on the shop's site.</li>
        <li><strong>Measured vs label:</strong> measured mg divided by label mg, as a percentage.</li>
        <li><strong>Purity:</strong> the HPLC purity figure printed on the report.</li>
        <li><strong>Price per mg:</strong> listed vial price divided by the mg on the label.</li>
      </ul>
      <h2>Partners and links</h2>
      <p>Some shops are affiliate partners. Only partner shops get a "Visit shop" link, and those links are marked as sponsored. Rankings list partner shops by audit score. All other shops keep their score and appear under "Other audited shops" with a link to our review. Lab report addresses are shown as plain text, not as links.</p>
      <p>The full data set is available on the <a href="/data/">open data page</a> as CSV and JSON.</p>
    </section>

    <FAQ items={faqs} />
    <RelatedLinks links={[
      { href: '/vendors/', label: 'Shop ranking', sub: `${TOTALS.shops} shops` },
      { href: '/batch-tracker/', label: 'Lab reports we opened', sub: `${TOTALS.reportsOpened} reports` },
      { href: '/data/', label: 'Open data (CSV / JSON)' },
    ]} />
  </div>
</BaseLayout>
