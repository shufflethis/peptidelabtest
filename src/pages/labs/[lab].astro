---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import FillChart from '../../components/FillChart.astro';
import FAQ from '../../components/FAQ.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import Disclosure from '../../components/Disclosure.astro';
import { LABS_IN_DATA, reportsByLab, CHECKED_LABEL, faqSchema, fillPct, compoundShort, listJoin, fillRange, YEAR, LAB_KEYS, type LabKey, fitTitle, fitDesc } from '../../lib/site';
import { getLabGuide } from '../../data/labGuides';

export function getStaticPaths() {
  return LABS_IN_DATA.map((l) => ({ params: { lab: l.slug }, props: { l } }));
}
const { l } = Astro.props as { l: LabKey };
const g = getLabGuide(l.slug);
const reps = reportsByLab(l.slug);
const portal = reps.filter((r) => r.report.verifiable).length;
const fills = reps.map((r) => fillPct(r.report)).filter((x): x is number => x != null);
const pur = reps.map((r) => r.report.purityPercent).filter((x): x is number => x != null);
const shopMap = new Map<string, { v: (typeof reps)[number]['vendor']; n: number; p: number }>();
for (const r of reps) {
  const e = shopMap.get(r.vendor.slug) || { v: r.vendor, n: 0, p: 0 };
  e.n++; if (r.report.verifiable) e.p++;
  shopMap.set(r.vendor.slug, e);
}
const shops = Array.from(shopMap.values()).sort((a, b) => b.v.overallScore - a.v.overallScore);
const short = l.name.replace(/ (Analytical|Laboratory|Laboratories|Labs|Analytics|Diagnostics Testing)$/, '');
const fillTxt = fills.length ? `measured content ranged from ${Math.min(...fills).toFixed(1)}% to ${Math.max(...fills).toFixed(1)}% of label` : 'measured mg was not stated';
const intro = `${l.name} is named on ${reps.length} of the lab reports we opened on ${CHECKED_LABEL}, from ${shops.length} audited ${shops.length === 1 ? 'shop' : 'shops'}. ${portal} of those reports could be checked on the lab's own portal, and ${fillTxt}.`;
const isJ = l.slug === 'janoshik';
const title = isJ ? 'Janoshik Analytical: How to Verify a Report' : fitTitle(`${l.name}: How to Verify a Report (${YEAR})`, `${l.name}: How to Verify a Report`);
const h1 = isJ ? 'Janoshik: how to verify a report, and is it legit?' : `${l.name}: how to verify a report`;
const crumbs = [{ name: 'Home', url: '/' }, { name: 'Testing labs', url: '/labs/' }, { name: l.name, url: `/labs/${l.slug}/` }];
const genericSteps = [
  'Find the report number, key or QR code on the report the shop shows you.',
  'Open the lab’s website by typing the address yourself, not through a link in the PDF.',
  'Look the report up and compare compound, label amount, measured mg, purity, test date and batch with the shop’s copy.',
  'If the lab has no lookup, the report counts as shop-hosted: it may be genuine, but you cannot confirm it with the lab.',
];
const steps = g?.verifySteps || genericSteps;
const description = fitDesc(
  `How to verify a ${l.name} report in ${steps.length} steps. We opened ${reps.length} of its reports from ${shops.length} shops, ${portal} portal-verified. See the results.`,
  `How to verify a ${short} report: ${reps.length} reports opened from ${shops.length} shops, ${portal} portal-verified. See lab reports and shops.`,
  `How to verify a ${short} report. ${reps.length} reports opened, ${portal} portal-verified. See lab reports.`,
);
const legit = [
  g?.address ? `It publishes an address: ${g.address}.` : 'We could not find a published address.',
  g?.verifyWhere ? `Reports can be checked at ${g.verifyWhere}.` : 'We found no public verification portal.',
  g?.accreditation ? `On accreditation it states: ${g.accreditation}` : 'We found no accreditation statement on the pages we read.',
  `${portal} of the ${reps.length} reports we opened were found on the lab's own portal.`,
].join(' ');
const faqs = [
  { q: isJ ? 'How do I verify a Janoshik report?' : `How do I verify a ${l.name} report?`, a: steps.join(' ') },
  { q: `Is ${short} legit?`, a: `We do not rate labs, but we can say what is public. ${legit}` },
  ...(g?.pricing ? [{ q: `How much does ${short} testing cost?`, a: g.pricing }] : [{ q: `How much does ${short} testing cost?`, a: 'Not published on the pages we read.' }]),
  { q: `Which shops use ${l.name}?`, a: `Among the shops we audited: ${listJoin(shops.map((s) => s.v.name))}.` },
];
const fillRows = reps.map((r) => ({ label: `${r.vendor.name} · ${compoundShort(r.report.compound)}`, sub: r.report.lab, labelMg: r.report.labelMg, measuredMg: r.report.measuredMg, verified: r.report.verifiable }));
const related = [
  ...shops.slice(0, 4).map((s) => ({ href: `/vendors/${s.v.slug}/`, label: `${s.v.name}: lab reports and score`, sub: `${s.n} ${short} ${s.n === 1 ? 'report' : 'reports'} opened` })),
  ...LAB_KEYS.filter((k) => k.slug !== l.slug && LABS_IN_DATA.includes(k)).slice(0, 4).map((k) => ({ href: `/labs/${k.slug}/`, label: k.name, sub: 'Lab guide' })),
  { href: '/batch-tracker/', label: 'All lab reports we opened' },
];
---
<BaseLayout title={title} description={description} crumbs={crumbs} jsonLd={faqSchema(faqs)}>
  <PageHero crumbs={crumbs} title={h1} eyebrow="Testing lab guide" intro={intro}>
    <dl class="mt-6 grid grid-cols-2 sm:grid-cols-4 gap-3 max-w-3xl">
      <div class="stat"><dt>Reports opened</dt><dd>{reps.length}</dd></div>
      <div class="stat"><dt>Portal-verified</dt><dd>{portal}</dd></div>
      <div class="stat"><dt>Shops</dt><dd>{shops.length}</dd></div>
      <div class="stat"><dt>Purity on reports</dt><dd>{pur.length ? `${Math.min(...pur)}–${Math.max(...pur)}%` : 'n/a'}</dd></div>
    </dl>
  </PageHero>
  <div class="wrap mt-12 space-y-14">
    <section class="grid gap-8 lg:grid-cols-2">
      <div class="prose-read">
        <h2 class="!mt-0">What {l.name} is</h2>
        <p>{g?.about || 'Not published.'}</p>
        {g && g.tests.length > 0 && (<><h3>Tests it lists</h3><ul>{g.tests.map((t) => <li>{t}</li>)}</ul></>)}
      </div>
      <dl class="facts card px-5 sm:px-6 py-2 self-start">
        <div><dt>Address</dt><dd>{g?.address || 'not published'}</dd></div>
        <div><dt>Operator</dt><dd>{g?.operator || 'not published'}</dd></div>
        <div><dt>Verification</dt><dd>{g?.verifyWhere || 'no portal found'}</dd></div>
        <div><dt>Accreditation</dt><dd>{g?.accreditation || 'no statement found'}</dd></div>
        <div><dt>Price</dt><dd>{g?.pricing || 'not published'}</dd></div>
        <div><dt>Turnaround</dt><dd>{g?.turnaround || 'not published'}</dd></div>
      </dl>
    </section>

    <section class="prose-read">
      <h2>How to verify a {short} report</h2>
      <ol>{steps.map((s) => <li>{s}</li>)}</ol>
      <p>Addresses are written as plain text on purpose. Type them yourself so that you land on the lab's real site.</p>
      <h2>Is {short} legit?</h2>
      <p>{legit}</p>
      <p>We did not test samples ourselves. These are facts from the lab's public pages and from the reports we opened.</p>
    </section>

    <section class="space-y-4">
      <h2 class="h2">Shops that publish {short} reports</h2>
      <div class="table-wrap">
        <table class="data-table">
          <thead><tr><th scope="col">Shop</th><th scope="col" class="num">Reports opened</th><th scope="col" class="num">Portal-verified</th><th scope="col">Shop measured vs label</th><th scope="col" class="num">Shop score (0-5)</th></tr></thead>
          <tbody>
            {shops.map((s) => (
              <tr>
                <td class="min-w-[10rem]"><a href={`/vendors/${s.v.slug}/`} class="font-semibold text-slate-900 hover:text-teal-800 hover:underline">{s.v.name}</a><span class="sub">{s.v.region}</span></td>
                <td class="num">{s.n}</td>
                <td class="num">{s.p}</td>
                <td class="whitespace-nowrap">{fillRange(s.v)}</td>
                <td class="num font-semibold">{s.v.overallScore.toFixed(1)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <FillChart rows={fillRows} title={`${l.name} reports: measured content as % of label`} />
    </section>

    <FAQ items={faqs} />
    {g && g.sources.length > 0 && (
      <section class="space-y-2">
        <h2 class="h3">Sources</h2>
        <p class="text-sm text-slate-600">The lab's public pages, read on {CHECKED_LABEL}. Plain text, not links.</p>
        <ul class="space-y-1">{g.sources.map((s) => <li class="mono-url">{s}</li>)}</ul>
      </section>
    )}
    <RelatedLinks links={related} />
    <Disclosure compact />
  </div>
</BaseLayout>
