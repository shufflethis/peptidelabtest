---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_BRAND } from '../data/affiliates';
---

<BaseLayout
  title={`Featured Category Sponsorship | ${SITE_BRAND.name}`}
  description="One clearly-labeled Featured Lab Sponsor slot per regional category for audited suppliers scoring ≥ 3.5/5.0. Editorial scores remain strictly independent."
>
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-12 space-y-8">
    <h1 class="text-3xl sm:text-5xl font-black text-white">Featured Lab Partner Program</h1>
    <p class="text-base text-slate-300 leading-relaxed">
      Suppliers that pass our third-party COA verification audit with an overall score of <strong>3.5 / 5.0 or higher</strong> may apply for a single clearly-labeled <em>Sponsored Category Spotlight</em> slot. Sponsorships never modify audit scores or remove documented weaknesses.
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      <div class="glass-card rounded-2xl p-6 space-y-3 border border-cyan-500/30">
        <div class="text-xs font-mono text-cyan-400 uppercase font-bold">Monthly Category Slot</div>
        <div class="text-4xl font-black font-mono text-white">$299 <span class="text-sm font-normal text-slate-400">/ month</span></div>
        <p class="text-xs text-slate-300">1 exclusive labeled slot per category (US Domestic, EU Domestic, or Compound Spotlight). Cancel anytime.</p>
      </div>
      <div class="glass-card rounded-2xl p-6 space-y-3 border border-emerald-500/30">
        <div class="text-xs font-mono text-emerald-400 uppercase font-bold">Annual Category Lock</div>
        <div class="text-4xl font-black font-mono text-white">$2,990 <span class="text-sm font-normal text-slate-400">/ 12 months</span></div>
        <p class="text-xs text-slate-300">Locks category exclusivity for 12 months (2 months complimentary) subject to maintaining active batch COAs.</p>
      </div>
    </div>

    <div class="glass-card rounded-2xl p-6 text-sm text-slate-300 font-mono">
      Partner &amp; Audit Submissions: <a href={`mailto:${SITE_BRAND.contactEmail}`} class="text-cyan-400 underline">{SITE_BRAND.contactEmail}</a>
    </div>
  </section>
</BaseLayout>
